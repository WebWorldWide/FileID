<?xml version="1.0" encoding="utf-8"?>
<!--
    TagChip — small tag chip rendered below Library card filenames: 11 px
    Medium text, secondary foreground, 10% secondary fill, 5x2 padding, 4 px
    corner radius, one line.

    Usage:
        <theme:TagChip Tag="{Binding}" />

    The control runs `FormatTag` on the bound value internally so callers
    bind raw classifier output ("animal_dog") and get the display form
    ("Dog").
-->
<UserControl
    x:Class="FileID.Theme.Controls.TagChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="ChipRoot"
            CornerRadius="4"
            Padding="5,2,5,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <TextBlock x:Name="LabelText"
                   FontFamily="Segoe UI"
                   FontSize="11"
                   FontWeight="Medium"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />
    </Border>
</UserControl>

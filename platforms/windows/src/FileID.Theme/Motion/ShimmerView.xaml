<?xml version="1.0" encoding="utf-8"?>
<!--
    ShimmerView — gold→lavender diagonal band over a placeholder surface.
    The band is static on purpose: it does not move. The Mac Library tiles
    dropped their per-tile shimmer because of scroll cost, and animating
    GradientStop.Offset would need a dependent animation, which WinUI only
    runs with EnableDependentAnimation. Hidden when inactive or under
    reduced-motion.

    Used as a loading-state overlay (thumbnail tiles, model installer
    cards, etc.).

    The brush uses GoldColor + AiColor from Theme.xaml, with transparent
    end stops to give the band cleanly defined edges.
-->
<UserControl
    x:Class="FileID.Theme.Motion.ShimmerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- Base placeholder surface (matches GlassCard's tint so an inactive
             ShimmerView looks like a paused tile, not a hole). -->
        <Border x:Name="BaseLayer"
                Background="{ThemeResource SurfaceCardBrush}"
                CornerRadius="{StaticResource CornerRadiusM}" />

        <!-- The fixed highlight band. EndPoint at (1,1) makes it a 45° angle. -->
        <Border x:Name="Highlight"
                CornerRadius="{StaticResource CornerRadiusM}"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="EdgeLeading"  Color="Transparent" Offset="-0.3" />
                    <GradientStop x:Name="HighlightCore1" Color="{StaticResource GoldColor}" Offset="0.0" />
                    <GradientStop x:Name="HighlightCore2" Color="{StaticResource AiColor}"   Offset="0.2" />
                    <GradientStop x:Name="EdgeTrailing" Color="Transparent" Offset="0.5" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>

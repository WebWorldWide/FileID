<?xml version="1.0" encoding="utf-8"?>
<!--
    Loading-state overlay (thumbnail tiles, model installer cards): a gold-to-lavender diagonal band over a
    placeholder surface. The band is static because animating GradientStop.Offset needs a dependent animation,
    which WinUI only runs with EnableDependentAnimation; Mac Library tiles dropped the scroll for the same cost.
    It is hidden when inactive or under reduced motion.
-->
<UserControl
    x:Class="FileID.Theme.Motion.ShimmerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- Base placeholder surface (matches GlassCard's tint so an inactive
             ShimmerView looks like a paused tile, not a hole). -->
        <Border x:Name="BaseLayer"
                Background="{ThemeResource SurfaceCardBrush}"
                CornerRadius="{StaticResource CornerRadiusM}" />

        <!-- The fixed highlight band. EndPoint at (1,1) makes it a 45° angle. -->
        <Border x:Name="Highlight"
                CornerRadius="{StaticResource CornerRadiusM}"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="EdgeLeading"  Color="Transparent" Offset="-0.3" />
                    <GradientStop x:Name="HighlightCore1" Color="{StaticResource GoldColor}" Offset="0.0" />
                    <GradientStop x:Name="HighlightCore2" Color="{StaticResource AiColor}"   Offset="0.2" />
                    <GradientStop x:Name="EdgeTrailing" Color="Transparent" Offset="0.5" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<!--
    FileID — Theme tokens.

    1:1 port of platforms/apple/app/Sources/FileID/Theme/Theme.swift. Every
    color, spacing scalar, and radius corresponds to a constant on the macOS
    side. When this file and Theme.swift disagree, Theme.swift wins —
    the macOS app is the canonical visual reference.

    Token semantics (don't lose this in the noise):
      Gold     — primary CTA (Apply, Start Scan, Pick a folder), tab selection,
                 value-prop moments. Apply sparingly.
      Ai       — lavender. "An on-device AI is doing work right now." Deep
                 Analyze running, face clustering, ArcFace embed, Verify with AI.
      Info     — soft cyan. Secondary status / informational banners.
      Delight  — soft pink. Success / completion / "nice job" — used briefly,
                 never as a permanent fixture.

    Surface tokens layer on a fully-blurred Mica/Acrylic background — the
    SurfaceBase (#000 @ 30%) muting + 1px white-8% borders are what give
    the cards their depth. Adjust opacities together; they're tuned.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Contrast-sensitive tokens (DESIGN_V3_PORT Tokens): text, hairlines,
         borders and panels follow Windows high-contrast themes. Reference
         them with {ThemeResource} so a theme switch updates live. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="Text1Brush" Color="#FFF0F1F2" />
            <SolidColorBrush x:Key="Text2Brush" Color="#FFCFD3D8" />
            <SolidColorBrush x:Key="Text3Brush" Color="#FFA6ACB3" />
            <SolidColorBrush x:Key="LabelBrush" Color="#FFAEB4BB" />
            <SolidColorBrush x:Key="PanelBrush" Color="#C718181B" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="HairlineSoftBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="ShellControlBorderBrush" Color="#29FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="Text1Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Text2Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Text3Brush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="LabelBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HairlineSoftBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ─── Color literals ───────────────────────────────────────────── -->
    <!--
        Kept as <Color> resources separately from the brushes so animations
        + Win2D rendering paths can grab the raw value. Gold = #FFCC00 from
        Theme.swift Color(red: 1.0, green: 0.8, blue: 0.0). NOT #FFD700 even
        though some docs mention that — the actual SwiftUI literal is #FFCC00.
    -->
    <Color x:Key="GoldColor">#FFFFCC00</Color>
    <Color x:Key="GoldDimColor">#FFCCA300</Color>
    <Color x:Key="AiColor">#FFB19BCE</Color>
    <Color x:Key="InfoColor">#FFA0E2EA</Color>
    <Color x:Key="DelightColor">#FFF2A6C0</Color>

    <Color x:Key="LavaLampBaseColor">#FF141414</Color>      <!-- Color(white: 0.08) -->
    <Color x:Key="LavaLampGoldEllipseColor">#FFFFCC00</Color>
    <Color x:Key="LavaLampOrangeEllipseColor">#FFFF6600</Color>
    <Color x:Key="LavaLampDarkEllipseColor">#FF0D0D0D</Color>

    <!-- ─── Prototype v3 tokens (shared/docs/DESIGN_V3.md) ─────────────── -->
    <Color x:Key="Bg0Color">#FF070708</Color>
    <Color x:Key="Bg1Color">#FF0B0B0C</Color>
    <Color x:Key="Text1Color">#FFF0F1F2</Color>
    <Color x:Key="Text2Color">#FFCFD3D8</Color>
    <Color x:Key="Text3Color">#FFA6ACB3</Color>
    <Color x:Key="LabelColor">#FFAEB4BB</Color>
    <Color x:Key="OnGoldColor">#FF141414</Color>
    <Color x:Key="DangerColor">#FFFF6A5E</Color>
    <Color x:Key="WarningColor">#FFE0A340</Color>
    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="OnGoldBrush" Color="{StaticResource OnGoldColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="GoldWashBrush" Color="#12FFCC00" />
    <SolidColorBrush x:Key="PaneFillBrush" Color="#04FFFFFF" />
    <!-- Image badges: black 0.62 backing, 1 px stroke in the badge colour at 0.6. -->
    <SolidColorBrush x:Key="ImageBadgeBackingBrush" Color="#9E000000" />
    <SolidColorBrush x:Key="ImageBadgeStrokeBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="ImageBadgeAiStrokeBrush" Color="#99B19BCE" />
    <SolidColorBrush x:Key="ImageBadgeGoldStrokeBrush" Color="#99FFCC00" />
    <Style x:Key="ImageBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="5,1,5,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{StaticResource ImageBadgeBackingBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ImageBadgeStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <SolidColorBrush x:Key="RailSelectedBrush" Color="#1FFFCC00" />
    <SolidColorBrush x:Key="RailSelectedStrokeBrush" Color="#73FFCC00" />
    <Color x:Key="GoldHoverColor">#FFFFD84D</Color>
    <SolidColorBrush x:Key="GoldHoverBrush" Color="{StaticResource GoldHoverColor}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#9E0B0B0C" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#8C0B0B0C" />
    <SolidColorBrush x:Key="PageSurfaceBrush" Color="#CC0F0F11" />
    <SolidColorBrush x:Key="PopoverBrush" Color="#FF161618" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#05FFFFFF" />
    <SolidColorBrush x:Key="ShellControlFillBrush" Color="#47000000" />
    <SolidColorBrush x:Key="ShellControlFillStrongBrush" Color="#52000000" />
    <SolidColorBrush x:Key="SecondaryButtonFillBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1FFFCC00" />
    <SolidColorBrush x:Key="ShellChipSelectedBrush" Color="#24FFCC00" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="#14FFCC00" />
    <SolidColorBrush x:Key="ScanCardBrush" Color="#09FFFFFF" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="StepDoneBrush" Color="#B3CFD3D8" />
    <SolidColorBrush x:Key="StepPendingBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PausedBrush" Color="#80B9BEC4" />
    <LinearGradientBrush x:Key="GoldProgressBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF8A1A" Offset="0" />
        <GradientStop Color="#FFFFB000" Offset="0.35" />
        <GradientStop Color="#FFFFCC00" Offset="0.7" />
        <GradientStop Color="#FFFFE9A3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AiProgressBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF7462A6" Offset="0" />
        <GradientStop Color="#FFB19BCE" Offset="0.6" />
        <GradientStop Color="#FFDED2F2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DoneProgressBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFB000" Offset="0" />
        <GradientStop Color="#FFFFCC00" Offset="0.5" />
        <GradientStop Color="#FFF2A6C0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InfoProgressBrush" Color="#FFA0E2EA" />
    <!-- Subtle continuous corners (DESIGN_V3 revision 2026-10-15): controls s, overlays l. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    <!-- Brand type (SIL OFL files under Assets/Fonts). Mono stays Cascadia Mono. -->
    <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/InstrumentSerif-Regular.ttf#Instrument Serif</FontFamily>
    <FontFamily x:Key="BodyFontFamily">ms-appx:///Assets/Fonts/Archivo-Variable.ttf#Archivo</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>
    <x:Double x:Key="PageTitleFontSize">34</x:Double>
    <x:Double x:Key="SectionLabelFontSize">11</x:Double>
    <x:Double x:Key="MetaFontSize">11.5</x:Double>
    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <x:Double x:Key="SidebarWidth">232</x:Double>
    <x:Double x:Key="NavRowHeight">50</x:Double>

    <!-- ─── Brushes ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="GoldBrush"     Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldDimBrush"  Color="{StaticResource GoldDimColor}" />

    <!-- WinUI ToggleSwitch templates derive their on-state from these accent
         resources. Keep the system-native controls on FileID gold as well. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFFCC00" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFFFD633" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFE6B800" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#66FFCC00" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF141414" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FF777777" />

    <!-- Keep every native ToggleSwitch on-state in FileID gold, including
         hover, pressed, and disabled states. WinUI reads these theme keys
         from the application resource dictionaries. -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFFFCC00" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFFFD633" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFE6B800" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#66FFCC00" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FFFFCC00" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FFFFD633" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FFE6B800" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#66FFCC00" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF141414" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF141414" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FF141414" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FF777777" />

    <SolidColorBrush x:Key="AiBrush"       Color="{StaticResource AiColor}" />
    <SolidColorBrush x:Key="InfoBrush"     Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="DelightBrush"  Color="{StaticResource DelightColor}" />

    <!-- Translucent fills used by the GlassCard + segmented controls + dividers. -->
    <SolidColorBrush x:Key="SurfaceBaseBrush"   Color="#000000" Opacity="0.30" />
    <SolidColorBrush x:Key="SurfaceCardBrush"   Color="#FFFFFF" Opacity="0.06" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#FFFFFF" Opacity="0.08" />

    <!-- Gold tint variants for selected / hover states. -->
    <SolidColorBrush x:Key="GoldSelectedBackgroundBrush" Color="{StaticResource GoldColor}" Opacity="0.18" />
    <SolidColorBrush x:Key="GoldSelectedStrokeBrush"     Color="{StaticResource GoldColor}" Opacity="0.55" />
    <SolidColorBrush x:Key="WhiteSubtleFillBrush"        Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="WhiteSubtleStrokeBrush"      Color="#FFFFFF" Opacity="0.10" />

    <!-- Destructive (clear-folder, trash, wipe). Muted red on dark. -->
    <Color x:Key="DestructiveColor">#FFE5A5A5</Color>
    <SolidColorBrush x:Key="DestructiveTextBrush"        Color="{StaticResource DestructiveColor}" />
    <SolidColorBrush x:Key="DestructiveBackgroundBrush"  Color="#FF2B0000" Opacity="0.13" />
    <SolidColorBrush x:Key="DestructiveBorderBrush"      Color="#FF2B0000" Opacity="0.33" />

    <!-- Tag chips — gold-tinted to match macOS QLPreviewProvider.swift chip
         styling (rgba(255,205,60,0.12) background, #FFCD3C foreground). -->
    <SolidColorBrush x:Key="TagChipForegroundBrush" Color="#FFCD3C" Opacity="0.85" />
    <SolidColorBrush x:Key="TagChipBackgroundBrush" Color="#FFCD3C" Opacity="0.10" />

    <!-- Kind variant — neutral white-on-gray (distinct from the gold Auto chip),
         used for the file-type label that leads each card's chip row. Hex
         values mirror the TagChip.xaml.cs:59-62 fallbacks (Opacity 0.30 ≈
         alpha 0x4D). -->
    <SolidColorBrush x:Key="TagChipKindForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TagChipKindBackgroundBrush" Color="#808080" Opacity="0.30" />

    <!-- Apply-bar gradient (Restructure floating bar). Gold → orange,
         pre-multiplied alpha so a GradientStop can use it directly. -->
    <Color x:Key="ApplyBarGoldStopColor">#33FFCC00</Color>
    <Color x:Key="ApplyBarOrangeStopColor">#11FF6600</Color>

    <!-- ─── Spacing scale (Theme.Space.*) ────────────────────────────── -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">16</x:Double>
    <x:Double x:Key="SpaceL">24</x:Double>
    <x:Double x:Key="SpaceXl">40</x:Double>

    <!-- Pre-baked Thickness so Margin/Padding bindings don't need a converter. -->
    <Thickness x:Key="PaddingS">8</Thickness>
    <Thickness x:Key="PaddingM">16</Thickness>
    <Thickness x:Key="PaddingL">24</Thickness>

    <!-- ─── Corner radii (Theme.Radius.*) ────────────────────────────── -->
    <x:Double x:Key="RadiusXs">4</x:Double>
    <x:Double x:Key="RadiusS">6</x:Double>
    <x:Double x:Key="RadiusM">8</x:Double>
    <x:Double x:Key="RadiusL">10</x:Double>

    <CornerRadius x:Key="CornerRadiusXs">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusS">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusM">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusL">10</CornerRadius>

    <!-- ─── Type ramp ─────────────────────────────────────────────────── -->
    <!--
        Map directly onto the macOS sizes from Theme.swift + Theme.Caption /
        BadgePill. WinUI's stock TextBlock styles are close but not identical;
        we stamp explicit sizes so the visual densities match.
    -->
    <x:Double x:Key="FontSizeBadge">10</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeTitle">17</x:Double>
    <x:Double x:Key="FontSizeHero">24</x:Double>

    <!-- ─── Motion durations ────────────────────────────────────────── -->
    <!--
        Centralized so we never end up with a 0.41s spring on one card and
        a 0.4s spring on another. Motion primitives reference these keys.
    -->
    <x:Double x:Key="DurationShimmerSeconds">1.6</x:Double>
    <x:Double x:Key="DurationCompletionRippleSeconds">0.9</x:Double>
    <x:Double x:Key="DurationIridescentBorderSeconds">14</x:Double>
    <x:Double x:Key="DurationTabCrossfadeSeconds">0.22</x:Double>
    <x:Double x:Key="DurationSidebarToggleSeconds">0.20</x:Double>
    <x:Double x:Key="DurationStatTileHoverSeconds">0.18</x:Double>
    <x:Double x:Key="DurationApplyBarEntranceSeconds">0.40</x:Double>
    <x:Double x:Key="DurationSankeyEntranceSeconds">0.55</x:Double>
    <x:Double x:Key="DurationStartingCardEntranceSeconds">0.35</x:Double>

    <!-- Spring parameters: response = period of one oscillation, damping
         in [0..1] where 1.0 = critically damped (no overshoot). Match the
         SwiftUI .spring(response:dampingFraction:) calls 1:1. -->
    <x:Double x:Key="SpringResponseStandard">0.40</x:Double>
    <x:Double x:Key="SpringDampingStandard">0.80</x:Double>
    <x:Double x:Key="SpringResponseTight">0.35</x:Double>
    <x:Double x:Key="SpringDampingTight">0.78</x:Double>

    <!-- ─── Gold button style (Theme.GoldButton) ────────────────────── -->
    <!--
        Primary CTA. Applied via Style="{StaticResource GoldButtonStyle}".
        Mirrors macOS GoldButton: gold fill, black text, semibold. Borderless
        prominent visual weight. Hover + pressed states modulate the fill.

        The hover state grows opacity 0.0 → 0.08 of black overlay (subtle
        darkening), pressed state goes 0.16. Matches SwiftUI's
        .borderedProminent .tint(Theme.gold) feel without needing a custom
        VisualState chain — the button's own FocusVisual + control template
        handles focus rings.
    -->
    <Style x:Key="GoldButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GoldBrush}" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusS}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}"
                                          AutomationProperties.AccessibilityView="Raw" />
                        <!-- HoverOverlay must be declared BEFORE the
                             VisualStateManager.VisualStateGroups block;
                             XamlCompiler Pass 1 silently exits 1 (no
                             diagnostic) on `<Setter Target="...">`
                             references to elements that appear later in
                             document order. -->
                        <Rectangle x:Name="HoverOverlay"
                                   Fill="Black"
                                   Opacity="0"
                                   IsHitTestVisible="False"
                                   RadiusX="{StaticResource RadiusS}"
                                   RadiusY="{StaticResource RadiusS}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0.16" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── Prototype v3 shell styles (DESIGN_V3.md › Components) ────── -->
    <Style x:Key="ShellSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SectionLabelFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="55" />
        <Setter Property="Foreground" Value="{ThemeResource LabelBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="ShellMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource Text3Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource Text1Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="ShellButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource Text1Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusS}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="HoverOverlay"
                                Background="White"
                                Opacity="0"
                                IsHitTestVisible="False"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}"
                                          AutomationProperties.AccessibilityView="Raw" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0.05" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0.10" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellButtonStyle}">
        <Setter Property="Background" Value="{StaticResource GoldBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnGoldBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,0,14,0" />
    </Style>

    <Style x:Key="ShellSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ShellGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource Text3Brush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="6,0,6,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusXs}" />
    </Style>

    <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />

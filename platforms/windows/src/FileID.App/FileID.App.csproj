<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FileID — WinUI 3 unpackaged desktop app.

    Unpackaged means we ship as a folder of .exe + DLLs (installed by WiX
    MSI), not as MSIX. Rationale in shared/docs/DECISIONS.md (2026-05-02
    "Windows engine in Rust + UI in WinUI 3" entry):
      - No Microsoft Store dependency
      - No MSIX file-system sandbox restrictions
      - Standard `C:\Program Files\FileID\` install
      - Self-contained .NET publish — users do NOT install .NET themselves
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>FileID</RootNamespace>
    <AssemblyName>FileID</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Multi-resolution .ico (16/32/48/64/128/256) embedded in
         FileID.exe. Drives Explorer, taskbar, Alt-Tab, Add/Remove
         Programs, and the WiX MSI Icon element. Generated via
         build/make-icon.ps1 from shared/docs/assets/FileID-AppIcon.png. -->
    <ApplicationIcon>Assets\FileID.ico</ApplicationIcon>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Framework-dependent Windows App SDK mode. `SelfContained` below still
         bundles .NET 8; `WindowsAppSDKSelfContained=false` keeps WinUI on the
         separately installed Windows App Runtime 1.7. The release Burn bundle
         embeds Microsoft's matching 1.7 prerequisite installer. App-SDK
         self-contained mode (the inverse) bundles Microsoft.UI.Xaml.dll into
         the publish folder, but on Windows 11
         build 26200+ the bundled Microsoft.UI.Xaml.dll fast-fails (0xC000027B)
         when an installed framework package of a different patch version is
         also present. Source-build users can install the prerequisite with
         `winget install Microsoft.WindowsAppRuntime.1.7`. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- We provide our own [STAThread] Main in Program.cs so we can run the
         WinAppSDK bootstrapper before XAML touches anything. The XAML
         generator's auto-Main wraps in #if !DISABLE_XAML_GENERATED_MAIN;
         define the constant to skip its generation. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Performance: ReadyToRun pre-JITs IL on publish. Native AOT for
         WinUI 3 still has rough edges as of WinAppSDK 1.6 (XAML compiler +
         COM activation), so R2R is the pragmatic max-perf default. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>

    <!-- DPI awareness comes from app.manifest (PerMonitorV2). -->

    <!-- WinUI sources — Generators write into obj/, exclude from compile. -->
    <DefaultLanguage>en-US</DefaultLanguage>

    <!-- Application identity — surfaces in About + the user's Apps & Features list.
         <Version>/<FileVersion> are NOT set here: they come from the single
         source of truth (platforms/windows/VERSION via Directory.Build.props). -->
    <AssemblyTitle>FileID</AssemblyTitle>
    <Description>On-device AI file organization for Windows.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(FileIDRequireSignedEngine)' == 'true'">
    <AssemblyMetadata Include="FileIDRequireSignedEngine" Value="true" />
    <AssemblyMetadata Include="FileIDExpectedSignerSubject" Value="$(FileIDExpectedSignerSubject)" />
    <AssemblyMetadata Include="FileIDExpectedSignerPublicKeySha256" Value="$(FileIDExpectedSignerPublicKeySha256)" />
  </ItemGroup>

  <Target Name="ValidateReleaseSigningPolicy" BeforeTargets="CoreCompile"
          Condition="'$(FileIDRequireSignedEngine)' == 'true'">
    <Error Condition="'$(FileIDExpectedSignerSubject)' == ''"
           Text="Signed release builds must set FileIDExpectedSignerSubject so the app can reject a replaced engine." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch($(FileIDExpectedSignerPublicKeySha256), '^[0-9A-Fa-f]{64}$'))"
           Text="Signed release builds must set FileIDExpectedSignerPublicKeySha256 to the approved signer key identity." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileID.Theme\FileID.Theme.csproj" />
    <ProjectReference Include="..\FileID.IpcSchema\FileID.IpcSchema.csproj" />
  </ItemGroup>

  <!-- App icon + ms-appx:/// Logo PNGs.
       FileID.ico is referenced by <ApplicationIcon> above (embeds in .exe)
       AND copied to the output dir so AppWindow.SetIcon can find it at
       runtime via AppContext.BaseDirectory.
       Assets\Logo\*.png ship alongside the .exe so XAML <Image> with
       Source="ms-appx:///Assets/Logo/FileID-96.png" resolves at runtime. -->
  <ItemGroup>
    <Content Include="Assets\FileID.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Logo\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- WinUI 3 SDK auto-includes XAML via Microsoft.WinUI.targets globs.
       App.xaml is recognized as ApplicationDefinition; the rest become
       Page items. We deliberately do NOT list them here — duplicate
       Page items break the build (NETSDK1022). -->

  <!-- WinAppSDK 1.7+ on .NET 8 strips the main app's `.pri` file
       (FileID.pri) + the WinAppSDK component PRIs from `dotnet publish`
       output. Without FileID.pri, `ms-appx:///MainWindow.xaml` can't
       resolve and the XAML loader fast-fails (0xC000027B) when the
       MainWindow constructor calls InitializeComponent(). Force the
       missing PRIs into the publish folder. -->
  <Target Name="CopyPriFilesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PriToPublish Include="$(OutputPath)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_PriToPublish)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />
  </Target>
</Project>

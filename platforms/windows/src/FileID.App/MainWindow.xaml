<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileID.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:motion="using:FileID.Theme.Motion"
    xmlns:shell="using:FileID.Views.Shell"
    xmlns:sidebar="using:FileID.Views.Sidebar"
    xmlns:views="using:FileID.Views"
    Title="FileID"
    mc:Ignorable="d">

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Pure Microsoft.UI.Composition, not Win2D, which breaks against CoreMessagingXP on Win11 26200+. -->
        <motion:LavaLampBackground Grid.RowSpan="2" />

        <!-- Drag-region backdrop for SetTitleBar(). It holds no interactive children; the sibling
             TitleBar holds the controls, and MainWindow registers their rects as passthrough regions. -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="{StaticResource TitleBarBrush}"
              BorderBrush="{ThemeResource HairlineBrush}"
              BorderThickness="0,0,0,1" />

        <shell:TitleBar x:Name="TitleBarHost" Grid.Row="0" />

        <Grid Grid.Row="1"
              AllowDrop="True"
              DragOver="OnDragOver"
              DragLeave="OnDragLeave"
              Drop="OnDrop">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="232"
                                  MinWidth="232"
                                  MaxWidth="232" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <sidebar:Sidebar x:Name="SidebarHost" Grid.Column="0" />

            <Border Grid.Column="1"
                    Background="{ThemeResource HairlineBrush}" />

            <Grid x:Name="DetailHost"
                  Grid.Column="2"
                  Background="{StaticResource PageSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <shell:PageHeader x:Name="PageHeaderHost" Grid.Row="0" />
                <views:DetailHostView x:Name="PrimaryDetailView" Grid.Row="1" />
            </Grid>
        </Grid>

        <!-- WelcomeSheet host, confined to Row 1 so the title bar stays draggable. A ContentDialog's smoke layer would cover it. -->
        <Grid x:Name="WelcomeOverlay"
              Grid.Row="1"
              Background="#CC0D0D14"
              Visibility="Collapsed">
            <Border MaxWidth="720"
                    MinWidth="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ContentControl x:Name="WelcomeOverlayHost" />
            </Border>
        </Grid>

        <!-- Visible only while a drag is in flight. -->
        <Grid x:Name="DragOverlay"
              Grid.RowSpan="2"
              Background="#990D0D14"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Border Padding="40,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource GoldBrush}"
                    CornerRadius="{StaticResource CornerRadiusL}"
                    Background="{ThemeResource SurfaceBaseBrush}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="48" Foreground="{ThemeResource GoldBrush}" />
                    <TextBlock Text="Drop folder to scan"
                               FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="FileID will read every file inside, on this machine."
                               FontSize="12" Opacity="0.65"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

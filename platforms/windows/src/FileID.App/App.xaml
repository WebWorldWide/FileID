<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FileID.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FileID.Converters"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Stock styles first so the palette overrides win. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Palette and tokens, compiled into the app PRI. -->
                <ResourceDictionary Source="ms-appx:///AppResources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:IdentityDoubleConverter x:Key="IdentityDouble" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FileID.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FileID.Converters"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 stock styles. Must be first so our overrides win. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- FileID palette + tokens are compiled into this app's PRI
                     at AppResources/Theme.xaml for packaged ResourceDictionary loading. -->
                <ResourceDictionary Source="ms-appx:///AppResources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:IdentityDoubleConverter x:Key="IdentityDouble" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<!--
    PageHeader: Prototype v3 page header. Mono-style crumb (AREA / PAGE),
    serif page title, trailing page meta, hairline below. 1:1 port of the
    macOS Detail.pageHeader.
-->
<UserControl
    x:Class="FileID.Views.Shell.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="26,18,26,14"
          ColumnSpacing="16"
          BorderBrush="{StaticResource HairlineBrush}"
          BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="7">
            <TextBlock x:Name="CrumbText"
                       Style="{StaticResource ShellSectionLabelStyle}" />
            <TextBlock x:Name="PageTitleText"
                       Style="{StaticResource PageTitleTextStyle}"
                       AutomationProperties.HeadingLevel="Level1" />
        </StackPanel>
        <TextBlock x:Name="PageMetaText"
                   Grid.Column="1"
                   Style="{StaticResource ShellMetaTextStyle}"
                   Foreground="{StaticResource Text2Brush}"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,6" />
    </Grid>
</UserControl>

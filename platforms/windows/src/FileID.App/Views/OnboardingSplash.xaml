<?xml version="1.0" encoding="utf-8"?>
<!--
    OnboardingSplash — the "How it works" first-run page on the empty Detail
    when no folder is chosen (macOS Detail.swift EmptyState).

    All FontIcon glyphs use numeric XML escapes so the bytes survive
    encoding pipelines.
-->
<UserControl
    x:Class="FileID.Views.OnboardingSplash"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="60,60"
                    HorizontalAlignment="Center"
                    Spacing="20"
                    MaxWidth="620">

            <StackPanel Spacing="8">
                <TextBlock Text="FILEID / GET STARTED"
                           Style="{StaticResource ShellSectionLabelStyle}" />
                <!-- Rainbow-shimmering title — 1:1 with macOS Detail.swift.
                     The LinearGradientBrush's EndPoint is animated by code-behind
                     over 12 s; ReducedMotion freezes it on solid gold. -->
                <TextBlock x:Name="TitleText"
                           Text="FileID"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="56"
                           FontWeight="Bold"
                           AutomationProperties.HeadingLevel="Level1">
                    <TextBlock.Foreground>
                        <LinearGradientBrush x:Name="TitleBrush"
                                             StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="{StaticResource GoldColor}"    Offset="0.0" />
                            <GradientStop Color="{StaticResource DelightColor}" Offset="0.25" />
                            <GradientStop Color="{StaticResource AiColor}"      Offset="0.5" />
                            <GradientStop Color="{StaticResource InfoColor}"    Offset="0.75" />
                            <GradientStop Color="{StaticResource GoldColor}"    Offset="1.0" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Organizes your photos, videos and documents. Everything runs on this PC, and your files never leave it."
                           FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="15"
                           Foreground="{ThemeResource Text2Brush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border CornerRadius="{StaticResource CornerRadiusL}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{ThemeResource HairlineBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Border Padding="14,10"
                            Background="{StaticResource PanelHeaderBrush}"
                            BorderBrush="{ThemeResource HairlineStrongBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="How it works"
                                   FontFamily="{StaticResource BodyFontFamily}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource Text1Brush}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </Border>
                    <Grid Padding="14,10"
                          ColumnSpacing="14"
                          BorderBrush="{ThemeResource HairlineSoftBrush}"
                          BorderThickness="0,0,0,1"
                          AutomationProperties.Name="Step 1: Scan a folder. FileID reads each file, tags what's in your photos and finds faces. Nothing is moved or changed.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18"
                                Height="18"
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource CornerRadiusS}"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="1">
                            <TextBlock Text="1"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Scan a folder"
                                           FontFamily="{StaticResource BodyFontFamily}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="LIBRARY"
                                           Style="{StaticResource ShellMetaTextStyle}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="FileID reads each file, tags what's in your photos and finds faces. Nothing is moved or changed."
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="13"
                                       Foreground="{ThemeResource Text3Brush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Padding="14,10"
                          ColumnSpacing="14"
                          BorderBrush="{ThemeResource HairlineSoftBrush}"
                          BorderThickness="0,0,0,1"
                          AutomationProperties.Name="Step 2: Name the people. Faces are grouped by person. Type a name once and FileID finds that person everywhere.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18"
                                Height="18"
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource CornerRadiusS}"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="1">
                            <TextBlock Text="2"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Name the people"
                                           FontFamily="{StaticResource BodyFontFamily}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="PEOPLE"
                                           Style="{StaticResource ShellMetaTextStyle}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Faces are grouped by person. Type a name once and FileID finds that person everywhere."
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="13"
                                       Foreground="{ThemeResource Text3Brush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Padding="14,10"
                          ColumnSpacing="14"
                          BorderBrush="{ThemeResource HairlineSoftBrush}"
                          BorderThickness="0,0,0,1"
                          AutomationProperties.Name="Step 3: Describe files (optional). A local AI writes a sentence about each file and suggests a clearer name. You approve every rename.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18"
                                Height="18"
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource CornerRadiusS}"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="1">
                            <TextBlock Text="3"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Describe files (optional)"
                                           FontFamily="{StaticResource BodyFontFamily}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="DESCRIBE FILES"
                                           Style="{StaticResource ShellMetaTextStyle}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="A local AI writes a sentence about each file and suggests a clearer name. You approve every rename."
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="13"
                                       Foreground="{ThemeResource Text3Brush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Padding="14,10"
                          ColumnSpacing="14"
                          BorderBrush="{ThemeResource HairlineSoftBrush}"
                          BorderThickness="0,0,0,1"
                          AutomationProperties.Name="Step 4: Search and ask. Find a photo, video or document by what's in it, or ask a question in Chat.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18"
                                Height="18"
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource CornerRadiusS}"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="1">
                            <TextBlock Text="4"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Search and ask"
                                           FontFamily="{StaticResource BodyFontFamily}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="SEARCH &amp; MOMENTS · CHAT"
                                           Style="{StaticResource ShellMetaTextStyle}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Find a photo, video or document by what's in it, or ask a question in Chat."
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="13"
                                       Foreground="{ThemeResource Text3Brush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Padding="14,10"
                          ColumnSpacing="14"
                          BorderBrush="{ThemeResource HairlineSoftBrush}"
                          BorderThickness="0"
                          AutomationProperties.Name="Step 5: Tidy up. Move extra copies to Trash and preview a tidier folder layout before anything moves.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18"
                                Height="18"
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource CornerRadiusS}"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="1">
                            <TextBlock Text="5"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Tidy up"
                                           FontFamily="{StaticResource BodyFontFamily}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Text1Brush}" />
                                <TextBlock Text="DUPLICATES · ORGANIZE FOLDERS"
                                           Style="{StaticResource ShellMetaTextStyle}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Move extra copies to Trash and preview a tidier folder layout before anything moves."
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="13"
                                       Foreground="{ThemeResource Text3Brush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="PickFolderButton"
                        Style="{StaticResource ShellPrimaryButtonStyle}"
                        Click="OnPickFolderClicked"
                        AutomationProperties.Name="Choose a folder to scan"
                        AutomationProperties.HelpText="Choose a folder for FileID to scan (Ctrl+O). Nothing in it is moved or changed.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="13"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Choose a folder to scan" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Or drag a folder onto this window (Ctrl+O)."
                           Style="{StaticResource ShellMetaTextStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

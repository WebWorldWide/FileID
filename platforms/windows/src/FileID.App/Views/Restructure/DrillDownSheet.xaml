<?xml version="1.0" encoding="utf-8"?>
<!--
    DrillDownSheet — modal listing every file flowing through a single
    Sankey ribbon or TreeDiff folder. Each row shows a thumbnail + the
    pre-move path + the post-move path.
    drill-down behavior.
-->
<UserControl
    x:Class="FileID.Views.Restructure.DrillDownSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FileID.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="640"
    MinHeight="440">

    <Grid RowSpacing="12" Padding="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Grid.Row="1"
                   x:Name="CountText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled">
            <Grid>
                <ItemsRepeater x:Name="FileRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="6"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <ItemsRepeater x:Name="SelectableRepeater"
                               Visibility="Collapsed"
                               ElementPrepared="OnSelectionElementPrepared">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RestructureFileRowVm">
                            <Grid Padding="10,6" ColumnSpacing="10"
                                  ToolTipService.ToolTip="{x:Bind FromToTooltip}"
                                  AutomationProperties.Name="{x:Bind FileName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0"
                                          IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                          Click="OnSelectableCheckClicked"
                                          AutomationProperties.Name="{x:Bind FileName}"
                                          AutomationProperties.HelpText="Include this file in the restructure."/>
                                <FontIcon Grid.Column="1" Glyph="{x:Bind FileGlyph}" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FileName}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind FromToTooltip}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<!--
    DeepAnalyzeView — VLM picker + analyze controls + live caption
    stream.

    Layout:
      Row 0: Page header (title + subtitle)
      Row 1: llama.cpp runtime banner (visible if missing)
    Row 2: Model picker five cards in two Grid rows
      Row 3: Active card panel — Analyze whole library / selected / current,
             Cancel, Skip-existing toggle
      Row 4: Live caption stream — current file thumb + token RichText +
             progress bar + N-of-M counter
      Row 5: Proposed renames footer — link to BulkRenameSheet pre-seeded
-->
<UserControl
    x:Class="FileID.Views.DeepAnalyze.DeepAnalyzeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- HorizontalAlignment=Center (was Stretch) for the
             same reason as Settings — center the MaxWidth-capped column
             on wide windows. -->
        <StackPanel Padding="32,32,32,32" Spacing="20" MaxWidth="980" HorizontalAlignment="Center">

            <StackPanel Spacing="4">
                <TextBlock TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="FileID's local AI looks at each file, writes a sentence about it and suggests a clearer name. Nothing is renamed until you approve it." />
            </StackPanel>

            <Border x:Name="ExplainerBanner"
                    CornerRadius="10"
                    Padding="14,12"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource AiBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE946;"
                              FontSize="16"
                              Foreground="{ThemeResource AiBrush}"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0"
                              AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Tags and descriptions"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Tags like sunset, beach or dog are added automatically during the scan, so search already works. Describing is an optional extra step: the AI writes a full sentence about each file and suggests a clearer name, using the names you gave people. It is slower, so it runs only when you ask." />
                    </StackPanel>
                    <Button Grid.Column="2"
                            x:Name="DismissExplainerButton"
                            Click="OnDismissExplainerClicked"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Hide this explanation"
                            ToolTipService.ToolTip="Hide this explanation">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="LibraryStatusCard"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="This library"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="LibraryEmptyText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"
                               Text="No files to describe yet. Scan a folder first; its photos, videos and documents appear here." />
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Can be described"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EligibleCountText" Text="—"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Not described yet"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PendingCountText" Text="—"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="AI model"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ActiveModelText"
                                   FontWeight="SemiBold"
                                   Text="Qwen 2.5-VL 7B"
                                   ToolTipService.ToolTip="Change the description model below" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="NamePeopleGateBanner"
                    CornerRadius="10"
                    Padding="14,12"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource WarningBrush}"
                    BorderThickness="3,1,1,1"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE77B;"
                              FontSize="16"
                              Foreground="{ThemeResource WarningBrush}"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0"
                              AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Tip: name people first"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="With names, descriptions read &quot;Mia playing piano&quot; instead of &quot;a person playing piano&quot;. You can also describe now and again later." />
                        <Button x:Name="GoToPeopleButton"
                                Click="OnGoToPeopleClicked"
                                HorizontalAlignment="Left"
                                ToolTipService.ToolTip="Open the People page and type names on the faces you know"
                                AutomationProperties.Name="Name people"
                                AutomationProperties.HelpText="Open the People page and type names on the faces you know">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Name people" />
                                <FontIcon Glyph="&#xE72A;" FontSize="12" AutomationProperties.AccessibilityView="Raw" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="2"
                            x:Name="DismissNamePeopleTipButton"
                            Click="OnDismissNamePeopleTipClicked"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Hide this tip"
                            ToolTipService.ToolTip="Hide this tip">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock Text="Choose a model"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           FontWeight="SemiBold"
                           CharacterSpacing="40"
                           AutomationProperties.HeadingLevel="Level2" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            x:Name="MistralCard"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="18"
                            Tag="mistral_small_3_2"
                            Tapped="OnModelCardTapped"
                            AutomationProperties.Name="Mistral-Small 3.2 model"
                            AutomationProperties.HelpText="Select this model. Approximately 15.2 GB disk and 16 GB RAM.">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Mistral-Small 3.2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="≈15.2 GB download · needs 16 GB memory"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="MistralStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AiBrush}" />
                            <ProgressBar x:Name="MistralProgress"
                                         Value="0" Maximum="1"
                                         Visibility="Collapsed"
                                         Foreground="{ThemeResource GoldBrush}"
                                         AutomationProperties.Name="Mistral-Small 3.2 download progress" />
                            <Button Content="Download"
                                    x:Name="MistralInstallButton"
                                    Click="OnInstallModelClicked"
                                    Tag="mistral_small_3_2"
                                    Margin="0,4,0,0"
                                    AutomationProperties.Name="Download Mistral-Small 3.2" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            x:Name="QwenLargeCard"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="18"
                            Tag="qwen2_5_vl_7b"
                            Tapped="OnModelCardTapped"
                            AutomationProperties.Name="Qwen 2.5-VL 7B model, default"
                            AutomationProperties.HelpText="Select the default model. Approximately 6.1 GB disk and 7 GB RAM.">
                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Qwen 2.5-VL 7B" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border Grid.Column="1"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Background="{ThemeResource GoldSelectedBackgroundBrush}"
                                        BorderBrush="{ThemeResource GoldSelectedStrokeBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="Default"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource GoldBrush}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="≈6.1 GB download · needs 7 GB memory"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="QwenLargeStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AiBrush}" />
                            <ProgressBar x:Name="QwenLargeProgress"
                                         Value="0" Maximum="1"
                                         Visibility="Collapsed"
                                         Foreground="{ThemeResource GoldBrush}"
                                         AutomationProperties.Name="Qwen 2.5-VL 7B download progress" />
                            <Button Content="Download"
                                    x:Name="QwenLargeInstallButton"
                                    Click="OnInstallModelClicked"
                                    Tag="qwen2_5_vl_7b"
                                    Margin="0,4,0,0"
                                    AutomationProperties.Name="Download Qwen 2.5-VL 7B" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            x:Name="GemmaCard"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="18"
                            Tag="gemma_3_4b"
                            Tapped="OnModelCardTapped"
                            AutomationProperties.Name="Gemma 3 4B model"
                            AutomationProperties.HelpText="Select this model. Approximately 3.4 GB disk and 4.5 GB RAM.">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Gemma 3 4B" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="≈3.4 GB download · needs 4.5 GB memory"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="GemmaStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AiBrush}" />
                            <ProgressBar x:Name="GemmaProgress"
                                         Value="0" Maximum="1"
                                         Visibility="Collapsed"
                                         Foreground="{ThemeResource GoldBrush}"
                                         AutomationProperties.Name="Gemma 3 4B download progress" />
                            <Button Content="Download"
                                    x:Name="GemmaInstallButton"
                                    Click="OnInstallModelClicked"
                                    Tag="gemma_3_4b"
                                    Margin="0,4,0,0"
                                    AutomationProperties.Name="Download Gemma 3 4B" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            x:Name="Qwen3FourCard"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="18"
                            Tag="qwen3_vl_4b"
                            Tapped="OnModelCardTapped"
                            AutomationProperties.Name="Qwen3-VL 4B model"
                            AutomationProperties.HelpText="Select the optional Qwen3-VL 4B model. Approximately 3.3 GB disk.">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Qwen3-VL 4B" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="≈3.3 GB download · optional"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="Qwen3FourStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AiBrush}" />
                            <ProgressBar x:Name="Qwen3FourProgress"
                                         Value="0" Maximum="1"
                                         Visibility="Collapsed"
                                         Foreground="{ThemeResource GoldBrush}"
                                         AutomationProperties.Name="Qwen3-VL 4B download progress" />
                            <Button Content="Download"
                                    x:Name="Qwen3FourInstallButton"
                                    Click="OnInstallModelClicked"
                                    Tag="qwen3_vl_4b"
                                    Margin="0,4,0,0"
                                    AutomationProperties.Name="Download Qwen3-VL 4B" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1"
                            x:Name="Qwen3EightCard"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="18"
                            Tag="qwen3_vl_8b"
                            Tapped="OnModelCardTapped"
                            AutomationProperties.Name="Qwen3-VL 8B model"
                            AutomationProperties.HelpText="Select the optional Qwen3-VL 8B model. Approximately 6.2 GB disk.">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Qwen3-VL 8B" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="≈6.2 GB download · optional"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="Qwen3EightStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AiBrush}" />
                            <ProgressBar x:Name="Qwen3EightProgress"
                                         Value="0" Maximum="1"
                                         Visibility="Collapsed"
                                         Foreground="{ThemeResource GoldBrush}"
                                         AutomationProperties.Name="Qwen3-VL 8B download progress" />
                            <Button Content="Download"
                                    x:Name="Qwen3EightInstallButton"
                                    Click="OnInstallModelClicked"
                                    Tag="qwen3_vl_8b"
                                    Margin="0,4,0,0"
                                    AutomationProperties.Name="Download Qwen3-VL 8B" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Describe files"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="SkipExistingToggle"
                                  Content="Only files not described yet"
                                  IsChecked="True"
                                  Click="OnSkipExistingClicked"
                                  ToolTipService.ToolTip="Leave this on to skip files that already have a description from this model"
                                  AutomationProperties.Name="Only files not described yet"
                                  AutomationProperties.HelpText="When on, files that completed a full pass with this model are skipped; partial passes may run again. When off, every file is described again." />
                        <CheckBox x:Name="ProposeRenamesCheck"
                                  Content="Suggest clearer names"
                                  IsChecked="True"
                                  AutomationProperties.HelpText="When checked, FileID also suggests a clearer name for each file it describes. Nothing is renamed until you approve it." />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AnalyzeAllButton"
                                    Click="OnAnalyzeAllClicked"
                                    Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.Name="Describe files">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE945;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Name="AnalyzeAllText" Text="Describe files" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AnalyzeSelectedButton"
                                    Click="OnAnalyzeSelectedClicked"
                                    ToolTipService.ToolTip="Describe only the files chosen in Library"
                                    AutomationProperties.HelpText="Describe only the files chosen in Library">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE762;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Name="AnalyzeSelectedText" Text="Chosen files" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AnalyzeCurrentButton"
                                    Click="OnAnalyzeCurrentClicked"
                                    ToolTipService.ToolTip="Describe only the file open in the preview"
                                    AutomationProperties.Name="Describe the open file"
                                    AutomationProperties.HelpText="Describe only the file open in the preview">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE890;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Open file" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelButton"
                                    Content="Stop"
                                    Click="OnCancelClicked"
                                    IsEnabled="False"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="Stop describing. Files already described keep their descriptions."
                                    AutomationProperties.HelpText="Stop describing. Files already described keep their descriptions." />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="RunMetaText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="You can keep using your PC while this runs." />
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="To describe one file, open it in Library and press Describe." />
                </StackPanel>
            </Border>

            <Border x:Name="StreamCard"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20"
                    Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="StreamTitleText" Text="Describing files…" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                Width="160" Height="160">
                            <Image x:Name="StreamImage" Stretch="UniformToFill" Width="160" Height="160" AutomationProperties.Name="Preview of the file being described" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock x:Name="StreamFileNameText"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StreamCaptionText"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="StreamInheritedText"
                                       Text="Same as a similar photo"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="StreamProposedNameText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AiBrush}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="OverallProgress" Value="0" Maximum="1" AutomationProperties.Name="Describing progress" />
                    <TextBlock x:Name="OverallProgressText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <Border x:Name="ProposedNamesPill"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20"
                    Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Suggested names" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Grid.Column="1"
                                   x:Name="ProposedNamesPillText"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="FileID suggested clearer names for these files. Check them and choose which to use; nothing is renamed until you do." />
                    <Button x:Name="ReviewNamesButton"
                            Click="OnProposedNamesPillClicked"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.HelpText="Open the list of suggested names and choose which to use">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8AC;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="Review suggested names…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="ApplyActionsCard"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Save to your files" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <ProgressRing x:Name="ApplyProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Add what FileID found to the files themselves as file tags, so File Explorer and Windows Search can find them too. Your own tags are kept." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ApplyTagsButton" Click="OnApplyTagsClicked"
                                AutomationProperties.Name="Add tags to files"
                                AutomationProperties.HelpText="Add the tags FileID found to the files so Windows Search finds them.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE8EC;" />
                                <TextBlock Text="Add tags to files" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ApplyPeopleButton" Click="OnApplyPeopleClicked"
                                ToolTipService.ToolTip="Tag each photo with the names of the people in it"
                                AutomationProperties.Name="Add people's names to files"
                                AutomationProperties.HelpText="Tag each photo with the names of the people in it.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE77B;" />
                                <TextBlock Text="Add people's names to files" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button x:Name="ApplyAllButton" Click="OnApplyAllClicked"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="Adds tags and people's names to the files"
                            AutomationProperties.Name="Add tags and names">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE73E;" />
                            <TextBlock x:Name="ApplyAllText" Text="Add tags and names" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ApplyStatusText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       Text="Models live under %LOCALAPPDATA%\FileID\Models\ — uninstall by deleting the folder. The llama.cpp runtime is fetched once and lives under %LOCALAPPDATA%\FileID\Models\llama.cpp\." />

        </StackPanel>
    </ScrollViewer>
</UserControl>

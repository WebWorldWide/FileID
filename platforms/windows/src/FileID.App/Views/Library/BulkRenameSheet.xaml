<UserControl
    x:Class="FileID.Views.Library.BulkRenameSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileID.Views.Library"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="640"
    MinHeight="420">

    <Grid RowSpacing="12" Padding="4,4,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="HeaderText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Text="Rename selected files"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="SelectionText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="RenameRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:RenamePlan">
                        <Grid ColumnSpacing="10" Padding="8,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{x:Bind Include, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      MinWidth="0" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind CurrentName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />

                            <TextBox Grid.Column="2"
                                     Text="{x:Bind ProposedName, Mode=TwoWay}"
                                     VerticalAlignment="Center"
                                     PlaceholderText="new filename" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>


        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>

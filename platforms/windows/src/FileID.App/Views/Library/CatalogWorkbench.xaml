<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileID.Views.Library.CatalogWorkbench"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinWidth="700" Height="600" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="Query" Width="510" PlaceholderText="Search files, descriptions, or chapters"
                     AutomationProperties.Name="Search moments"/>
            <Button x:Name="Search" Content="Search" Click="OnSearch"/>
        </StackPanel>
        <ListView x:Name="Hits" Grid.Row="1" SelectionChanged="OnHitSelected"
                  AutomationProperties.Name="Matching files and moments"/>
        <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
                <TextBlock x:Name="Filename" FontSize="18" TextWrapping="Wrap"/>
                <MediaPlayerElement x:Name="Video" Height="210" AreTransportControlsEnabled="True"/>
                <TextBlock Text="Chapters" FontSize="16"/>
                <ListView x:Name="Chapters" MaxHeight="130" SelectionChanged="OnChapterSelected"
                          AutomationProperties.Name="Video chapters"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="New" Content="New chapter" Click="OnNew"/>
                    <Button x:Name="Refresh" Content="Refresh" Click="OnRefresh"/>
                    <Button x:Name="Undo" Content="Undo edit" Click="OnUndo"/>
                    <Button x:Name="Delete" Content="Remove selected" Click="OnDelete"/>
                </StackPanel>
                <TextBox x:Name="ChapterTitle" PlaceholderText="Chapter title" AutomationProperties.Name="Chapter title"/>
                <TextBox x:Name="Summary" PlaceholderText="Description" AutomationProperties.Name="Chapter description"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="Start" Width="130" Text="0" PlaceholderText="Start seconds" AutomationProperties.Name="Start seconds"/>
                    <TextBox x:Name="End" Width="130" Text="0" PlaceholderText="End seconds" AutomationProperties.Name="End seconds"/>
                    <Button x:Name="Add" Content="Add chapter" Click="OnAdd"/>
                </StackPanel>
                <TextBlock Text="Markers are stored in the catalog. Originals remain unchanged. Automatic chapter analysis is not available on this platform yet."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="Status" Grid.Row="2" Grid.ColumnSpan="2" Text="Search to select a file or timestamp."
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</UserControl>

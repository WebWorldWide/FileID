<?xml version="1.0" encoding="utf-8"?>
<!-- FilePreviewSheet: modal preview hosted in a ContentDialog; the toolbar Close button raises RequestClose so the host can hide the dialog. Images, PDFs and documents show a 1024 px shell thumbnail; video and audio play inline in a MediaPlayerElement. -->
<UserControl
    x:Class="FileID.Views.Library.FilePreviewSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:FileID.Theme.Controls"
    xmlns:sys="using:System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="880"
    MinHeight="520">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Padding="20,12"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="FileNameText"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.HeadingLevel="Level1"
                           MaxLines="1" />
                <TextBlock x:Name="ParentPathText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontFamily="Consolas"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       x:Name="SiblingCountText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="PrevButton"
                        Click="OnPrevClicked"
                        ToolTipService.ToolTip="Previous file (←)"
                        AutomationProperties.Name="Previous file">
                    <FontIcon Glyph="&#xE76B;" FontSize="13"/>
                </Button>
                <Button x:Name="NextButton"
                        Click="OnNextClicked"
                        ToolTipService.ToolTip="Next file (→)"
                        AutomationProperties.Name="Next file">
                    <FontIcon Glyph="&#xE76C;" FontSize="13"/>
                </Button>
            </StackPanel>

            <Button Grid.Column="3"
                    x:Name="AnalyzeButton"
                    Click="OnAnalyzeClicked"
                    ToolTipService.ToolTip="Write a description and a suggested name for this file"
                    AutomationProperties.Name="Describe this file"
                    AutomationProperties.HelpText="Write a description and a suggested name for this file"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE945;" FontSize="13" />
                    <TextBlock x:Name="AnalyzeButtonText" Text="Describe" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4"
                    Click="OnOpenClicked"
                    ToolTipService.ToolTip="Open in the default app"
                    AutomationProperties.Name="Open in the default app">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                    <TextBlock Text="Open" />
                </StackPanel>
            </Button>

            <Button Grid.Column="5"
                    Click="OnRevealClicked"
                    ToolTipService.ToolTip="Show in Explorer"
                    AutomationProperties.Name="Show in Explorer">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE838;" FontSize="13" />
                    <TextBlock Text="Show in Explorer" />
                </StackPanel>
            </Button>

            <Button Grid.Column="6"
                    x:Name="CloseButton"
                    Click="OnCloseClicked"
                    ToolTipService.ToolTip="Close (Esc)"
                    AutomationProperties.Name="Close preview"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6">
                <FontIcon Glyph="&#xE894;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- One of PreviewImage, PreviewMedia or PlaceholderPanel is visible at a time. -->
            <Grid Grid.Column="0"
                  x:Name="PreviewCanvas"
                  Background="#1A000000">

                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="20"
                       AutomationProperties.Name="File preview"
                       Visibility="Collapsed" />

                <!-- Handles both video and audio. -->
                <MediaPlayerElement x:Name="PreviewMedia"
                                    AreTransportControlsEnabled="True"
                                    AutoPlay="False"
                                    Margin="20"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />

                <StackPanel x:Name="PlaceholderPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14"
                            Visibility="Collapsed">
                    <FontIcon x:Name="KindGlyphIcon"
                              Glyph="&#xE8B7;"
                              FontSize="64"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Name="PlaceholderText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="380"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="40" Height="40"/>
                    <TextBlock Text="Loading preview…"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="BadgesPanel"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,20,0,0">
                    <Border x:Name="TextBadge"
                            Background="#992A2A33"
                            BorderBrush="{ThemeResource GoldDimBrush}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="8,4"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8E9;" FontSize="11"
                                      Foreground="{ThemeResource GoldBrush}" />
                            <TextBlock Text="Text"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="White" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1"
                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16" Spacing="14">

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Metadata"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <Grid x:Name="MetadataGrid"
                                      RowSpacing="4"
                                      ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Rows are added in code-behind so a missing field leaves no empty row. -->
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Every auto and user tag on the file; hidden when it has none. -->
                        <Border x:Name="VisionTagsCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Tags"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <!-- Chips are added in code-behind: WinUI 3 has no wrapping layout whose cells may differ in width. -->
                                <Grid x:Name="VisionTagsHost" />
                            </StackPanel>
                        </Border>

                        <!-- Visible only when Deep Analyze has written a proposed name for this file. -->
                        <Border x:Name="ProposedRenameCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource GoldBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Suggested name"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource GoldBrush}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock x:Name="ProposedRenameText"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ApplyRenameButton"
                                            Content="Rename"
                                            Click="OnApplyRenameClicked"
                                            ToolTipService.ToolTip="Renames the file to the suggested name. Undo at the top of Library puts the old name back."
                                            AutomationProperties.HelpText="Renames the file to the suggested name. Undo at the top of Library puts the old name back."
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Dismiss"
                                            Click="OnDismissRenameClicked"
                                            AutomationProperties.HelpText="Hides the suggested name without renaming the file" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Tags"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="TagInput"
                                             PlaceholderText="Add tags (comma-separated)"
                                             KeyDown="OnTagInputKeyDown"
                                             AutomationProperties.Name="Add tags"
                                             AutomationProperties.HelpText="Enter one or more tags separated by commas, then press Enter or Add" />
                                    <Button Grid.Column="1"
                                            x:Name="ApplyTagsButton"
                                            Click="OnApplyTagsClicked"
                                            Content="Add"
                                            AutomationProperties.Name="Add tags to this file" />
                                </Grid>
                                <TextBlock x:Name="TagStatusText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<!-- LibraryView: search bar, kind filter and thumbnail grid. -->
<UserControl
    x:Class="FileID.Views.Library.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FileID.ViewModels"
    xmlns:library="using:FileID.Views.Library"
    xmlns:motion="using:FileID.Theme.Motion"
    xmlns:theme="using:FileID.Theme.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Ctrl+F focuses search, Esc clears selection or search, Ctrl+A selects all, Ctrl+Z undoes. Scoped to the UserControl so they fire anywhere on the page. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFocusSearchAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="A" Invoked="OnSelectAllAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </UserControl.KeyboardAccelerators>

    <Grid Padding="26,20,26,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="36"
                     PlaceholderText="Filter by name, tag, description or person"
                     TextChanged="OnSearchChanged"
                     AutomationProperties.Name="Search files"
                     AutomationProperties.HelpText="Find files by name, tag, description, person or text inside them (Ctrl+F)"/>

            <ComboBox x:Name="KindFilter"
                      Grid.Column="1"
                      Width="160"
                      SelectionChanged="OnKindChanged"
                      SelectedIndex="0"
                      AutomationProperties.Name="Filter by file kind">
                <ComboBoxItem Content="All kinds" Tag="all"/>
                <ComboBoxItem Content="Images" Tag="image"/>
                <ComboBoxItem Content="Videos" Tag="video"/>
                <ComboBoxItem Content="Documents" Tag="doc"/>
                <ComboBoxItem Content="PDFs" Tag="pdf"/>
                <ComboBoxItem Content="Audio" Tag="audio"/>
            </ComboBox>

            <TextBlock x:Name="ShownCountText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="12"
                       Foreground="{ThemeResource Text3Brush}" />

            <Button x:Name="SelectAllButton"
                    Grid.Column="3"
                    Click="OnSelectAllClicked"
                    ToolTipService.ToolTip="Select all visible files (Ctrl+A)"
                    AutomationProperties.Name="Select all visible files"
                    AutomationProperties.HelpText="Selects every visible file; toggles to clear the selection (Ctrl+A)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE762;" FontSize="13" />
                    <TextBlock x:Name="SelectAllText" Text="Select" />
                </StackPanel>
            </Button>

            <Button x:Name="UndoButton"
                    Grid.Column="4"
                    Click="OnUndoLastClicked"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Undo your last change on this page (Ctrl+Z)"
                    AutomationProperties.Name="Undo last change"
                    AutomationProperties.HelpText="Undoes your last change on this page, such as a rename, a tag change or a move to the Recycle Bin (Ctrl+Z)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7A7;" FontSize="13" />
                    <TextBlock x:Name="UndoButtonText" Text="Undo" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Banners for the CLIP-not-installed hint, Deep Analyze captioning and face clustering. -->
        <StackPanel Grid.Row="1" Spacing="6">
            <Border x:Name="ClipMissingBanner"
                    Visibility="Collapsed"
                    CornerRadius="10"
                    Padding="12,10"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource AiBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="14"
                              Foreground="{ThemeResource AiBrush}"
                              VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="To search by what's in a photo (&quot;sunset at the beach&quot;, &quot;red car&quot;), download the Search by description model." />
                    <Button Grid.Column="2" Content="Download" Click="OnInstallClipFromBannerClicked" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Download the Search by description model (CLIP)"
                            AutomationProperties.Name="Download the Search by description model"
                            AutomationProperties.HelpText="Downloads the CLIP model so you can search photos by what's in them" />
                </Grid>
            </Border>
            <Border x:Name="DeepAnalyzeBanner"
                    Visibility="Collapsed"
                    CornerRadius="10"
                    Padding="12,10"
                    Background="{ThemeResource GoldSelectedBackgroundBrush}"
                    BorderBrush="{ThemeResource GoldBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ProgressRing Grid.Column="0" IsActive="True" Width="16" Height="16"
                                  Foreground="{ThemeResource GoldBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="DeepAnalyzeBannerText"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               Text="Describing files…" />
                </Grid>
            </Border>
            <Border x:Name="FaceClusteringBanner"
                    Visibility="Collapsed"
                    CornerRadius="10"
                    Padding="12,10"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource AiBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ProgressRing Grid.Column="0" IsActive="True" Width="16" Height="16"
                                  Foreground="{ThemeResource AiBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Grouping faces… Finding the same person across photos. They will appear on the People page." />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2"
              x:Name="SelectionBar"
              Visibility="Collapsed"
              ColumnSpacing="10"
              Padding="14,10"
              CornerRadius="10"
              Background="{ThemeResource AccentFillColorTertiaryBrush}"
              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
              BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="SelectionCountText"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button Grid.Column="1" x:Name="AskChatButton" Click="OnAskChatSelectedClicked"
                    ToolTipService.ToolTip="Open Chat with only the chosen files attached"
                    AutomationProperties.Name="Ask Chat about the selected files">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8BD;" FontSize="13"/>
                    <TextBlock x:Name="AskChatText" Text="Ask about these"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Click="OnTagSelectedClicked"
                    ToolTipService.ToolTip="Add tags to the chosen files"
                    AutomationProperties.Name="Tag selected files">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8EC;" FontSize="13"/>
                    <TextBlock Text="Tag…"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Click="OnRenameSelectedClicked"
                    ToolTipService.ToolTip="Rename the chosen files"
                    AutomationProperties.Name="Rename selected files">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8AC;" FontSize="13"/>
                    <TextBlock Text="Rename…"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Click="OnTrashSelectedClicked"
                    ToolTipService.ToolTip="Move the chosen files to the Recycle Bin"
                    AutomationProperties.Name="Move selected files to the Recycle Bin">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                    <TextBlock Text="Trash…"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="5" Click="OnClearSelectionClicked"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Clear selection (Esc)"
                    AutomationProperties.Name="Clear selection">
                <FontIcon Glyph="&#xE894;" FontSize="13"/>
            </Button>
        </Grid>

        <!-- IsTabStop lets Tab land on the grid, where OnGridPreviewKeyDown takes over arrow keys; tile clicks also route focus here. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PaneColumn" Width="0" />
            </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="GridScroller"
                      Grid.Column="0"
                      IsTabStop="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ZoomMode="Disabled">
            <ItemsRepeater x:Name="Repeater"
                           ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                           ElementPrepared="OnRepeaterElementPrepared"
                           ElementClearing="OnRepeaterElementClearing">
                <!-- Cells are at least 180 wide; each tile sets its own height in OnTileSizeChanged. MinItemHeight=248 is 180 + 68 (caption row). -->
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="180"
                                       MinItemHeight="248"
                                       MinRowSpacing="12"
                                       MinColumnSpacing="12"
                                       ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileTile">
                        <!-- Height = width + 68 (caption row), set from SizeChanged in OnTileSizeChanged so the image area is square. Binding to ActualWidth does not work: it is not an observable DP, so a OneWay bind reads 0 before layout and never re-fires. -->
                        <Grid x:Name="TileRoot"
                              CornerRadius="12"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderThickness="1"
                              Padding="12"
                              SizeChanged="OnTileSizeChanged"
                              Tag="{x:Bind Path}"
                              Tapped="OnTileTapped"
                              RightTapped="OnTileRightTapped"
                              DoubleTapped="OnTileDoubleTapped"
                              CanDrag="True"
                              DragStarting="OnTileDragStarting"
                              PointerEntered="OnTilePointerEntered"
                              PointerExited="OnTilePointerExited"
                              ToolTipService.ToolTip="{x:Bind Path}"
                              AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                              AutomationProperties.HelpText="Click to show details, double-click to preview, or right-click for more actions">
                            <!-- Inline so each tile gets its own animatable instance. -->
                            <Grid.BorderBrush>
                                <SolidColorBrush Color="White" Opacity="0.08" />
                            </Grid.BorderBrush>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open"
                                                    Click="OnContextOpen"
                                                    Tag="{x:Bind Path}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8E5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Show in Explorer"
                                                    Click="OnContextReveal"
                                                    Tag="{x:Bind Path}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE838;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Find similar"
                                                    Click="OnContextFindSimilar"
                                                    Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="Search for visually similar images via CLIP">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE721;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Copy path"
                                                    Click="OnContextCopyPath"
                                                    Tag="{x:Bind Path}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <!-- Row 0 is the square image; row 1 is the caption, pinned at 68 DIP so long names or extra chips cannot grow the image area. -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="68"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                    CornerRadius="8">
                                <Grid>
                                    <!-- Shimmer until the thumbnail loads or fails; ThumbnailFailed swaps it for the broken-image placeholder. -->
                                    <motion:ShimmerView
                                        Visibility="{x:Bind ShowShimmer, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                    <!-- No ImageOpened handler: it never fires for pre-decoded or cached BitmapImages. ShowShimmer is the load indicator. -->
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch" />
                                    <!-- Broken-image placeholder when the thumbnail fallback chain returns null. -->
                                    <FontIcon Glyph="&#xE91F;"
                                              FontSize="48"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="{x:Bind ThumbnailFailed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="0"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="3"
                                    CornerRadius="8"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <FontIcon Grid.Row="0"
                                      Glyph="&#xE73E;"
                                      FontSize="22"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,4,4,0"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Kind badge first so it reads left to right even when the face and OCR badges are absent. -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="4,4,0,0">
                                <Border Style="{StaticResource ImageBadgeStyle}"
                                        ToolTipService.ToolTip="{x:Bind KindDisplay}">
                                    <FontIcon Glyph="{x:Bind KindBadgeGlyph}" FontSize="12" Foreground="White" />
                                </Border>
                                <Border Style="{StaticResource ImageBadgeStyle}"
                                        BorderBrush="{StaticResource ImageBadgeWarningStrokeBrush}"
                                        Visibility="{x:Bind IsOffline, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="OFFLINE"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <Border Style="{StaticResource ImageBadgeStyle}"
                                        BorderBrush="{StaticResource ImageBadgeAiStrokeBrush}"
                                        Visibility="{x:Bind HasText, Converter={StaticResource BoolToVisibility}}">
                                    <FontIcon Glyph="&#xE8C1;" FontSize="12" Foreground="{ThemeResource AiBrush}" />
                                </Border>
                            </StackPanel>
                            <!-- Fixed 68 DIP; overflow is clipped by the row constraint. -->
                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,8,0,0"
                                        VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind FileName}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Gold proposal text; the ToolTip echoes it so truncated text stays discoverable. -->
                                <TextBlock Text="{x:Bind ProposedName, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource GoldBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind HasProposedName, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                           ToolTipService.ToolTip="{x:Bind ProposedName, Mode=OneWay}" />
                                <!-- HasChips collapses the row on bare Other-kind files so the caption keeps its fixed 68 DIP height. -->
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            Visibility="{x:Bind HasChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <theme:TagChip TagText="{x:Bind KindDisplay}"
                                                   Variant="Kind"
                                                   Visibility="{x:Bind ShowKindChip, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{x:Bind TopTwoTags, Mode=OneWay}"
                                                  Visibility="{x:Bind HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <theme:TagChip TagText="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind SizeDisplay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind DateDisplay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

            <Grid x:Name="PaneHost"
                  Grid.Column="1"
                  Margin="12,0,0,0"
                  Visibility="Collapsed"
                  BorderBrush="{ThemeResource HairlineBrush}"
                  BorderThickness="1,0,0,0">
                <library:LibrarySelectedPane x:Name="SelectedPane" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind FooterVisibility, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="16" Height="16"/>
            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="ShowWeakerButton" Visibility="Collapsed" Click="OnShowWeakerClicked"
                    ToolTipService.ToolTip="Also show the weaker look-alikes for this search"
                    AutomationProperties.HelpText="Shows the pictures that only loosely resemble the search" />
        </StackPanel>
    </Grid>
</UserControl>

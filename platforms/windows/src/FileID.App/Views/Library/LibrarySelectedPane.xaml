<?xml version="1.0" encoding="utf-8"?>
<!--
    LibrarySelectedPane: the 300 px details pane a single click opens beside
    the Library grid (macOS LibrarySelectedPane). 16:10 preview, name and
    folder, Kind / Captured / Size / Camera / People rows, caption, tags,
    Open preview / Similar / Show in Explorer / Open.
-->
<UserControl
    x:Class="FileID.Views.Library.LibrarySelectedPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileID.Theme.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#590B0B0C">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="16" Spacing="14">
                <Grid>
                    <TextBlock Text="SELECTED"
                               Style="{StaticResource ShellSectionLabelStyle}"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ShellGhostButtonStyle}"
                            Width="28"
                            Height="28"
                            MinHeight="28"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="OnCloseClicked"
                            ToolTipService.ToolTip="Close details (Esc)"
                            AutomationProperties.Name="Close details">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                </Grid>

                <Grid x:Name="PreviewFrame"
                      Height="167"
                      CornerRadius="{StaticResource CornerRadiusM}"
                      Background="#59000000"
                      BorderBrush="{ThemeResource HairlineBrush}"
                      BorderThickness="1"
                      DoubleTapped="OnPreviewDoubleTapped">
                    <FontIcon x:Name="PreviewGlyph"
                              FontSize="28"
                              Glyph="&#xE8A5;"
                              Foreground="{ThemeResource Text3Brush}" />
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           AutomationProperties.Name="Selected file preview" />
                </Grid>

                <StackPanel Spacing="3">
                    <TextBlock x:Name="NameText"
                               FontFamily="{StaticResource BodyFontFamily}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource Text1Brush}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="FolderText"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{ThemeResource Text3Brush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel x:Name="DetailRows" />

                <TextBlock x:Name="CaptionText"
                           Visibility="Collapsed"
                           FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="12.5"
                           Foreground="{ThemeResource Text2Brush}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />

                <TextBlock x:Name="CaptionInheritedText"
                           Visibility="Collapsed"
                           Text="Same as a similar photo"
                           FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="11"
                           Foreground="{ThemeResource Text3Brush}" />

                <controls:FlowPanel x:Name="TagsHost" Spacing="6" Visibility="Collapsed" />

                <StackPanel Spacing="6">
                    <Button Style="{StaticResource ShellPrimaryButtonStyle}"
                            Height="30"
                            MinHeight="30"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenPreviewClicked"
                            ToolTipService.ToolTip="Full preview with tags, the suggested name and Describe (or double-click the tile)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7B3;" FontSize="12" />
                            <TextBlock Text="Open preview" />
                        </StackPanel>
                    </Button>
                    <Grid x:Name="ActionsRow" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SimilarColumn" Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SimilarButton"
                                Grid.Column="0"
                                Style="{StaticResource ShellSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Content="Similar"
                                Click="OnSimilarClicked"
                                ToolTipService.ToolTip="Find visually similar files" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ShellSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Content="Explorer"
                                Click="OnRevealClicked"
                                ToolTipService.ToolTip="Show in Explorer"
                                AutomationProperties.Name="Show in Explorer" />
                        <Button Grid.Column="2"
                                Style="{StaticResource ShellSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Content="Open"
                                Click="OnOpenClicked"
                                ToolTipService.ToolTip="Open in the default app" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileID.Views.Library.ToolsWorkbench"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinWidth="700" Height="620" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="Query" Width="490" PlaceholderText="Find files by name or description" AutomationProperties.Name="Find files for export"/>
            <Button x:Name="Search" Content="Find" Click="OnSearch"/>
            <Button x:Name="Refresh" Content="Refresh tools" Click="OnRefresh"/>
        </StackPanel>
        <ListView x:Name="Hits" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Files to export"/>
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="Kind" Width="190" Header="Tool" SelectionChanged="OnKindChanged"/>
                <ComboBox x:Name="Format" Width="130" Header="Output" SelectionChanged="OnFormatChanged"/>
                <NumberBox x:Name="Dimension" Header="Maximum pixels" Width="160" Minimum="1" Maximum="8192" Value="4096" SmallChange="1" ValueChanged="OnDimensionChanged"/>
            </StackPanel>
            <ToggleSwitch x:Name="Enlarge" Header="Enlarge smaller photos to the maximum size" Toggled="OnEnlargeChanged"/>
            <TextBlock x:Name="Detail" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <Button x:Name="Choose" Content="Choose output folder" Click="OnChoose"/>
            <TextBlock x:Name="Destination" Text="No output folder selected" Width="490" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button x:Name="History" Content="Last export" Click="OnHistory"/>
            <Button x:Name="Preview" Content="Preview export" Click="OnPreview"/>
            <Button x:Name="Export" Content="Export new versions" Click="OnExport"/>
            <Button x:Name="Undo" Content="Undo export" Click="OnUndo"/>
        </StackPanel>
        <ListView x:Name="Outputs" Grid.Row="5" AutomationProperties.Name="Export preview and results"/>
        <TextBlock x:Name="Status" Grid.Row="6" Text="Exports create new versions and preserve originals. Conventional enlargement does not recover missing detail."
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</UserControl>

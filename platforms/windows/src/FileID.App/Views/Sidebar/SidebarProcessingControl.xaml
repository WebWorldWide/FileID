<?xml version="1.0" encoding="utf-8"?>
<!--
    SidebarProcessingControl: the Prototype v3 scan card at the foot of the
    sidebar (macOS Views/Shell/PipelineBlock.swift). Title + percent, a 6 px
    capsule bar, the five-step indicator (SidebarPipelineProgress), one sub
    line, collapsible counters (found, tagged, memory, failures) and the scan
    controls (Scan / Pause / Resume / Stop / Rescan).

    Three control states:
      • Pre-scan: "Scan <folder>" gold button (Ctrl+R), or Choose folder.
      • In-flight: Pause / Resume + Stop.
      • Completed: Rescan, or Scan again after a stop.

    All FontIcon glyphs use numeric XML escapes so the bytes survive
    encoding pipelines.
-->
<UserControl
    x:Class="FileID.Views.Sidebar.SidebarProcessingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileID.Views.Sidebar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <!-- Non-fatal engine events: skipped stages, partial discovery,
             stale-WAL warning, CUDA fall-back. Distinct from LastError
             so a later per-file error can't clobber the banner. -->
        <Grid x:Name="WarningBanner"
              Visibility="Collapsed"
              Padding="10,8"
              CornerRadius="{StaticResource CornerRadiusM}"
              Background="{StaticResource GoldWashBrush}"
              BorderBrush="{StaticResource GoldSelectedStrokeBrush}"
              BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0"
                      Glyph="&#xE7BA;"
                      FontSize="13"
                      Margin="0,2,8,0"
                      Foreground="{StaticResource GoldBrush}"
                      VerticalAlignment="Top" />
            <TextBlock Grid.Column="1"
                       x:Name="WarningBannerText"
                       FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="12"
                       Foreground="{ThemeResource Text1Brush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Style="{StaticResource ShellGhostButtonStyle}"
                    Click="OnDismissWarningClicked"
                    ToolTipService.ToolTip="Dismiss"
                    AutomationProperties.Name="Dismiss warning">
                <FontIcon Glyph="&#xE711;" FontSize="10" />
            </Button>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CardTitleText"
                       Text="Ready to scan"
                       FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource Text1Brush}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="CardPercentText"
                       Grid.Column="1"
                       Text="0%"
                       FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource Text2Brush}" />
        </Grid>

        <ProgressBar x:Name="ScanProgressBar"
                     Height="6"
                     MinHeight="6"
                     CornerRadius="3"
                     IsIndeterminate="False"
                     Maximum="100"
                     Value="0"
                     Foreground="{StaticResource GoldProgressBrush}"
                     Background="{StaticResource ProgressTrackBrush}" />

        <Grid>
            <local:SidebarPipelineProgress x:Name="StepsStrip" />
            <Button x:Name="DetailsToggleButton"
                    Style="{StaticResource ShellGhostButtonStyle}"
                    Width="20"
                    Height="20"
                    MinHeight="20"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    Click="OnDetailsToggleClicked"
                    ToolTipService.ToolTip="Show scan details"
                    AutomationProperties.Name="Show scan details">
                <FontIcon x:Name="DetailsToggleGlyph"
                          Glyph="&#xE70D;"
                          FontSize="10"
                          Foreground="{ThemeResource Text3Brush}" />
            </Button>
        </Grid>

        <TextBlock x:Name="IdleStatusText"
                   Text="Or drag a folder onto this window."
                   FontFamily="{StaticResource BodyFontFamily}"
                   FontSize="12"
                   Foreground="{ThemeResource Text3Brush}"
                   TextWrapping="Wrap"
                   MaxLines="3"
                   TextTrimming="CharacterEllipsis" />

        <!-- Counters: found, tagged, memory, failures (collapsible). -->
        <StackPanel x:Name="DetailsPanel"
                    Visibility="Collapsed"
                    Spacing="4"
                    Padding="0,6"
                    BorderBrush="{ThemeResource HairlineSoftBrush}"
                    BorderThickness="0,1,0,1">
            <Grid x:Name="DiscoveredStatBorder" ColumnSpacing="6" AutomationProperties.Name="Discovered">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Found" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource Text3Brush}" />
                <TextBlock x:Name="StatDiscovered" Grid.Column="1" Text="—" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource Text1Brush}" />
                <TextBlock x:Name="EtaText" Grid.Column="2" Text="" FontFamily="{StaticResource BodyFontFamily}" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" />
            </Grid>
            <Grid x:Name="TaggedStatBorder" ColumnSpacing="6" AutomationProperties.Name="Tagged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Read" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource Text3Brush}" />
                <TextBlock x:Name="StatTagged" Grid.Column="1" Text="—" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource Text1Brush}" />
                <TextBlock x:Name="StatRate" Grid.Column="2" Text="" FontFamily="{StaticResource BodyFontFamily}" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" />
            </Grid>
            <Grid x:Name="MemoryStatBorder" ColumnSpacing="6" AutomationProperties.Name="Memory">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Memory" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource Text3Brush}" />
                <TextBlock x:Name="StatMemory" Grid.Column="1" Text="—" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="Medium" />
                <TextBlock x:Name="StatAvailable" Grid.Column="2" Text="" FontFamily="{StaticResource BodyFontFamily}" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" />
            </Grid>
            <Grid x:Name="FailuresStatBorder" ColumnSpacing="6" AutomationProperties.Name="Failures">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Failed" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource Text3Brush}" />
                <TextBlock x:Name="StatFailures" Grid.Column="1" Text="0" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="Medium" />
            </Grid>
        </StackPanel>

        <HyperlinkButton x:Name="NextStepButton"
                         Click="OnNextStepClicked"
                         Padding="0"
                         MinHeight="22"
                         HorizontalAlignment="Left"
                         Visibility="Collapsed"
                         ToolTipService.ToolTip="Optional: write a description and a clearer name for each file"
                         AutomationProperties.Name="Next: describe files">
            <TextBlock Text="Next: describe files &#x2192;"
                       FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{StaticResource GoldBrush}" />
        </HyperlinkButton>

        <!-- Pre-scan: Scan <folder> / Choose folder / Restart Engine -->
        <StackPanel x:Name="IdlePanel" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="StartScanButton"
                        Style="{StaticResource ShellPrimaryButtonStyle}"
                        Height="28"
                        MinHeight="28"
                        Click="OnStartScanClicked"
                        AccessKey="R"
                        ToolTipService.ToolTip="Read every file in this folder (Ctrl+R). Nothing is moved or changed."
                        AutomationProperties.Name="Scan"
                        AutomationProperties.HelpText="Read every file in this folder (Ctrl+R). Nothing is moved or changed.">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon FontSize="11" Glyph="&#xE768;" />
                        <TextBlock x:Name="StartScanText"
                                   Text="Scan"
                                   MaxWidth="150"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button x:Name="PickFolderButton"
                        Style="{StaticResource ShellPrimaryButtonStyle}"
                        Height="30"
                        MinHeight="30"
                        Visibility="Collapsed"
                        Click="OnPickFolderClicked"
                        ToolTipService.ToolTip="Choose a folder for FileID to scan (Ctrl+O)"
                        AutomationProperties.Name="Choose folder">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon FontSize="12" Glyph="&#xE8F4;" />
                        <TextBlock Text="Choose folder…" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button x:Name="RestartEngineButton"
                    Style="{StaticResource ShellPrimaryButtonStyle}"
                    Height="28"
                    MinHeight="28"
                    HorizontalAlignment="Left"
                    Click="OnRestartEngineClicked"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Restart Engine"
                    AutomationProperties.HelpText="Restart the local FileID engine after a graphics device reset">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon FontSize="11" Glyph="&#xE117;" />
                    <TextBlock Text="Restart Engine" />
                </StackPanel>
            </Button>
            <!-- Diagnostic link when a scan didn't behave as expected. Opens
                 %LOCALAPPDATA%\FileID\logs\engine.jsonl in the default handler. -->
            <HyperlinkButton x:Name="OpenLogButton"
                             Click="OnOpenLogClicked"
                             Padding="0"
                             HorizontalAlignment="Left"
                             Visibility="Collapsed"
                             AutomationProperties.Name="Open engine log"
                             AutomationProperties.HelpText="Open the engine diagnostic log in your default viewer">
                <TextBlock Text="Open engine log"
                           FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="12"
                           Foreground="{ThemeResource Text3Brush}" />
            </HyperlinkButton>
        </StackPanel>

        <!-- In-flight: Pause / Resume + Stop -->
        <StackPanel x:Name="ScanningPanel"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="Collapsed">
            <Button x:Name="PauseResumeButton"
                    Style="{StaticResource ShellSecondaryButtonStyle}"
                    Height="28"
                    MinHeight="28"
                    Click="OnPauseResumeClicked">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="PauseResumeGlyph" FontSize="11" Glyph="&#xE769;" />
                    <TextBlock x:Name="PauseResumeText" Text="Pause" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ShellGhostButtonStyle}"
                    Height="28"
                    MinHeight="28"
                    Content="Stop"
                    Click="OnCancelClicked"
                    ToolTipService.ToolTip="Stop scanning. Scan again later to pick up where it left off."
                    AutomationProperties.Name="Stop scan" />
        </StackPanel>

        <!-- Completed: Rescan -->
        <StackPanel x:Name="CompletedPanel"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="Collapsed">
            <Button x:Name="RescanButton"
                    Style="{StaticResource ShellSecondaryButtonStyle}"
                    Height="28"
                    MinHeight="28"
                    Click="OnStartScanClicked"
                    ToolTipService.ToolTip="Look for new or changed files. Files already read are skipped. (Ctrl+R)"
                    AutomationProperties.Name="Rescan">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon FontSize="11" Glyph="&#xE72C;" />
                    <TextBlock x:Name="RescanText" Text="Rescan" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>

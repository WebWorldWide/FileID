<?xml version="1.0" encoding="utf-8"?>
<!--
    SidebarFolderHeader: the title-bar folder switcher popover (Prototype v3).
    Hosted in TitleBar.FolderFlyout. Current folder with path and file count,
    Add folder (Ctrl+O), Rescan, Clear folder and Wipe library (destructive,
    confirmed). Layout matches the macOS TitleBar folderPopover.
-->
<UserControl
    x:Class="FileID.Views.Sidebar.SidebarFolderHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Width="360">
        <TextBlock Text="FOLDERS"
                   Style="{StaticResource ShellSectionLabelStyle}"
                   Margin="12,10,12,8"
                   AutomationProperties.HeadingLevel="Level2" />

        <Grid x:Name="FolderDisplayPanel"
              Visibility="Collapsed"
              Padding="12,9,12,9"
              ColumnSpacing="10"
              BorderBrush="{StaticResource HairlineSoftBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="&#x25A0;"
                       FontSize="12"
                       Foreground="{StaticResource GoldBrush}"
                       Margin="0,3,0,0" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="LeafNameText"
                           FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text1Brush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FolderPathText"
                           Style="{StaticResource ShellMetaTextStyle}" />
            </StackPanel>
            <TextBlock x:Name="FileCountText"
                       Grid.Column="2"
                       Style="{StaticResource ShellMetaTextStyle}"
                       Foreground="{StaticResource Text2Brush}" />
        </Grid>

        <TextBlock x:Name="EmptyFolderText"
                   Text="No folder picked yet."
                   Style="{StaticResource ShellMetaTextStyle}"
                   Margin="12,0,12,10" />

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    Padding="10"
                    Background="{StaticResource PanelHeaderBrush}"
                    BorderBrush="{StaticResource HairlineStrongBrush}"
                    BorderThickness="0,1,0,0">
            <Button Style="{StaticResource ShellSecondaryButtonStyle}"
                    Content="Add folder…"
                    Click="OnPickClicked"
                    ToolTipService.ToolTip="Pick a library folder (Ctrl+O)"
                    AutomationProperties.Name="Add folder"
                    AutomationProperties.HelpText="Pick a library folder (Ctrl+O)" />
            <Button x:Name="RescanButton"
                    Style="{StaticResource ShellSecondaryButtonStyle}"
                    Click="OnRescanClicked"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Rescan this folder (Ctrl+R)">
                <TextBlock x:Name="RescanText"
                           Text="Rescan"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis" />
            </Button>
        </StackPanel>

        <Grid x:Name="ActionsPanel"
              Visibility="Collapsed"
              Padding="10,8,10,8"
              BorderBrush="{StaticResource HairlineSoftBrush}"
              BorderThickness="0,1,0,0">
            <Button Style="{StaticResource ShellGhostButtonStyle}"
                    Content="Clear folder"
                    Click="OnClearClicked"
                    HorizontalAlignment="Left"
                    ToolTipService.ToolTip="Drop the current folder selection. Doesn't touch the library."
                    AutomationProperties.Name="Clear folder" />
            <Button Style="{StaticResource ShellGhostButtonStyle}"
                    Content="Wipe library…"
                    Foreground="{StaticResource DangerBrush}"
                    Click="OnWipeClicked"
                    HorizontalAlignment="Right"
                    ToolTipService.ToolTip="Delete everything FileID has learned and reset to a clean slate. Your files and downloaded models are kept."
                    AutomationProperties.Name="Wipe library"
                    AutomationProperties.HelpText="Delete everything FileID has learned and reset to a clean slate. Your files and downloaded models are kept." />
        </Grid>
    </StackPanel>
</UserControl>

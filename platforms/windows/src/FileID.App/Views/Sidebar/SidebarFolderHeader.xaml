<?xml version="1.0" encoding="utf-8"?>
<!--
    SidebarFolderHeader: the title-bar folder switcher popover (Prototype v3).
    Hosted in TitleBar.FolderFlyout. Current folder with path and file count,
    Choose folder (Ctrl+O), Rescan, Close folder and Start over (destructive,
    confirmed). Layout matches the macOS TitleBar folderPopover.
-->
<UserControl
    x:Class="FileID.Views.Sidebar.SidebarFolderHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Width="360">
        <TextBlock Text="FOLDERS"
                   Style="{StaticResource ShellSectionLabelStyle}"
                   Margin="12,10,12,8"
                   AutomationProperties.HeadingLevel="Level2" />

        <Grid x:Name="FolderDisplayPanel"
              Visibility="Collapsed"
              Padding="12,9,12,9"
              ColumnSpacing="10"
              BorderBrush="{ThemeResource HairlineSoftBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="&#x25A0;"
                       FontSize="12"
                       Foreground="{StaticResource GoldBrush}"
                       Margin="0,3,0,0" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="LeafNameText"
                           FontFamily="{StaticResource BodyFontFamily}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource Text1Brush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FolderPathText"
                           Style="{StaticResource ShellMetaTextStyle}" />
            </StackPanel>
            <TextBlock x:Name="FileCountText"
                       Grid.Column="2"
                       Style="{StaticResource ShellMetaTextStyle}"
                       Foreground="{ThemeResource Text2Brush}" />
        </Grid>

        <TextBlock x:Name="EmptyFolderText"
                   Text="No folder chosen yet."
                   Style="{StaticResource ShellMetaTextStyle}"
                   Margin="12,0,12,10" />

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    Padding="10"
                    Background="{StaticResource PanelHeaderBrush}"
                    BorderBrush="{ThemeResource HairlineStrongBrush}"
                    BorderThickness="0,1,0,0">
            <Button x:Name="PickButton"
                    Style="{StaticResource ShellSecondaryButtonStyle}"
                    Content="Choose folder…"
                    Click="OnPickClicked"
                    ToolTipService.ToolTip="Choose a folder for FileID to scan (Ctrl+O)"
                    AutomationProperties.Name="Choose folder"
                    AutomationProperties.HelpText="Choose a folder for FileID to scan (Ctrl+O)" />
            <Button x:Name="RescanButton"
                    Style="{StaticResource ShellSecondaryButtonStyle}"
                    Click="OnRescanClicked"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Look for new or changed files in this folder (Ctrl+R). Files already read are skipped.">
                <TextBlock x:Name="RescanText"
                           Text="Rescan"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis" />
            </Button>
        </StackPanel>

        <Grid x:Name="ActionsPanel"
              Visibility="Collapsed"
              Padding="10,8,10,8"
              BorderBrush="{ThemeResource HairlineSoftBrush}"
              BorderThickness="0,1,0,0">
            <Button Style="{StaticResource ShellGhostButtonStyle}"
                    Content="Close folder"
                    Click="OnClearClicked"
                    HorizontalAlignment="Left"
                    ToolTipService.ToolTip="Stop working on this folder. What FileID learned is kept, and your files are not changed."
                    AutomationProperties.Name="Close folder" />
            <Button Style="{StaticResource ShellGhostButtonStyle}"
                    Content="Start over…"
                    Foreground="{StaticResource DangerBrush}"
                    Click="OnWipeClicked"
                    HorizontalAlignment="Right"
                    ToolTipService.ToolTip="Forget everything FileID learned and start from a clean slate. Your files and downloaded models are not changed."
                    AutomationProperties.Name="Start over"
                    AutomationProperties.HelpText="Forget everything FileID learned and start from a clean slate. Your files and downloaded models are not changed." />
        </Grid>
    </StackPanel>
</UserControl>

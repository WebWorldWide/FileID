<?xml version="1.0" encoding="utf-8"?>
<!--
    SidebarTabList — Prototype v3 area sidebar. Browse / Analyze / Act
    segmented switcher at the top (gold pill, spring-animated), then the
    pages of the shown area as 32 px rows with icon, 13.5 px label and a
    quiet trailing badge only when it says something. The selected row is a
    radius-m gold tint. 1:1 port of macOS Sidebar.swift.

    Pages that need a library stay disabled until a folder is picked.
    Ctrl+1..9 / Alt+1..9 (MainWindow) jump to pages; shortcuts live in the
    tooltips.
-->
<UserControl
    x:Class="FileID.Views.Sidebar.SidebarTabList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="10">
        <Grid Margin="10,0,10,0"
              Padding="3"
              Background="{StaticResource ShellControlFillBrush}"
              BorderBrush="{StaticResource HairlineStrongBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource CornerRadiusM}">
            <Grid x:Name="AreaTrack" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="AreaPill"
                        Grid.Column="0"
                        Height="26"
                        CornerRadius="{StaticResource CornerRadiusS}"
                        Background="{StaticResource GoldBrush}"
                        IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <StackPanel x:Name="ButtonsHost" Spacing="2" Padding="8,0,8,0" />
    </StackPanel>
</UserControl>

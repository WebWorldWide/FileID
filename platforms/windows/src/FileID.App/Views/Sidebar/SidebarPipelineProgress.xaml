<?xml version="1.0" encoding="utf-8"?>
<!--
    SidebarPipelineProgress — the scan card's five-step indicator
    (Prototype v3): Scan → Tag → Faces → Captions → Done as five 3 px
    capsule segments plus "Step N of 5 · Stage". Finished steps are muted,
    the current step takes the stage colour (gold, lavender while captions
    run, pink when done). 1:1 port of the macOS PipelineBlock step strip.
-->
<UserControl
    x:Class="FileID.Views.Sidebar.SidebarPipelineProgress"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="6">
        <Grid x:Name="StagesRow" Height="3" ColumnSpacing="4" />
        <TextBlock x:Name="StepText"
                   Text="Step 1 of 5 · Scan"
                   FontFamily="{StaticResource BodyFontFamily}"
                   FontSize="12"
                   Foreground="{StaticResource Text2Brush}"
                   Margin="0,0,24,0"
                   TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>

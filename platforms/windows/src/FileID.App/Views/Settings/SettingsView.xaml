<?xml version="1.0" encoding="utf-8"?>
<!--
    SettingsView — model install cards and catalog, engine controls, GPU
    override, advanced diagnostics, appearance, organize/cleanup options,
    locations, storage paths, recent scans and about.
-->
<UserControl
    x:Class="FileID.Views.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:FileID.Views.Settings"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <!-- Centered so the 820-MaxWidth content doesn't pin to the leading edge on wide windows. -->
        <StackPanel Padding="32,32,32,32" Spacing="20" MaxWidth="820" HorizontalAlignment="Center">

            <StackPanel Spacing="4">
                <TextBlock Text="Models, GPU acceleration, storage."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Models card: install and progress per model kind. -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Local AI" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="AI models that run on this PC. Each downloads once."/>

                    <!-- ArcFace. x:Binds against Svc.Arcface so the card follows installs started from any sheet or window. -->
                    <Grid ColumnSpacing="12" Padding="14,12" CornerRadius="10"
                          Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Faces"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Recognizes the same person across your photos so People can group them. Model: YuNet + SFace (Apache-2.0), runs on this PC."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar Maximum="1"
                                         Value="{x:Bind Svc.Arcface.Fraction, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind IsStarting(Svc.Arcface.Status, Svc.Arcface.HasStarted), Mode=OneWay}"
                                         Foreground="{StaticResource GoldBrush}"
                                         Visibility="{x:Bind VisibleIfDownloading(Svc.Arcface.Status), Mode=OneWay}"
                                         Margin="0,4,0,0"
                                         Height="4"/>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="11"
                                       Text="{x:Bind ProgressLabel(Svc.Arcface.Message, Svc.Arcface.Fraction, Svc.Arcface.BytesDone, Svc.Arcface.TotalBytes), Mode=OneWay}"
                                       Visibility="{x:Bind VisibleIfDownloading(Svc.Arcface.Status), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="11"
                                       Text="{x:Bind RateEtaLabel(Svc.Arcface.BytesPerSecond, Svc.Arcface.EtaSeconds), Mode=OneWay}"
                                       Visibility="{x:Bind ShowRateEta(Svc.Arcface.Status, Svc.Arcface.HasStarted), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ErrorLabel(Svc.Arcface.LastError), Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="{x:Bind VisibleIfFailed(Svc.Arcface.Status), Mode=OneWay}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="~39 MB"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="✓ Ready"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind VisibleIfInstalled(Svc.Arcface.Status), Mode=OneWay}"/>
                            <Button Content="{x:Bind ButtonLabel(Svc.Arcface.Status), Mode=OneWay}"
                                    Tag="arcface_buffalo"
                                    Click="OnInstallModelClicked"
                                    MinWidth="86"
                                    Visibility="{x:Bind ShowActionButton(Svc.Arcface.Status), Mode=OneWay}"
                                    AutomationProperties.Name="Download the Faces model"/>
                        </Grid>
                    </Grid>

                    <!-- CLIP ViT-B/32: free-text image search and scan-time scene tagging. -->
                    <Grid ColumnSpacing="12" Padding="14,12" CornerRadius="10"
                          Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Search by description"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Lets you search photos by what's in them, like &quot;sunset at the beach&quot;. Model: OpenCLIP ViT-B/32 (MIT), runs on this PC."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar Maximum="1"
                                         Value="{x:Bind Svc.Clip.Fraction, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind IsStarting(Svc.Clip.Status, Svc.Clip.HasStarted), Mode=OneWay}"
                                         Foreground="{StaticResource GoldBrush}"
                                         Visibility="{x:Bind VisibleIfDownloading(Svc.Clip.Status), Mode=OneWay}"
                                         Margin="0,4,0,0"
                                         Height="4"/>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="11"
                                       Text="{x:Bind ProgressLabel(Svc.Clip.Message, Svc.Clip.Fraction, Svc.Clip.BytesDone, Svc.Clip.TotalBytes), Mode=OneWay}"
                                       Visibility="{x:Bind VisibleIfDownloading(Svc.Clip.Status), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="11"
                                       Text="{x:Bind RateEtaLabel(Svc.Clip.BytesPerSecond, Svc.Clip.EtaSeconds), Mode=OneWay}"
                                       Visibility="{x:Bind ShowRateEta(Svc.Clip.Status, Svc.Clip.HasStarted), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ErrorLabel(Svc.Clip.LastError), Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="{x:Bind VisibleIfFailed(Svc.Clip.Status), Mode=OneWay}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="~220 MB"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="✓ Ready"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind VisibleIfInstalled(Svc.Clip.Status), Mode=OneWay}"/>
                            <Button Content="{x:Bind ButtonLabel(Svc.Clip.Status), Mode=OneWay}"
                                    Tag="mobileclip_s2"
                                    Click="OnInstallModelClicked"
                                    MinWidth="86"
                                    Visibility="{x:Bind ShowActionButton(Svc.Clip.Status), Mode=OneWay}"
                                    AutomationProperties.Name="Download the Search by description model"/>
                        </Grid>
                    </Grid>

                    <!-- RAM++ auto-tagger: the primary in-scan tagger; binds to Svc.RamPlus. -->
                    <Grid ColumnSpacing="12" Padding="14,12" CornerRadius="10"
                          Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Photo tags"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Labels what's in each photo (thousands of everyday things) so you can search and sort by it. Model: RAM++ (Apache-2.0)."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar Maximum="1"
                                         Value="{x:Bind Svc.RamPlus.Fraction, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind IsStarting(Svc.RamPlus.Status, Svc.RamPlus.HasStarted), Mode=OneWay}"
                                         Foreground="{StaticResource GoldBrush}"
                                         Visibility="{x:Bind VisibleIfDownloading(Svc.RamPlus.Status), Mode=OneWay}"
                                         Margin="0,4,0,0"
                                         Height="4"/>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="11"
                                       Text="{x:Bind ProgressLabel(Svc.RamPlus.Message, Svc.RamPlus.Fraction, Svc.RamPlus.BytesDone, Svc.RamPlus.TotalBytes), Mode=OneWay}"
                                       Visibility="{x:Bind VisibleIfDownloading(Svc.RamPlus.Status), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="11"
                                       Text="{x:Bind RateEtaLabel(Svc.RamPlus.BytesPerSecond, Svc.RamPlus.EtaSeconds), Mode=OneWay}"
                                       Visibility="{x:Bind ShowRateEta(Svc.RamPlus.Status, Svc.RamPlus.HasStarted), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ErrorLabel(Svc.RamPlus.LastError), Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="{x:Bind VisibleIfFailed(Svc.RamPlus.Status), Mode=OneWay}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="~882 MB"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="✓ Ready"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind VisibleIfInstalled(Svc.RamPlus.Status), Mode=OneWay}"/>
                            <Button Content="{x:Bind ButtonLabel(Svc.RamPlus.Status), Mode=OneWay}"
                                    Tag="ram_plus"
                                    Click="OnInstallModelClicked"
                                    MinWidth="86"
                                    Visibility="{x:Bind ShowActionButton(Svc.RamPlus.Status), Mode=OneWay}"
                                    AutomationProperties.Name="Download the Photo tags model"/>
                        </Grid>
                    </Grid>

                    <!-- Face Mesh: opt-in eye-openness model for Best Takes. -->
                    <Grid ColumnSpacing="12" Padding="14,12" CornerRadius="10"
                          Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Eye check · optional"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Improves closed-eye detection in Best Takes. Model: Face Mesh, 4.9 MB, Apache-2.0."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar Maximum="1"
                                         Value="{x:Bind Svc.FaceMesh.Fraction, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind IsStarting(Svc.FaceMesh.Status, Svc.FaceMesh.HasStarted), Mode=OneWay}"
                                         Foreground="{StaticResource GoldBrush}"
                                         Visibility="{x:Bind VisibleIfDownloading(Svc.FaceMesh.Status), Mode=OneWay}"
                                         Margin="0,4,0,0"
                                         Height="4"/>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="11"
                                       Text="{x:Bind ProgressLabel(Svc.FaceMesh.Message, Svc.FaceMesh.Fraction, Svc.FaceMesh.BytesDone, Svc.FaceMesh.TotalBytes), Mode=OneWay}"
                                       Visibility="{x:Bind VisibleIfDownloading(Svc.FaceMesh.Status), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="11"
                                       Text="{x:Bind RateEtaLabel(Svc.FaceMesh.BytesPerSecond, Svc.FaceMesh.EtaSeconds), Mode=OneWay}"
                                       Visibility="{x:Bind ShowRateEta(Svc.FaceMesh.Status, Svc.FaceMesh.HasStarted), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ErrorLabel(Svc.FaceMesh.LastError), Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="{x:Bind VisibleIfFailed(Svc.FaceMesh.Status), Mode=OneWay}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="~4.9 MB"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="✓ Ready"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind VisibleIfInstalled(Svc.FaceMesh.Status), Mode=OneWay}"/>
                            <Button Content="{x:Bind ButtonLabel(Svc.FaceMesh.Status), Mode=OneWay}"
                                    Tag="face_mesh"
                                    Click="OnInstallModelClicked"
                                    MinWidth="86"
                                    Visibility="{x:Bind ShowActionButton(Svc.FaceMesh.Status), Mode=OneWay}"
                                    AutomationProperties.Name="Download the Eye check model"/>
                        </Grid>
                    </Grid>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               Text="The optional Descriptions models (Qwen 2.5-VL · Qwen3-VL 4B/8B · Gemma 3 · Mistral-Small 3.2) are on the Describe Files page, which can also browse every catalog model that fits this PC."/>
                </StackPanel>
            </Border>

            <!-- Model catalog: every curated and pinned catalog model for this
                 PC, filtered by memory, with download and benchmarks. -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <settings:ModelCatalogCard />
            </Border>

            <!-- Engine info. -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Engine" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="{x:Bind EngineVersionText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind WorkerCapText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Open log folder" Click="OnOpenLogsClicked" />
                        <!-- Always-available engine lifecycle controls. -->
                        <Button x:Name="RestartEngineCardButton"
                                Content="Restart engine"
                                Click="OnRestartEngineCardClicked"
                                ToolTipService.ToolTip="Restart FileID's background helper. Stops any scan in progress." />
                        <Button x:Name="StopEngineCardButton"
                                Content="Stop engine"
                                Click="OnStopEngineCardClicked"
                                ToolTipService.ToolTip="Stop FileID's background helper." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Performance — detected hardware + Describe Files GPU override. -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Performance" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <!-- Detected GPU + adapter name. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Detected GPU"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />
                        <TextBlock Text="{x:Bind GpuSummaryText, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Active execution provider. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Scan inference"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />
                        <TextBlock Text="{x:Bind ExecutionProviderText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Contextual recommendation banner — gold-tinted when present. -->
                    <Border Padding="14,10"
                            CornerRadius="10"
                            Background="{ThemeResource GoldSelectedBackgroundBrush}"
                            BorderBrush="{ThemeResource GoldSelectedStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind RecommendationVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE945;"
                                      FontSize="14"
                                      Foreground="{ThemeResource GoldBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0" />
                            <TextBlock Text="{x:Bind RecommendationText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Manual override for the llama.cpp GPU use. Auto-detect is the default. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="GPU use"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />
                        <ComboBox x:Name="ProviderCombo"
                                  Width="240"
                                  SelectedIndex="0"
                                  SelectionChanged="OnProviderOverrideChanged"
                                  AutomationProperties.Name="GPU use for Describe Files and Chat"
                                  AutomationProperties.HelpText="Persisted across launches. Takes effect the next time Describe Files starts.">
                            <ComboBoxItem Content="Auto-detect (recommended)" Tag="auto"/>
                            <ComboBoxItem Content="CPU only" Tag="cpu"/>
                        </ComboBox>
                        <TextBlock x:Name="OverrideHelpText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Applies to Describe Files and Chat. Scanning always runs on the CPU. Persisted across launches; takes effect the next time Describe Files starts." />
                    </StackPanel>

                    <!-- NVIDIA controls for the optional CUDA llama.cpp runtime. -->
                    <StackPanel x:Name="NvidiaAccelerationSection"
                                Visibility="Collapsed"
                                Spacing="10">
                        <TextBlock Text="NVIDIA acceleration"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="CUDA is optional and used only by Describe Files and Chat. Scanning runs on the CPU. FileID does not download vendor runtimes." />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="CUDA for Describe Files"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="CudaLlamaStatusText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="Optional locally installed CUDA llama.cpp runtime. Describe Files prefers it on NVIDIA GPUs; Vulkan remains available as fallback."/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="InstallCudaLlamaButton"
                                    Content="Setup steps"
                                    Click="OnInstallCudaLlamaClicked"
                                    AutomationProperties.Name="Show CUDA runtime setup for Describe Files"
                                    ToolTipService.ToolTip="Shows the local CUDA runtime directory; FileID does not download vendor runtimes." />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Advanced: read-only hardware diagnostics and the force-retag and thumbnail-cache actions, collapsed by default. -->
            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      CornerRadius="12"
                      Padding="20,8,20,16">
                <Expander.Header>
                    <TextBlock Text="Advanced (troubleshooting: hardware, tags and thumbnails)"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                </Expander.Header>
                <StackPanel Spacing="14">

                    <StackPanel Spacing="6">
                        <TextBlock Text="CPU"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />
                        <TextBlock Text="{x:Bind CpuTopologyText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Memory"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />
                        <TextBlock Text="{x:Bind MemoryDiagnosticsText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="GPU / NPU"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />
                        <TextBlock Text="{x:Bind GpuDiagnosticsText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Power"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />
                        <TextBlock Text="{x:Bind PowerDiagnosticsText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Scene tags"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />
                        <TextBlock Text="{x:Bind SceneTaggingDiagnosticsText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <Button Content="Re-scan everything (force re-tag)"
                                Click="OnForceRetagClicked"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                ToolTipService.ToolTip="Re-scan the current library folder and recompute tags for every file, even ones already scanned. Use after a tagging change to see updated chips without deleting the database." />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Thumbnails"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40" />
                        <TextBlock Text="{x:Bind ThumbnailDiagnosticsText, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <Button Content="Refresh"
                                Click="OnRefreshDiagnosticsClicked"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Refresh diagnostics" />
                    </StackPanel>

                </StackPanel>
            </Expander>

            <!-- Appearance (lava lamp, text size). -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <Grid ColumnSpacing="12" MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Lava lamp" TextWrapping="Wrap" />
                            <TextBlock Text="Wax glows rise behind the panes; the light turns lavender while a model runs. Reduce Motion pauses it."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <RadioButtons x:Name="LavaModeRadios"
                                      Grid.Column="1"
                                      MaxColumns="2"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Lava lamp"
                                      AutomationProperties.HelpText="Wax glows rise behind the panes; the light turns lavender while a model runs. Reduce Motion pauses it."
                                      SelectionChanged="OnLavaModeChanged">
                            <RadioButton Content="Full" Tag="full" />
                            <RadioButton Content="Off" Tag="off" />
                        </RadioButtons>
                    </Grid>

                    <Grid ColumnSpacing="12" MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Text size" TextWrapping="Wrap" />
                            <TextBlock Text="File names, details, descriptions and chat. The title bar and sidebar stay the same size."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <RadioButtons x:Name="TextSizeRadios"
                                      Grid.Column="1"
                                      MaxColumns="4"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Text size"
                                      AutomationProperties.HelpText="Changes the size of text on every page. The title bar and sidebar stay the same size."
                                      SelectionChanged="OnTextSizeChanged">
                            <RadioButton Content="Small" Tag="small" />
                            <RadioButton Content="Default" Tag="standard" />
                            <RadioButton Content="Large" Tag="large" />
                            <RadioButton Content="Larger" Tag="larger" />
                        </RadioButtons>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Organize Folders granularity. -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Organize Folders" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <Grid ColumnSpacing="12" MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Folder granularity"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <RadioButtons x:Name="GranularityRadios"
                                      Grid.Column="1"
                                      MaxColumns="3"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Folder granularity"
                                      SelectionChanged="OnGranularityChanged">
                            <RadioButton Content="Looser" Tag="loose" />
                            <RadioButton Content="Balanced" Tag="normal" />
                            <RadioButton Content="Tighter" Tag="tight" />
                        </RadioButtons>
                    </Grid>
                    <TextBlock Text="How finely Organize Folders splits your files. Looser makes fewer, broader folders; Tighter makes more, smaller ones. Takes effect after you quit and reopen FileID."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Cleanup toggle. -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Duplicates" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <Grid ColumnSpacing="12" MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tag kept files after removing duplicates"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="CleanupAutoTagToggle"
                                      Grid.Column="1"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Tag kept files after removing duplicates"
                                      AutomationProperties.HelpText="After you move extra copies to Trash, the copies you keep get a 'kept' tag."
                                      Toggled="OnCleanupAutoTagToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Locations: scanned folders and drives from listRoots, OFFLINE when unplugged. -->
            <settings:LocationsCard />

            <!-- Storage: where the database, thumbnail cache and model cache live. -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Storage" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Database"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind DbPathText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind DbPathText, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="0" Grid.Column="2"
                                Content="Show"
                                Click="OnShowDbFolderClicked"
                                AutomationProperties.Name="Show database folder in File Explorer" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Thumbnail cache"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{x:Bind ThumbCachePathText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ThumbCachePathText, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="1" Grid.Column="2"
                                Content="Show"
                                Click="OnShowThumbCacheClicked"
                                AutomationProperties.Name="Show thumbnail cache folder in File Explorer" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Models"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{x:Bind ModelsPathText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ModelsPathText, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="2" Grid.Column="2"
                                Content="Show"
                                Click="OnShowModelsFolderClicked"
                                AutomationProperties.Name="Show models folder in File Explorer" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               Text="To uninstall FileID completely, delete the parent FileID folder under %LOCALAPPDATA% after quitting the app." />
                </StackPanel>
            </Border>

            <!-- Recent scans: the 5 newest scan_sessions rows, refreshed whenever the tab opens. -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Recent scans" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock x:Name="RecentScansEmptyText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="No scans yet. Choose a folder to scan from the title bar."
                               Visibility="Visible" />
                    <ItemsControl x:Name="RecentScansList" />
                </StackPanel>
            </Border>

            <!-- About. -->
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                               Text="{x:Bind AppVersionText, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="On-device AI file organizer. No telemetry, no cloud, your files never leave your Mac, PC, or Linux box."/>
                    <HyperlinkButton Content="View privacy notice"
                                     Click="OnOpenPrivacyDocClicked"
                                     Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

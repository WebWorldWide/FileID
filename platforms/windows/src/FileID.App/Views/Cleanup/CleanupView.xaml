<?xml version="1.0" encoding="utf-8"?>
<!--
    CleanupView — duplicate-group list with keeper selection.

-->
<UserControl
    x:Class="FileID.Views.Cleanup.CleanupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FileID.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,32,32,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Each group is the same file saved more than once, checked byte by byte. FileID marks one copy KEEP; the other copies go to the Recycle Bin when you press Move to Recycle Bin. You can put files back from the Recycle Bin."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <!-- Live stats — "N groups • M files non-keepers • S reclaimable".
                     Mirrors macOS CleanupView's header counter so the user
                     can see what Trash non-keepers is about to do before
                     they click. Updates whenever a keeper radio flips. -->
                <TextBlock x:Name="HeaderStatsText"
                           Text="{x:Bind HeaderStats, Mode=OneWay}"
                           AutomationProperties.Name="{x:Bind HeaderStats, Mode=OneWay}"
                           AutomationProperties.HelpText="Duplicate cleanup summary"
                           FontSize="12"
                           Foreground="{ThemeResource GoldBrush}" />
                <TextBlock x:Name="TrashResultText"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           ToolTipService.ToolTip="To undo, open the Recycle Bin, right-click a file and choose Restore." />
            </StackPanel>
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="OnResetKeepersClicked"
                            AutomationProperties.Name="Select all extra copies"
                            AutomationProperties.HelpText="Choose every copy except the one marked KEEP in each group"
                            ToolTipService.ToolTip="Choose every copy except the one marked KEEP in each group">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontSize="13" Glyph="&#xE762;" />
                            <TextBlock Text="Select all extra copies" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnTrashNonKeepersClicked"
                            IsEnabled="{x:Bind DeleteButtonEnabled, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind DeleteButtonText, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind DeleteButtonTip, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind DeleteButtonTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontSize="13" Glyph="&#xE74D;" />
                            <TextBlock Text="{x:Bind DeleteButtonText, Mode=OneWay}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnRefreshClicked"
                            AutomationProperties.Name="Check again"
                            AutomationProperties.HelpText="Look for extra copies again in the files FileID has scanned"
                            ToolTipService.ToolTip="Look for extra copies again in the files FileID has scanned">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontSize="13" Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="8"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateGroup">
                        <Grid CornerRadius="12"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              Padding="16"
                              Tag="{x:Bind ContentHash}"
                              AutomationProperties.Name="{x:Bind Caption, Mode=OneWay}"
                              AutomationProperties.HelpText="Copies of the same file. Right-click to choose which copy to keep or to skip the group.">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="OnGroupFlyoutOpening">
                                    <MenuFlyoutItem Text="Keep the first copy"
                                                    Click="OnGroupKeepFirst"
                                                    ToolTipService.ToolTip="Mark the first copy KEEP">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE73E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Keep the copy nearest the top"
                                                    Click="OnGroupKeepShallowest"
                                                    ToolTipService.ToolTip="Mark KEEP on the copy in the fewest nested folders">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8AB;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Keep the next copy"
                                                    Click="OnGroupInvert"
                                                    ToolTipService.ToolTip="Move KEEP to the next copy">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Skip group"
                                                    Click="OnGroupSkip"
                                                    ToolTipService.ToolTip="Hide this group if these aren't really copies. Nothing is deleted.">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE894;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Show group again"
                                                    Click="OnGroupUnskip"
                                                    ToolTipService.ToolTip="Include this group in Move to Recycle Bin again">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE73E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Move this group's extra copies to Recycle Bin"
                                                    Click="OnGroupTrashNow"
                                                    ToolTipService.ToolTip="Move every copy in this group except KEEP to the Recycle Bin">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Caption, Mode=OneWay}"
                                           AutomationProperties.HeadingLevel="Level2"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <!-- Horizontal strip of thumbnail tiles (macOS CopyTile
                                     parity). Thumbnails load lazily via the members
                                     repeater's ElementPrepared (like LibraryView). -->
                                <ScrollViewer HorizontalScrollMode="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsRepeater ItemsSource="{x:Bind Members}"
                                                   ElementPrepared="OnMemberPrepared"
                                                   ElementClearing="OnMemberClearing">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="10"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DuplicateMember">
                                                <StackPanel Width="140" Spacing="4" Padding="2"
                                                            AutomationProperties.Name="{x:Bind FileName}"
                                                            AutomationProperties.HelpText="{x:Bind Path}">
                                                    <!-- Border clips the UniformToFill image to rounded corners. -->
                                                    <Border Width="132" Height="132"
                                                            CornerRadius="8"
                                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xEB9F;" FontSize="28"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}" />
                                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                                   Stretch="UniformToFill" />
                                                            <Border Style="{StaticResource ImageBadgeStyle}"
                                                                    BorderBrush="{StaticResource ImageBadgeGoldStrokeBrush}"
                                                                    Margin="6"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Visibility="{x:Bind IsKeeper, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="KEEP"
                                                                           ToolTipService.ToolTip="FileID suggests keeping this copy. The others are copies of it."
                                                                           FontFamily="{StaticResource BodyFontFamily}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           CharacterSpacing="40"
                                                                           Foreground="{StaticResource GoldBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind FileName}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1"
                                                               TextAlignment="Center"
                                                               Width="132"
                                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                                    <TextBlock Text="{x:Bind SizeDisplay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               HorizontalAlignment="Center" />
                                                    <RadioButton GroupName="{x:Bind GroupKey, Mode=OneTime}"
                                                                 IsChecked="{x:Bind IsKeeper, Mode=TwoWay}"
                                                                 Content="Keep"
                                                                 AutomationProperties.Name="{x:Bind FileName}"
                                                                 AutomationProperties.HelpText="Keep this copy. The other copies in the group go to the Recycle Bin."
                                                                 HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind FooterVisibility, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          AutomationProperties.Name="Looking for extra copies"
                          Width="16" Height="16"/>
            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                       AutomationProperties.Name="{x:Bind StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>

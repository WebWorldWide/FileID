<?xml version="1.0" encoding="utf-8"?>
<!--
    PersonDetailSheet — modal showing every face in a cluster + a
    structured-name editor (title / first / middle / last / suffix).
    Save fires renamePerson IPC; deletes are deferred (split is a
    People-tab gesture, not a sheet action).
-->
<UserControl
    x:Class="FileID.Views.People.PersonDetailSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FileID.Views.People"
    mc:Ignorable="d"
    MinWidth="640"
    MinHeight="440">

    <Grid RowSpacing="14" Padding="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock x:Name="HeaderText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1"
                       Text="Person details" />
            <TextBlock x:Name="MemberCountText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" x:Name="NameFieldsPanel" ColumnSpacing="10" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Row="0" Grid.Column="0" x:Name="TitleBox"  Header="Title"   PlaceholderText="Dr." />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="FirstBox"  Header="First"   />
            <TextBox Grid.Row="0" Grid.Column="2" x:Name="MiddleBox" Header="Middle"  />
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="LastBox"   Header="Last"    />
            <TextBox Grid.Row="0" Grid.Column="4" x:Name="SuffixBox" Header="Suffix"  PlaceholderText="Jr." />
            <CheckBox Grid.Row="1"
                      Grid.ColumnSpan="5"
                      x:Name="IsUnknownCheckBox"
                      Content="I don't know who this is"
                      AutomationProperties.HelpText="Hides this person and leaves them out of descriptions. Their photos stay in the library." />
        </Grid>

        <StackPanel Grid.Row="2" x:Name="MoveToolbar" Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="SelectedCountText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
            <Button x:Name="MoveButton"
                    Content="Move to another person…"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Visibility="Collapsed"
                    Click="OnMoveClicked" />
            <Button x:Name="SelectModeButton"
                    Content="Select photos"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Move photos that show someone else to the right person"
                    Click="OnSelectModeClicked" />
            <Button x:Name="CancelSelectButton"
                    Content="Cancel"
                    Visibility="Collapsed"
                    Click="OnCancelSelectClicked" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <ItemsRepeater x:Name="FaceGrid">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="100"
                                       MinItemHeight="100"
                                       MinRowSpacing="8"
                                       MinColumnSpacing="8"
                                       ItemsStretch="Uniform" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <local:FaceReviewPanel Grid.Row="4"
                               x:Name="ReviewPanel"
                               MaxHeight="320"
                               Visibility="Collapsed" />

        <TextBlock Grid.Row="5"
                   x:Name="StatusText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>

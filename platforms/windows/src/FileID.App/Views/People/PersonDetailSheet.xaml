<?xml version="1.0" encoding="utf-8"?>
<!--
    PersonDetailSheet — modal showing every face in a cluster + a
    structured-name editor (title / first / middle / last / suffix).
    Save fires renamePerson IPC; deletes are deferred (split is a
    People-tab gesture, not a sheet action).
-->
<UserControl
    x:Class="FileID.Views.People.PersonDetailSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="640"
    MinHeight="440">

    <Grid RowSpacing="14" Padding="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock x:Name="HeaderText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1"
                       Text="Person details" />
            <TextBlock x:Name="MemberCountText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <CheckBox x:Name="IsUnknownCheckBox"
                      Checked="OnUnknownChecked"
                      Unchecked="OnUnknownUnchecked"
                      Content="I don't know who this is"
                      ToolTipService.ToolTip="Excludes this person from AI clustering and Deep Analyze captions."
                      AutomationProperties.Name="I don't know who this is"
                      AutomationProperties.HelpText="Excludes this person from AI clustering and Deep Analyze captions." />
        </StackPanel>

        <Grid x:Name="NameFieldsPanel" Grid.Row="1" ColumnSpacing="10" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Row="0" Grid.Column="0" x:Name="TitleBox" Header="Title" PlaceholderText="Uncle, Grandma…" TextChanged="OnNameFieldChanged" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="FirstBox" Header="First name" PlaceholderText="optional" TextChanged="OnNameFieldChanged" />
            <TextBox Grid.Row="0" Grid.Column="2" x:Name="MiddleBox" Header="Middle" PlaceholderText="optional" TextChanged="OnNameFieldChanged" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="LastBox" Header="Last name" PlaceholderText="optional" TextChanged="OnNameFieldChanged" />
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="SuffixBox" Header="Suffix" PlaceholderText="Jr, III…" TextChanged="OnNameFieldChanged" />
        </Grid>

        <StackPanel x:Name="TagPersonPanel" Grid.Row="2" Spacing="4" Visibility="Collapsed">
            <Button x:Name="TagAllPhotosButton"
                    Click="OnTagAllPhotosClicked"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="Tag all photos with this person's name">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8EC;" FontSize="13" />
                    <TextBlock x:Name="TagAllPhotosButtonText" Text="Tag all photos" />
                    <ProgressRing x:Name="TagAllPhotosProgress" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="ReplacePersonTagButton"
                    Click="OnReplacePersonTagClicked"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Replace the previous person-name tag">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE895;" FontSize="13" />
                    <TextBlock x:Name="ReplacePersonTagButtonText" Text="Replace previous name tag" />
                </StackPanel>
            </Button>
            <TextBlock Text="Adds this person’s full name as a searchable Windows file tag. If the name changes later, Replace removes only the old person-name tag; unrelated tags stay untouched."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="TagAllPhotosStatus"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="Right-click any face crop to remove it from this person, split it into a new cluster, or move it to another person."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,6" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <ItemsRepeater x:Name="FaceGrid">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="108"
                                           MinItemHeight="108"
                                           MinRowSpacing="8"
                                           MinColumnSpacing="8"
                                           ItemsStretch="Uniform" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>

<?xml version="1.0" encoding="UTF-8"?>
<!--
    FileID MSI definition.

    Per-machine install under Program Files. No per-user install (which
    would land under %LOCALAPPDATA% and split user data from app code —
    we keep `%LOCALAPPDATA%\FileID\` for runtime data only: DB, models,
    logs, thumbs cache).

    Upgrade behavior: replace older versions cleanly. The Burn bootstrapper
    above will detect a newer bundle and remove the older MSI before
    installing the new one — but as a safety net, MajorUpgrade element
    declares any older version is replaceable in-place.

    Components:
      - PublishedFiles: every file from `dotnet publish` (auto-harvested by
        wixproj's HarvestDirectory). Includes FileID.exe, FileIDEngine.exe
        (staged into publish/ by publish-bundle.ps1), the self-contained .NET
        runtime, Win2D, etc. The framework-dependent Windows App Runtime is a
        prerequisite in the Burn bundle, not duplicated inside this MSI.
      - StartMenuShortcut: one shortcut under "FileID".

    Properties:
      - Native maintenance mode remains available for repair/uninstall.
      - ARPHELPLINK / ARPURLINFOABOUT: documented in MODELS.md / PRIVACY.md.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="FileID"
      Manufacturer="FileID"
      Version="$(var.Version)"
      UpgradeCode="$(var.UpgradeCode)"
      InstallerVersion="500"
      Compressed="yes"
      Scope="perMachine">

    <!-- Single .cab, embedded in the .msi so the artifact is one file. -->
    <Media Id="1" Cabinet="FileID.cab" EmbedCab="yes" />

    <!-- Replace older versions and the same-version package of the other
         architecture. Removal runs after InstallInitialize, before new files
         are laid down: x64 and ARM64 intentionally use different component
         GUIDs, so removing the old product after copying the new one could
         otherwise delete paths the new architecture just installed. This
         schedule remains inside the rollback boundary.

         A single MSI's install is already an atomic Windows Installer
         transaction (it rolls back wholesale on failure), so there is no
         MSI-level RollbackBoundary here — that element is a Burn <Chain>
         construct. The chain-level RollbackBoundary lives in
         ../FileID.Bundle/Bundle.wxs so a failure installing one packaged
         MSI doesn't unwind packages that already committed past the
         checkpoint. -->
    <MajorUpgrade
        Schedule="afterInstallInitialize"
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of FileID is already installed." />

    <!-- Per-machine install with arch-aware Program Files target. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FileID" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="FileID" />
    </StandardDirectory>

    <!-- Apps & Features metadata. -->
    <Property Id="ARPPRODUCTICON" Value="FileIDIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/WebWorldWide/FileID/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://fileid.app" />
    <!-- Privacy posture is a product feature; surface it in Apps & Features. -->
    <Property Id="ARPCOMMENTS" Value="On-device AI file organizer. No telemetry. No cloud." />

    <!-- V14.7.3: Icon used everywhere ARPPRODUCTICON references it.
         References the source .ico directly (not extracted from .exe)
         so Add/Remove Programs gets the multi-resolution version. -->
    <Icon Id="FileIDIcon" SourceFile="$(var.AssetsRoot)\FileID.ico" />

    <!-- The EXE bundle is the canonical consumer installer; the MSI remains a
         polished standalone option for IT admins and direct double-click use. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.BundleThemeRoot)\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.MsiThemeRoot)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.MsiThemeRoot)\dialog.bmp" />

    <!-- Start Menu shortcut. -->
    <DirectoryRef Id="StartMenuDir">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuLink"
                  Name="FileID"
                  Description="On-device AI file organizer"
                  Target="[INSTALLFOLDER]FileID.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="FileIDIcon" />
        <RemoveFolder Id="RemoveStartMenuDir" Directory="StartMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\FileID\Installed"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Feature: bundles every component above into the only feature the
         installer offers. -->
    <Feature Id="MainFeature" Title="FileID" Level="1" AllowAdvertise="no" Display="expand">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>
</Wix>

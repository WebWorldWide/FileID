<?xml version="1.0" encoding="UTF-8"?>
<!--
    FileIDSetup.exe — single-EXE bootstrapper bundling the Windows App Runtime
    prerequisite plus the x64 + ARM64 FileID MSIs.

    Architecture detection chain:
      - On x64 host (NativeMachine == AMD64 || ProcessorArchitecture == x64) → install FileID-x64.msi
      - On ARM64 host (NativeMachine == ARM64 || ProcessorArchitecture == ARM64) → install FileID-arm64.msi
      - On 32-bit-only host → condition block with an explicit "requires 64-bit Windows" message

    Burn bundles require WixToolset.Bal.wixext (standard bootstrapper app)
    and WixToolset.Util.wixext (registry searches, architecture checks).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle
      Name="FileID"
      Manufacturer="FileID"
      Version="$(var.Version)"
      UpgradeCode="$(var.BundleUpgradeCode)"
      AboutUrl="https://fileid.app"
      HelpUrl="https://fileid.app/help"
      IconSourceFile="$(var.AssetsRoot)\FileID.ico"
      Compressed="yes"
      DisableModify="yes">

    <!-- Native WixStdBA keeps keyboard, high-contrast, screen-reader, repair,
         rollback, and error behavior while the large branded surface mirrors
         FileID's dark/gold app identity. -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          LicenseUrl="license.rtf"
          LogoSideFile="theme\sidebar.png"
          LocalizationFile="theme\FileIDTheme.wxl"
          Theme="hyperlinkSidebarLicense"
          ShowVersion="yes"
          SuppressOptionsUI="yes"
          LaunchTarget="[ProgramFiles64Folder]FileID\FileID.exe"
          LaunchWorkingFolder="[ProgramFiles64Folder]FileID" />
      <Payload Name="license.rtf" SourceFile="theme\license.rtf" Compressed="yes" />
    </BootstrapperApplication>

    <!-- Refuse to install on Win10 < 22H2 (build 19045) or earlier major
         versions (Windows 7 / 8 / 8.1 are unsupported by .NET 8 + WinUI 3).
         VersionNT64 checks for 64-bit OS; VersionNT checks build number. -->
    <bal:Condition Condition="VersionNT64 AND (VersionNT >= v10.0.19045)"
                   Message="FileID requires 64-bit Windows 10 version 22H2 (build 19045) or Windows 11." />

    <!-- Pure-32-bit x86 hosts are unsupported: neither the .NET 8 self-
         contained runtime nor the Rust ONNX/llama engine ship 32-bit x86. -->
    <bal:Condition Condition="VersionNT64 OR NativeMachine = 43620"
                   Message="FileID requires a 64-bit edition of Windows." />

    <!-- An x64-only bundle (-SkipArm64 dev builds) must refuse ARM64 hosts:
         with no arm64 packages in the chain, every InstallCondition below is
         false on ARM64 and Burn would register a "successful" install with
         nothing on disk (the v0.0.1 x64-only asset had this shape). -->
    <?if $(var.IncludeArm64) != true ?>
    <bal:Condition Condition="NOT (NativeMachine = 43620)"
                   Message="This installer contains only the x64 build of FileID. Please download the ARM64 installer for this PC." />
    <?endif?>

    <Chain>
      <!-- Rollback boundary: the shared Windows App Runtime is permanent, while
           each FileID MSI remains its own atomic Windows Installer transaction. -->
      <RollbackBoundary Id="InstallStart" Vital="yes" Transaction="no" />

      <!-- Microsoft's runtime installer is idempotent. Always running it heals
           partially removed MSIX framework packages; Permanent keeps FileID
           uninstall from removing this shared machine prerequisite. -->
      <ExePackage
          Id="WindowsAppRuntimeX64"
          DisplayName="Windows App Runtime 1.7"
          SourceFile="$(var.WinAppRuntimeX64Path)"
          InstallArguments="--quiet"
          DetectCondition="0"
          Permanent="yes"
          Vital="yes"
          PerMachine="yes"
          InstallCondition="NativeMachine = 34404" />

      <?if $(var.IncludeArm64) = true ?>
      <ExePackage
          Id="WindowsAppRuntimeArm64"
          DisplayName="Windows App Runtime 1.7"
          SourceFile="$(var.WinAppRuntimeArm64Path)"
          InstallArguments="--quiet"
          DetectCondition="0"
          Permanent="yes"
          Vital="yes"
          PerMachine="yes"
          InstallCondition="NativeMachine = 43620" />
      <?endif?>

      <MsiPackage
          Id="FileIDx64"
          SourceFile="$(var.MsiX64Path)"
          Compressed="yes"
          Visible="no"
          InstallCondition="NativeMachine = 34404" />

      <?if $(var.IncludeArm64) = true ?>
      <MsiPackage
          Id="FileIDArm64"
          SourceFile="$(var.MsiArm64Path)"
          Compressed="yes"
          Visible="no"
          InstallCondition="NativeMachine = 43620" />
      <?endif?>
    </Chain>
  </Bundle>
</Wix>

[
  {
    "name": "health-probe-echoes-nonce-and-pid",
    "description": "healthCheck echoes valid nonces with the engine PID, rejects malformed ones with a fixed message and no path, keeps the command channel responsive and exits 0 on shutdown.",
    "steps": [
      {"label": "short nonce", "command": {"healthCheck": {"requestID": "probe-1"}}, "await": "healthCheckResult", "expect": {"$tol": "exact", "value": {"requestID": "probe-1", "pid": "{pid}"}}},
      {"label": "mixed nonce", "command": {"healthCheck": {"requestID": "GEN_4-probe_2"}}, "await": "healthCheckResult", "expect": {"$tol": "exact", "value": {"requestID": "GEN_4-probe_2", "pid": "{pid}"}}},
      {"label": "128-char nonce", "command": {"healthCheck": {"requestID": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}, "await": "healthCheckResult", "expect": {"pid": "{pid}"}},
      {"label": "empty nonce", "command": {"healthCheck": {"requestID": ""}}, "await": "error", "filter": {"kind": "invalid_health_request"}, "expect": {"message": "Health request ID must contain 1–128 ASCII letters, digits, underscores or hyphens.", "path": null}},
      {"label": "space nonce", "command": {"healthCheck": {"requestID": " "}}, "await": "error", "filter": {"kind": "invalid_health_request"}},
      {"label": "path nonce", "command": {"healthCheck": {"requestID": "../file"}}, "await": "error", "filter": {"kind": "invalid_health_request"}, "expect": {"path": null}},
      {"label": "newline nonce", "command": {"healthCheck": {"requestID": "line\nfeed"}}, "await": "error", "filter": {"kind": "invalid_health_request"}},
      {"label": "non-ASCII nonce", "command": {"healthCheck": {"requestID": "é"}}, "await": "error", "filter": {"kind": "invalid_health_request"}},
      {"label": "NUL nonce", "command": {"healthCheck": {"requestID": "a\u0000b"}}, "await": "error", "filter": {"kind": "invalid_health_request"}},
      {"label": "129-char nonce", "command": {"healthCheck": {"requestID": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}, "await": "error", "filter": {"kind": "invalid_health_request"}},
      {"label": "after invalid", "command": {"healthCheck": {"requestID": "after-invalid"}}, "await": "healthCheckResult", "expect": {"$tol": "exact", "value": {"requestID": "after-invalid", "pid": "{pid}"}}},
      {"label": "shutdown", "shutdown": {"exitCode": 0}}
    ]
  }
]

    "steps": [
      {
        "label": "plan",
        "save": "plan",
        "command": {
          "planRestructure": {
            "libraryRoot": "{root}"
          }
        },
        "await": "restructurePlan",
        "timeout": 120,
        "abortOnError": true,
        "expect": {
          "moves": {
            "$tol": "set",
            "value": [
              {
                "fileID": 13,
                "source": "{root}/Re\u0301sume\u0301 Game 9-19-26/Photos/JPEGs/D1.ARW",
                "destination": "{root}/Re\u0301sume\u0301 Game 9-19-26/Photos/RAWs/D1.ARW"
              },
              {
                "fileID": 14,
                "source": "{root}/Re\u0301sume\u0301 Game 9-19-26/Photos/JPEGs/D2.ARW",
                "destination": "{root}/Re\u0301sume\u0301 Game 9-19-26/Photos/RAWs/D2.ARW"
              },
              {
                "fileID": 15,
                "source": "{root}/Re\u0301sume\u0301 Game 9-19-26/Photos/JPEGs/D3.ARW",
                "destination": "{root}/Re\u0301sume\u0301 Game 9-19-26/Photos/RAWs/D3.ARW"
              },
              {
                "fileID": 33,
                "source": "{root}/\u00dcn\u00ef Game 9-20-26/Photos/JPEGs/D1.ARW",
                "destination": "{root}/\u00dcn\u00ef Game 9-20-26/Photos/RAWs/D1.ARW"
              },
              {
                "fileID": 34,
                "source": "{root}/\u00dcn\u00ef Game 9-20-26/Photos/JPEGs/D2.ARW",
                "destination": "{root}/\u00dcn\u00ef Game 9-20-26/Photos/RAWs/D2.ARW"
              },
              {
                "fileID": 35,
                "source": "{root}/\u00dcn\u00ef Game 9-20-26/Photos/JPEGs/D3.ARW",
                "destination": "{root}/\u00dcn\u00ef Game 9-20-26/Photos/RAWs/D3.ARW"
              }
            ]
          }
        }
      },
      {
        "label": "apply",
        "command": {
          "applyRestructure": {
            "libraryRoot": "{root}",
            "moves": {
              "$var": "plan.moves"
            },
            "useSymlinks": false
          }
        },
        "await": "restructureApplyResult",
        "timeout": 120,
        "abortOnError": true,
        "expect": {
          "applied": 6,
          "failed": 0
        }
      },
      {
        "label": "folders keep their spelling after apply",
        "fs": {
          "entries": {
            ".": [
              "\u00dcn\u00ef Game 9-20-26",
              "Re\u0301sume\u0301 Game 9-19-26"
            ],
            "Re\u0301sume\u0301 Game 9-19-26/Photos/RAWs": [
              "D1.ARW",
              "D2.ARW",
              "D3.ARW",
              "K1.ARW",
              "K2.ARW"
            ],
            "\u00dcn\u00ef Game 9-20-26/Photos/RAWs": [
              "D1.ARW",
              "D2.ARW",
              "D3.ARW",
              "K1.ARW",
              "K2.ARW"
            ]
          }
        }
      },
      {
        "label": "catalog paths keep the spelling",
        "db": "SELECT path_text FROM files WHERE id IN (13,33) ORDER BY id",
        "expect": [
          [
            "{root}/Re\u0301sume\u0301 Game 9-19-26/Photos/RAWs/D1.ARW"
          ],
          [
            "{root}/\u00dcn\u00ef Game 9-20-26/Photos/RAWs/D1.ARW"
          ]
        ]
      },
      {
        "label": "rescan after apply",
        "command": {
          "startScan": {
            "rootPath": "{root}"
          }
        },
        "await": "scanComplete",
        "timeout": 180
      },
      {
        "label": "a rescan finds the moved files as the same rows",
        "db": "SELECT count(*), coalesce(sum(failed),0), min(id), max(id) FROM files",
        "expect": [
          [
            16,
            0,
            10,
            37
          ]
        ]
      },
      {
        "label": "undo",
        "command": {
          "undoRestructure": {
            "libraryRoot": "{root}"
          }
        },
        "await": "restructureApplyResult",
        "timeout": 120,
        "abortOnError": true,
        "expect": {
          "applied": 6,
          "failed": 0
        }
      },
      {
        "label": "folders keep their spelling after undo",
        "fs": {
          "entries": {
            ".": [
              "\u00dcn\u00ef Game 9-20-26",
              "Re\u0301sume\u0301 Game 9-19-26"
            ],
            "Re\u0301sume\u0301 Game 9-19-26/Photos/JPEGs": [
              "D1.ARW",
              "D2.ARW",
              "D3.ARW",
              "K1.JPG",
              "K2.JPG",
              "K3.JPG"
            ],
            "\u00dcn\u00ef Game 9-20-26/Photos/JPEGs": [
              "D1.ARW",
              "D2.ARW",
              "D3.ARW",
              "K1.JPG",

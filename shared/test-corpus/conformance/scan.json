[
  {
    "name": "scan-tiny-tree-catalogs-every-file",
    "description": "A scan of a generated tree classifies each kind, catalogs unknown types as other and skips unfinished downloads, records exact sizes, mtimes and SHA-256 content hashes and inode file_refs, applies the per-OS path_hash rule, stores NFC path_search for a decomposed name and fails nothing.",
    "tree": [
      {
        "path": "docs/notes.txt",
        "content": "conformance notes\n",
        "mtime": 1789812000
      },
      {
        "path": "docs/Café menu.txt",
        "content": "decomposed name\n",
        "mtime": 1789812060
      },
      {
        "path": "docs/paper.pdf",
        "generate": "pdf",
        "mtime": 1789812120
      },
      {
        "path": "images/red.png",
        "generate": "png",
        "dimensions": [
          32,
          32
        ],
        "mtime": 1789812180
      },
      {
        "path": "images/UPPER Case.PNG",
        "generate": "png",
        "dimensions": [
          24,
          16
        ],
        "mtime": 1789812240
      },
      {
        "path": "audio/tone.wav",
        "generate": "wav",
        "mtime": 1789812300
      },
      {
        "path": "misc/blob.bin",
        "content": "opaque",
        "size": 4096,
        "mtime": 1789812360
      },
      {
        "path": "misc/movie.mp4.part",
        "content": "partial",
        "mtime": 1789812420
      }
    ],
    "steps": [
      {
        "label": "scan",
        "command": {
          "startScan": {
            "rootPath": "{root}"
          }
        },
        "await": "scanComplete",
        "timeout": 180,
        "abortOnError": true,
        "expect": {
          "totalFiles": 7,
          "processedFiles": 7,
          "failedFiles": 0
        }
      },
      {
        "label": "rows",
        "db": "SELECT path_text,kind,extension,size_bytes,modified_at,failed FROM files ORDER BY path_text",
        "expect": {
          "$tol": "set",
          "value": [
            [
              "{path:audio/tone.wav}",
              "audio",
              "wav",
              "{size:audio/tone.wav}",
              1789812300,
              0
            ],
            [
              "{path:docs/Café menu.txt}",
              "doc",
              "txt",
              16,
              1789812060,
              0
            ],
            [
              "{path:docs/notes.txt}",
              "doc",
              "txt",
              18,
              1789812000,
              0
            ],
            [
              "{path:docs/paper.pdf}",
              "pdf",
              "pdf",
              "{size:docs/paper.pdf}",
              1789812120,
              0
            ],
            [
              "{path:images/UPPER Case.PNG}",
              "image",
              "png",
              "{size:images/UPPER Case.PNG}",
              1789812240,
              0
            ],
            [
              "{path:images/red.png}",
              "image",
              "png",
              "{size:images/red.png}",
              1789812180,
              0
            ],
            [
              "{path:misc/blob.bin}",
              "other",
              "bin",
              4096,
              1789812360,
              0
            ]
          ]
        }
      },
      {
        "label": "path_hash",
        "db": "SELECT path_text,path_hash FROM files",
        "expect": {
          "$tol": "set",
          "value": [
            [
              "{path:audio/tone.wav}",
              "{path_hash:audio/tone.wav}"
            ],
            [
              "{path:docs/Café menu.txt}",
              "{path_hash:docs/Café menu.txt}"
            ],
            [
              "{path:docs/notes.txt}",
              "{path_hash:docs/notes.txt}"
            ],
            [
              "{path:docs/paper.pdf}",
              "{path_hash:docs/paper.pdf}"
            ],
            [
              "{path:images/UPPER Case.PNG}",
              "{path_hash:images/UPPER Case.PNG}"
            ],
            [
              "{path:images/red.png}",
              "{path_hash:images/red.png}"
            ],
            [
              "{path:misc/blob.bin}",
              "{path_hash:misc/blob.bin}"
            ]
          ]
        }
      },
      {
        "label": "path_search",
        "db": "SELECT path_search FROM files WHERE path_text LIKE '%menu.txt'",
        "expect": [
          [
            "{nfc_path:docs/Café menu.txt}"
          ]
        ]
      },
      {
        "label": "content_hash",
        "db": "SELECT path_text,content_hash FROM files",
        "expect": {
          "$tol": "set",
          "value": [
            [
              "{path:audio/tone.wav}",
              "{sha256:audio/tone.wav}"
            ],
            [
              "{path:docs/Café menu.txt}",
              "{sha256:docs/Café menu.txt}"
            ],
            [
              "{path:docs/notes.txt}",
              "{sha256:docs/notes.txt}"
            ],
            [
              "{path:docs/paper.pdf}",
              "{sha256:docs/paper.pdf}"
            ],
            [
              "{path:images/UPPER Case.PNG}",
              "{sha256:images/UPPER Case.PNG}"
            ],
            [
              "{path:images/red.png}",
              "{sha256:images/red.png}"
            ],
            [
              "{path:misc/blob.bin}",
              "{sha256:misc/blob.bin}"
            ]
          ]
        }
      },
      {
        "label": "file_ref",
        "db": "SELECT path_text,file_ref FROM files",
        "expect": {
          "$tol": "set",
          "value": [
            [
              "{path:audio/tone.wav}",
              "{inode:audio/tone.wav}"
            ],
            [
              "{path:docs/Café menu.txt}",
              "{inode:docs/Café menu.txt}"
            ],
            [
              "{path:docs/notes.txt}",
              "{inode:docs/notes.txt}"
            ],
            [
              "{path:docs/paper.pdf}",
              "{inode:docs/paper.pdf}"
            ],
            [
              "{path:images/UPPER Case.PNG}",
              "{inode:images/UPPER Case.PNG}"
            ],
            [
              "{path:images/red.png}",
              "{inode:images/red.png}"
            ],
            [
              "{path:misc/blob.bin}",
              "{inode:misc/blob.bin}"
            ]
          ]
        }
      },
      {
        "label": "rescan is incremental",
        "command": {
          "startScan": {
            "rootPath": "{root}"
          }
        },
        "await": "scanComplete",
        "timeout": 120,
        "abortOnError": true,
        "benignErrors": [
          "rescan_no_changes",
          "deep_analyze_unavailable"
        ],
        "expect": {
          "failedFiles": 0
        }
      },
      {
        "label": "no duplicate rows",
        "db": "SELECT COUNT(*), COUNT(DISTINCT path_hash) FROM files",
        "expect": [
          [
            7,
            7
          ]
        ]
      }
    ]
  },
  {
    "name": "scan-mac-adapters-store-what-the-swift-scan-stores",
    "description": "On the Mac, the Rust engine the app hosts decodes, reads text and tags through the Apple adapters and stores what the Swift engine's scan stores: kinds, auto tags (Vision classifier, Year and camera family, document keywords, kind labels), EXIF camera, GPS and capture time, the CoreGraphics dHash of the working image (camera JPEG and HEIC), OCR text with its source and handwriting flag for a screenshot, a HEIC and an image-only PDF, document text for RTF and text files, zip member names, and no faces. No models are installed and the accurate text tier is not compiled (FILEID_OCR_WARMUP=0), so tags come from Vision and text from the fast tier.",
    "appHosted": true,
    "os": [
      "darwin"
    ],
    "tree": [
      {
        "path": "photos/camera.jpg",
        "copy": "shared/test-corpus/conformance-media/camera.jpg",
        "mtime": 1789812000
      },
      {

OM files ORDER BY id", "expect": [[1, 1], [2, 1]]}, {"label": "people recounted", "db": "SELECT id,file_count,representative_face_id FROM persons ORDER BY id", "expect": [[1, 2, 2], [2, 1, 3]]}]}

     "status": "ok",
     "queue": "splits",
     "total": 1,
     "splits": {
      "$tol": "exact",
      "value": [
       {
        "personID": 5,
        "personName": "Kim",
        "representativeFaceID": 11,
        "score": 0.2134,
        "keepCount": 3,
        "splitCount": 3,
        "keepFaceIDs": [
         11,
         12,
         13
        ],
        "splitFaceIDs": [
         14,
         15,
         16
        ],
        "createdAt": 200
       }
      ]
     }
    }
   },
   {

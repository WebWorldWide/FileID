 {
  "name": "face-refresh-backlog-recovers-and-reports",
  "description": "A faceRefresh job left running comes back paused after a restart; the refresh queue reports the backlog of the job's model and processing by state; enqueueFaceRefresh without a face model is an error; resuming without a model fails the job with the install message.",
  "sql": [
   "INSERT INTO files(id,path_text,path_hash,size_bytes,scanned_at,kind,extension) VALUES(1,'{root}/1.jpg',1,1,0,'image','jpg'),(2,'{root}/2.jpg',2,1,0,'image','jpg'),(3,'{root}/3.jpg',3,1,0,'image','jpg'),(4,'{root}/4.jpg',4,1,0,'image','jpg'),(5,'{root}/5.jpg',5,1,0,'image','jpg'),(6,'{root}/6.jpg',6,1,0,'image','jpg'),(7,'{root}/7.jpg',7,1,0,'image','jpg'),(8,'{root}/8.jpg',8,1,0,'image','jpg'),(9,'{root}/9.jpg',9,1,0,'image','jpg'),(10,'{root}/10.jpg',10,1,0,'image','jpg'),(11,'{root}/11.jpg',11,1,0,'image','jpg'),(12,'{root}/12.jpg',12,1,0,'image','jpg')",
   "INSERT INTO face_prints(id,file_id,print_data,bbox,embedding_model,processing_version) VALUES(1,1,X'00','b1','old','p'),(2,2,X'00','b2','old','p'),(3,3,X'00','b3','old','p'),(4,4,X'00','b4','old','p'),(5,5,X'00','b5','old','p')",
   "INSERT INTO catalog_jobs(id,kind,file_ids_json,recipe_json,state,progress,priority,created_at,updated_at) VALUES('face-refresh','faceRefresh','[]','{\"model\":\"m\",\"processing\":\"p\"}','running',0.4,0,1,1)",
   "INSERT INTO face_refresh_backlog(face_id,embedding_model,processing_version,state,attempts,updated_at) VALUES(1,'m','p','done',0,1),(2,'m','p','pending',0,1),(3,'m','p','missing',0,1),(4,'m','p','offline',0,1),(5,'m','p','failed',1,1),(1,'other','p','pending',0,1)"
  ],
  "steps": [
   {
    "label": "interrupted job is paused",
    "catalog": {
     "action": "jobs"
    },
    "expect": {
     "status": "ok",
     "jobs": [
      {
       "id": "face-refresh",
       "kind": "faceRefresh",
       "state": "paused",
       "error": "Interrupted. Resume to continue; faces already updated are kept."
      }
     ]
    }
   },
   {
    "label": "backlog counts",
    "command": {
     "listFaceReview": {
      "requestID": "f-1",
      "queue": "refresh"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "f-1"
    },
    "expect": {
     "status": "ok",
     "queue": "refresh",
     "total": 1,
     "refresh": {
      "model": "m",
      "processing": "p",
      "outdated": 5,
      "total": 5,
      "done": 1,
      "pending": 1,
      "missing": 1,
      "offline": 1,
      "failed": 1,
      "jobID": "face-refresh",
      "state": "paused"
     }
    }
   },
   {
    "label": "no model to enqueue",
    "catalog": {
     "action": "enqueueFaceRefresh"

      "0user-verified1114"
     ]
    ]
   },
   {
    "label": "undo split",
    "command": {
     "undoFaceReview": {
      "requestID": "s-3",
      "operationID": {
       "$var": "op"
      }
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "s-3"
    },
    "expect": {
     "status": "ok",

    "command": {
     "resolveFaceReview": {
      "requestID": "s-2",
      "personID": 5,
      "resolution": "split"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "s-2"
    },
    "expect": {
     "status": "ok",
     "queue": "splits",
     "personID": 5,
     "otherPersonID": {
      "$tol": "present"
     },
     "total": 0
    },
    "save": {
     "name": "op",
     "path": "operationID"
    }
   },
   {
    "label": "moved",
    "db": "SELECT (SELECT COUNT(DISTINCT person_id) FROM face_prints WHERE id IN (14,15,16)), (SELECT person_id FROM face_prints WHERE id=14)<>5, (SELECT file_count FROM persons WHERE id=5), (SELECT COUNT(*) FROM persons), (SELECT same_person||vlm_model||face_a||face_b FROM face_verifications)",
    "expect": [
     [
      1,

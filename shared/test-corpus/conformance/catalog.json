[
  {
    "name": "catalog-events-takes-and-chapters-edit-and-undo",
    "description": "Catalog actions the app sends from Best Takes and the video detail: list, save, delete and undo events (titles trimmed, file ids sorted and deduplicated), take groups, take feedback and its undo, chapter delete and undo, and empty suggestions without vectors. Refused requests answer status error and change nothing.",
    "sql": [
      "INSERT INTO files(id,path_text,path_hash,size_bytes,modified_at,created_at,scanned_at,kind,extension,vlm_description) VALUES(1,'/internal/Party/a.jpg',1,100,10,1000,0,'image','jpg','Kids blow out birthday candles'),(2,'/internal/Party/b.jpg',2,100,10,1005,0,'image','jpg','Kids blow out candles on a cake'),(3,'/internal/Party/c.jpg',3,100,10,1010,0,'image','jpg','A cake on a table'),(4,'/internal/Trip/d.mov',4,100,10,5000,0,'video','mov','A walk in the park')",
      "INSERT INTO catalog_chapters(id,file_id,start_seconds,end_seconds,title,summary,source_revision,model_version,confidence,user_edited) VALUES('c1',4,1,5,'Start','Walking starts','fixture','fixture',0.5,0)"
    ],
    "steps": [
      {"label": "delete chapter", "catalog": {"action": "deleteChapter", "fileID": 4, "chapterID": "c1"},
       "expect": {"status": "ok", "chapters": {"$tol": "count", "value": 0}}},
      {"label": "undo chapter delete", "catalog": {"action": "undoChapterEdit", "fileID": 4},
       "expect": {"status": "ok", "chapters": [{"id": "c1", "title": "Start", "startSeconds": 1.0, "endSeconds": 5.0, "userEdited": false, "stale": true}]}},
      {"label": "missing chapter refused", "catalog": {"action": "deleteChapter", "fileID": 4, "chapterID": "missing"},
       "expect": {"status": "error"}},
      {"label": "detail keeps the chapter", "catalog": {"action": "detail", "fileID": 4},
       "expect": {"status": "ok", "chapters": [{"id": "c1"}]}},
      {"label": "no events yet", "catalog": {"action": "listEvents"},
       "expect": {"status": "ok", "events": {"$tol": "count", "value": 0}}},
      {"label": "save event", "catalog": {"action": "saveEvent", "event": {"id": "party", "title": " Birthday ", "goal": "candles", "fileIDs": [3, 1, 2, 2], "userEdited": false}},
       "expect": {"status": "ok",
                  "events": [{"$tol": "exact", "value": {"id": "party", "title": "Birthday", "goal": "candles", "fileIDs": [1, 2, 3], "userEdited": true}}],
                  "recommendation": {"eventID": "party", "status": "insufficient", "fileIDs": []},
                  "takes": [{"fileID": 1, "preferred": false, "stale": false}, {"fileID": 2, "preferred": false}, {"fileID": 3, "preferred": false}]}},
      {"label": "list by title words", "catalog": {"action": "listEvents", "query": "birth"},
       "expect": {"status": "ok", "events": [{"id": "party"}]}},
      {"label": "take group", "catalog": {"action": "takeGroup", "eventID": "party"},
       "expect": {"status": "ok", "takes": {"$tol": "count", "value": 3}, "recommendation": {"status": "insufficient"}}},
      {"label": "prefer a take", "catalog": {"action": "setTakeFeedback", "takeFeedback": {"eventID": "party", "fileID": 2, "preferred": true, "outcomeScore": 0.8}},
       "expect": {"status": "ok",
                  "recommendation": {"$tol": "exact", "value": {"eventID": "party", "status": "preferred", "fileIDs": [2], "reason": "Marked as preferred by you."}},
                  "takes": [{"fileID": 1, "preferred": false}, {"fileID": 2, "preferred": true, "outcomeScore": 0.8, "confidence": 1.0, "explanation": "Reviewed by you", "modelVersion": "user", "stale": false}, {"fileID": 3}]}},
      {"label": "feedback outside the event refused", "catalog": {"action": "setTakeFeedback", "takeFeedback": {"eventID": "party", "fileID": 4, "preferred": true}},
       "expect": {"status": "error"}},
      {"label": "undo feedback", "catalog": {"action": "undoTakeFeedback", "eventID": "party", "fileID": 2},
       "expect": {"status": "ok", "recommendation": {"status": "insufficient"}, "takes": [{"fileID": 1}, {"fileID": 2, "preferred": false}, {"fileID": 3}]}},
      {"label": "nothing left to undo", "catalog": {"action": "undoTakeFeedback", "eventID": "party", "fileID": 2},
       "expect": {"status": "error"}},
      {"label": "edit event", "catalog": {"action": "saveEvent", "event": {"id": "party", "title": "Birthday", "goal": "cake", "fileIDs": [1, 2], "userEdited": true}},
       "expect": {"status": "ok", "events": [{"goal": "cake", "fileIDs": [1, 2]}]}},
      {"label": "undo edit", "catalog": {"action": "undoEventEdit", "eventID": "party"},
       "expect": {"status": "ok", "events": [{"$tol": "exact", "value": {"id": "party", "title": "Birthday", "goal": "candles", "fileIDs": [1, 2, 3], "userEdited": true}}]}},
      {"label": "delete event", "catalog": {"action": "deleteEvent", "eventID": "party"},
       "expect": {"status": "ok", "events": {"$tol": "count", "value": 0}}},
      {"label": "undo delete", "catalog": {"action": "undoEventEdit", "eventID": "party"},
       "expect": {"status": "ok", "events": [{"id": "party", "fileIDs": [1, 2, 3]}]}},
      {"label": "unknown event refused", "catalog": {"action": "deleteEvent", "eventID": "nope"},
       "expect": {"status": "error"}},
      {"label": "no suggestions without vectors", "catalog": {"action": "suggestTakeGroups", "fileIDs": [1, 2, 3]},
       "expect": {"status": "ok", "suggestedTakeGroups": {"$tol": "count", "value": 0},
                  "message": "No related takes found among files with current visual embeddings and capture dates."}},
      {"label": "undo journal", "db": "SELECT state FROM catalog_operations ORDER BY rowid",
       "expect": [["undone"], ["completed"], ["undone"], ["undone"], ["undone"]]}
    ]
  },
  {
    "name": "catalog-job-controls-need-a-worker",
    "description": "Pause, resume and cancel change only jobs this engine has a worker for: a job of an unknown kind (or no job id) is refused and left as it was, a finished job cannot be resumed or cancelled, and a cancelled job cannot be resumed.",
    "sql": [
      "INSERT INTO catalog_jobs(id,kind,file_ids_json,recipe_json,state,priority,progress,created_at,updated_at) VALUES('take-grouping','takeGrouping','[]','{}','paused',0,0.4,1,1)",
      "INSERT INTO catalog_jobs(id,kind,file_ids_json,recipe_json,state,priority,progress,created_at,updated_at) VALUES('odd','mystery','[]','{}','queued',0,0,1,1)",
      "INSERT INTO catalog_jobs(id,kind,file_ids_json,recipe_json,state,priority,progress,created_at,updated_at) VALUES('done','takeGrouping','[]','{}','completed',0,1,1,1)"
    ],
    "steps": [
      {"label": "jobs", "catalog": {"action": "jobs"},
       "expect": {"status": "ok", "jobs": {"$tol": "count", "value": 3}}},
      {"label": "unknown kind cannot pause", "catalog": {"action": "pauseJob", "jobID": "odd"},
       "expect": {"status": "error", "message": "This job has no supported worker in this engine."}},
      {"label": "unknown kind cannot cancel", "catalog": {"action": "cancelJob", "jobID": "odd"},
       "expect": {"status": "error", "message": "This job has no supported worker in this engine."}},
      {"label": "no job id", "catalog": {"action": "pauseJob"},
       "expect": {"status": "error", "message": "This job has no supported worker in this engine."}},
      {"label": "missing job", "catalog": {"action": "cancelJob", "jobID": "gone"},
       "expect": {"status": "error", "message": "This job has no supported worker in this engine."}},
      {"label": "cancel paused grouping", "catalog": {"action": "cancelJob", "jobID": "take-grouping"},
       "expect": {"status": "ok", "jobs": [{"id": "take-grouping", "state": "cancelled", "progress": 0.4}, {"id": "odd", "state": "queued"}, {"id": "done", "state": "completed"}]}},
      {"label": "cancelled cannot resume", "catalog": {"action": "resumeJob", "jobID": "take-grouping"},
       "expect": {"status": "error"}},
      {"label": "finished cannot cancel", "catalog": {"action": "cancelJob", "jobID": "done"},
       "expect": {"status": "error"}},
      {"label": "finished cannot resume", "catalog": {"action": "resumeJob", "jobID": "done"},
       "expect": {"status": "error"}},
      {"label": "states", "db": "SELECT id,kind,state FROM catalog_jobs ORDER BY id",
       "expect": [["done", "takeGrouping", "completed"], ["odd", "mystery", "queued"], ["take-grouping", "takeGrouping", "cancelled"]]}
    ]
  }
]

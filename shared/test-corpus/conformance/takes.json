    "sql": [
      "INSERT INTO clip_embeddings(file_id,embedding,model) VALUES(1,CAST(X'0000803f'||zeroblob(2044) AS BLOB),'{clip_model}'),(2,CAST(X'8fc2753f295c8f3e'||zeroblob(2040) AS BLOB),'{clip_model}'),(3,CAST(zeroblob(4)||X'0000803f'||zeroblob(2040) AS BLOB),'{clip_model}'),(4,CAST(X'0000803f'||zeroblob(2044) AS BLOB),'{clip_model}'),(5,CAST(X'8fc2753f295c8f3e'||zeroblob(2040) AS BLOB),'{clip_model}'),(6,CAST(X'0000803f'||zeroblob(2044) AS BLOB),'{clip_model}'),(7,CAST(X'8fc2753f295c8f3e'||zeroblob(2040) AS BLOB),'{clip_model}')",
      "INSERT INTO catalog_jobs(id,kind,file_ids_json,recipe_json,state,priority,progress,created_at,updated_at) VALUES('take-grouping','takeGrouping','[]','{}','running',0,0.4,1,1)"
    ],
    "steps": [
      {
        "label": "interrupted job is paused",
        "catalog": {
          "action": "jobs"
        },
        "expect": {
          "status": "ok",
          "jobs": [
            {
              "id": "take-grouping",
              "kind": "takeGrouping",
              "state": "paused",
              "progress": 0.4,
              "error": {
                "$tol": "present"
              }
            }
          ]
        }
      },
      {
        "label": "resume",
        "catalog": {
          "action": "resumeJob",
          "jobID": "take-grouping"
        },
        "expect": {
          "status": "ok"
        }
      },
      {
        "label": "resumed job finishes",
        "catalog": {
          "action": "takeGroupProposals"
        },
        "until": 20,
        "expect": {
          "status": "ok",
          "jobs": [
            {
              "id": "take-grouping",
              "kind": "takeGrouping",
              "state": "completed",
              "progress": 1
            }
          ],
          "takeGroups": {
            "$tol": "count",
            "value": 3
          }
        }
      },
      {
        "label": "stamps",
        "db": "SELECT group_key,proposed_at FROM take_proposals ORDER BY group_key",
        "save": "stamps"
      },
      {
        "label": "completed jobs cannot be cancelled",
        "catalog": {
          "action": "cancelJob",
          "jobID": "take-grouping"
        },
        "expect": {
          "status": "error"
        }
      },
      {
        "label": "rerun",
        "catalog": {
          "action": "enqueueTakeGrouping"
        },
        "expect": {
          "status": "ok"
        }
      },
      {
        "label": "rerun finishes",
        "catalog": {
          "action": "takeGroupProposals"
        },
        "until": 20,
        "expect": {
          "status": "ok",
          "jobs": [
            {
              "id": "take-grouping",
              "kind": "takeGrouping",
              "state": "completed",
              "progress": 1
            }
          ],
          "takeGroups": {
            "$tol": "count",
            "value": 3
          }
        }
      },
      {
        "label": "nothing was redone",
        "db": "SELECT group_key,proposed_at FROM take_proposals ORDER BY group_key",
        "expect": {
          "$var": "stamps"
        }
      }
    ]
  }

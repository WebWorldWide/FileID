      {
        "label": "only the changed session was redone",
        "db": "SELECT file_ids_json FROM take_proposals ORDER BY file_ids_json",
        "expect": [
          [
            "[1,2]"
          ],
          [
            "[4,5]"
          ]
        ]
      },
      {
        "label": "untouched session kept its proposal",
        "db": "SELECT proposed_at FROM take_proposals WHERE file_ids_json='[4,5]'",
        "expect": [
          [
            {
              "$var": "party"
            }

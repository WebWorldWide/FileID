  {
    "name": "people-merge-suggestions-empty-library",
    "description": "findMergeSuggestions on a library without people answers with an empty pair list, not an error.",
    "steps": [
      {"label": "suggest", "command": {"findMergeSuggestions": {}}, "await": "mergeSuggestions", "expect": {"$tol": "exact", "value": {"pairs": []}}}
    ]
  },
  {
    "name": "search-embed-text-without-clip",
    "description": "embedTextQuery with no CLIP text model installed answers with an empty embedding for the same query, so search falls back to keywords without an error.",
    "steps": [
      {"label": "embed", "command": {"embedTextQuery": {"query": "a dog on a beach", "queryID": "q1"}}, "await": "clipTextEmbedding", "abortOnError": true, "expect": {"$tol": "exact", "value": {"queryID": "q1", "query": "a dog on a beach", "embedding": []}}}
    ]
  },
  {
    "name": "search-embed-image-uses-the-stored-clip-vector",
    "description": "embedImageQuery replies on clipTextEmbedding with query file:<id>: the stored 512-d CLIP vector, or an empty embedding when the file has none or the stored row is the wrong width.",
    "sql": [
      "INSERT INTO files(id,path_text,path_hash,size_bytes,scanned_at,kind,extension) VALUES(1,'{root}/1.jpg',1,1,0,'image','jpg'),(2,'{root}/2.jpg',2,1,0,'image','jpg'),(3,'{root}/3.jpg',3,1,0,'image','jpg')",
      "INSERT INTO clip_embeddings(file_id,embedding,model) VALUES(1,CAST(zeroblob(12)||X'0000803f'||zeroblob(2032) AS BLOB),'fixture'),(3,CAST(X'0000803f'||zeroblob(4) AS BLOB),'fixture')"
    ],
    "steps": [
      {"label": "stored", "command": {"embedImageQuery": {"fileID": 1, "queryID": "i1"}}, "await": "clipTextEmbedding", "filter": {"queryID": "i1"}, "expect": {"query": "file:1", "embedding": {"$tol": "count", "value": 512}}},
      {"label": "missing", "command": {"embedImageQuery": {"fileID": 2, "queryID": "i2"}}, "await": "clipTextEmbedding", "filter": {"queryID": "i2"}, "expect": {"$tol": "exact", "value": {"queryID": "i2", "query": "file:2", "embedding": []}}},
      {"label": "malformed", "command": {"embedImageQuery": {"fileID": 3, "queryID": "i3"}}, "await": "clipTextEmbedding", "filter": {"queryID": "i3"}, "expect": {"$tol": "exact", "value": {"queryID": "i3", "query": "file:3", "embedding": []}}}
    ]
  },
  {
    "name": "files-video-thumbnail-undecodable-emits-nothing",
    "description": "generateVideoThumbnail for a file that is not a decodable video emits neither thumbnailGenerated nor an error; the app keeps its placeholder.",
    "tree": [
      {"path": "clip.mp4", "content": "not a video"}
    ],
    "steps": [
      {"label": "request", "command": {"generateVideoThumbnail": {"path": "{path:clip.mp4}", "modifiedAt": 1.5}}},
      {"label": "next reply", "command": {"embedTextQuery": {"query": "after the thumbnail", "queryID": "after"}}, "await": "clipTextEmbedding", "filter": {"queryID": "after"}, "abortOnError": true, "collect": {"thumbnailGenerated": {"$tol": "count", "value": 0}}}
    ]
  }
]

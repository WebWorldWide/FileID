  {
    "name": "restructure-apply-and-undo-round-trip",
    "description": "Applying the respect-stage plan moves the files and their catalog rows; undo restores both, byte for byte.",
    "extends": "restructure-respect-stage",
    "steps": [
      {
        "label": "plan",
        "save": "plan",
        "command": {
          "planRestructure": {
            "libraryRoot": "{root}"
          }
        },
        "await": "restructurePlan",
        "timeout": 120,
        "abortOnError": true,
        "expect": {
          "moves": {
            "$tol": "count",
            "value": 8
          }
        }
      },
      {
        "label": "apply",
        "command": {
          "applyRestructure": {
            "libraryRoot": "{root}",
            "moves": {
              "$var": "plan.moves"
            },
            "useSymlinks": false
          }
        },
        "await": "restructureApplyResult",
        "timeout": 120,
        "abortOnError": true,
        "expect": {
          "applied": 8,
          "failed": 0
        }
      },
      {
        "label": "moved on disk",
        "fs": {
          "exists": [
            "Photos/2026/2026-10-04/DSC00001.JPG",
            "Photos/2026/2026-10-04/DSC00005.JPG",
            "Kyle Baseball Game 9-19-26/Photos/RAWs/D1.ARW",
            "Kyle Baseball Game 9-19-26/Photos/RAWs/D3.ARW",
            "Recipes/lasagna.txt",
            "Kyle Baseball Game 9-19-26/Photos/JPEGs/K1.JPG"
          ],
          "absent": [
            "DCIM/100MSDCF/DSC00001.JPG",
            "DCIM/100MSDCF/DSC00005.JPG",
            "Kyle Baseball Game 9-19-26/Photos/JPEGs/D1.ARW",
            "Kyle Baseball Game 9-19-26/Photos/JPEGs/D3.ARW"
          ]
        }
      },
      {
        "label": "moved in catalog",
        "db": "SELECT id,path_text FROM files WHERE id IN (1,13,20) ORDER BY id",
        "expect": [
          [
            1,
            "{path:Photos/2026/2026-10-04/DSC00001.JPG}"
          ],
          [
            13,
            "{path:Kyle Baseball Game 9-19-26/Photos/RAWs/D1.ARW}"
          ],
          [
            20,
            "{path:Recipes/lasagna.txt}"
          ]
        ]
      },
      {
        "label": "undo",
        "command": {
          "undoRestructure": {
            "libraryRoot": "{root}"
          }
        },
        "await": "restructureApplyResult",
        "timeout": 120,
        "abortOnError": true,
        "expect": {
          "applied": 8,
          "failed": 0
        }
      },
      {
        "label": "restored on disk",
        "fs": {
          "exists": [
            "DCIM/100MSDCF/DSC00001.JPG",
            "DCIM/100MSDCF/DSC00005.JPG",
            "Kyle Baseball Game 9-19-26/Photos/JPEGs/D1.ARW",
            "Kyle Baseball Game 9-19-26/Photos/JPEGs/D3.ARW"
          ],
          "absent": [
            "Photos/2026/2026-10-04/DSC00001.JPG",
            "Photos/2026/2026-10-04/DSC00005.JPG",
            "Kyle Baseball Game 9-19-26/Photos/RAWs/D1.ARW",
            "Kyle Baseball Game 9-19-26/Photos/RAWs/D3.ARW"
          ],
          "contents": {
            "DCIM/100MSDCF/DSC00001.JPG": "dsc1",
            "Kyle Baseball Game 9-19-26/Photos/JPEGs/D1.ARW": "d1"
          }
        }
      },
      {
        "label": "restored in catalog",
        "db": "SELECT id,path_text FROM files WHERE id IN (1,13) ORDER BY id",
        "expect": [
          [
            1,
            "{path:DCIM/100MSDCF/DSC00001.JPG}"
          ],
          [
            13,
            "{path:Kyle Baseball Game 9-19-26/Photos/JPEGs/D1.ARW}"
          ]
        ]
      }
    ]
  },
  {
    "name": "restructure-apply-refuses-unhashed-rows",
    "description": "A plan whose catalog rows carry no content hash cannot prove the files are the ones it planned, so apply moves nothing.",
    "extends": "restructure-respect-stage",
    "knownDivergences": [
      {
        "engine": "swift",
        "reason": "applyRestructure moves files whose catalog rows have no content hash instead of refusing them"
      }
    ],
    "sql": [
      "UPDATE files SET content_hash=NULL"
    ],
    "steps": [
      {
        "label": "plan",
        "save": "plan",
        "command": {
          "planRestructure": {
            "libraryRoot": "{root}"
          }
        },
        "await": "restructurePlan",
        "timeout": 120,
        "abortOnError": true,
        "expect": {
          "moves": {
            "$tol": "count",
            "value": 8
          }
        }
      },
      {
        "label": "apply",
        "command": {
          "applyRestructure": {
            "libraryRoot": "{root}",
            "moves": {
              "$var": "plan.moves"
            },
            "useSymlinks": false
          }
        },
        "await": "restructureApplyResult",
        "timeout": 120,
        "expect": {
          "applied": 0,
          "failed": 8
        }
      },
      {
        "label": "nothing moved",
        "fs": {
          "exists": [
            "DCIM/100MSDCF/DSC00001.JPG",
            "Kyle Baseball Game 9-19-26/Photos/JPEGs/D1.ARW"
          ],
          "absent": [
            "Photos"
          ]
        }
      }
    ]
  }

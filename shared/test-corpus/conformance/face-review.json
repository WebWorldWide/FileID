[
 {
  "name": "face-review-list-pages-and-filters",
  "description": "listFaceReview pages pending suggestions best score first, names people (display name, else first and last name, unnamed omitted), filters by person, hides suggestions from another face space, and refuses bad paging; a bad request id gets an error and no reply.",
  "sql": [
   "INSERT INTO files(id,path_text,path_hash,size_bytes,scanned_at,kind,extension) VALUES(1,'{root}/1.jpg',1,1,0,'image','jpg'),(2,'{root}/2.jpg',2,1,0,'image','jpg'),(3,'{root}/3.jpg',3,1,0,'image','jpg'),(4,'{root}/4.jpg',4,1,0,'image','jpg'),(5,'{root}/5.jpg',5,1,0,'image','jpg')",
   "INSERT INTO persons(id,name,created_at,representative_face_id,file_count) VALUES(1,'Alex',0,1,1)",
   "INSERT INTO persons(id,created_at,representative_face_id,file_count) VALUES(2,0,2,1)",
   "INSERT INTO persons(id,first_name,last_name,created_at,representative_face_id,file_count) VALUES(3,'Sam','Lee',0,5,1)",
   "INSERT INTO face_prints(id,file_id,person_id,print_data,bbox,embedding_model,processing_version,face_quality) VALUES(1,1,1,X'00','b1','m','p',0.5),(2,2,2,X'00','b2','m','p',0.5),(5,2,3,X'00','b5','m','p',0.5),(3,3,NULL,X'00','b3','m','p',0.5),(4,4,NULL,X'00','b4','m','p',0.5),(6,2,NULL,X'00','b6','m','p',0.5),(7,3,NULL,X'00','b7','old','p',0.5),(8,4,1,X'00','b8','m','p',0.9)",
   "UPDATE persons SET file_count=2 WHERE id=1",
   "INSERT INTO face_assignment_assessed(face_id,namespace,outcome,assessed_at) VALUES(3,'m|p','suggested',100),(4,'m|p','uncertain',101),(6,'m|p','ambiguous',102),(7,'old|p','suggested',103)",
   "INSERT INTO face_review_candidates(face_id,person_id,score,reason,runner_up_person_id,runner_up_score,namespace,created_at) VALUES(3,1,0.81,'suggested',2,0.2,'m|p',100),(4,2,0.47,'uncertain',1,0.3,'m|p',101),(6,3,0.6,'ambiguous',1,0.58,'m|p',102),(7,1,0.99,'suggested',NULL,NULL,'m|p',103)"
  ],
  "steps": [
   {
    "label": "first page",
    "command": {
     "listFaceReview": {
      "requestID": "list-1",
      "limit": 2
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "list-1"
    },
    "expect": {
     "action": "list",
     "status": "ok",
     "total": 3,
     "offset": 0,
     "items": [
      {
       "faceID": 3,
       "fileID": 3,
       "path": "{root}/3.jpg",
       "bbox": "b3",
       "personID": 1,
       "personName": "Alex",
       "representativeFaceID": 1,
       "score": 0.81,
       "reason": "suggested",
       "runnerUpPersonID": 2,
       "runnerUpScore": 0.2,
       "createdAt": 100
      },
      {
       "faceID": 6,
       "personID": 3,
       "personName": "Sam Lee",
       "reason": "ambiguous",
       "runnerUpName": "Alex",
       "runnerUpScore": 0.58
      }
     ]
    }
   },
   {
    "label": "second page",
    "command": {
     "listFaceReview": {
      "requestID": "list-2",
      "offset": 2,
      "limit": 2
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "list-2"
    },
    "expect": {
     "status": "ok",
     "total": 3,
     "offset": 2,
     "items": [
      {
       "faceID": 4,
       "personID": 2,
       "reason": "uncertain",
       "score": 0.47,
       "runnerUpName": "Alex"
      }
     ]
    }
   },
   {
    "label": "one person",
    "command": {
     "listFaceReview": {
      "requestID": "list-3",
      "personID": 2
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "list-3"
    },
    "expect": {
     "status": "ok",
     "total": 1,
     "items": {
      "$tol": "count",
      "value": 1
     }
    }
   },
   {
    "label": "unnamed person has no name",
    "command": {
     "listFaceReview": {
      "requestID": "list-4",
      "personID": 2
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "list-4"
    },
    "expect": {
     "items": [
      {
       "faceID": 4,
       "personName": null
      }
     ]
    }
   },
   {
    "label": "bad limit",
    "command": {
     "listFaceReview": {
      "requestID": "list-5",
      "limit": 0
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "list-5"
    },
    "expect": {
     "status": "refused",
     "total": 0,
     "items": [],
     "message": "Ask for 1 to 200 suggestions from offset 0 or later."
    }
   },
   {
    "label": "too many",
    "command": {
     "listFaceReview": {
      "requestID": "list-6",
      "limit": 201
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "list-6"
    },
    "expect": {
     "status": "refused"
    }
   },
   {
    "label": "bad request id",
    "command": {
     "listFaceReview": {
      "requestID": "bad id"
     }
    },
    "await": "error",
    "filter": {
     "kind": "invalid_face_review_request"
    },
    "expect": {
     "kind": "invalid_face_review_request"
    }
   },
   {
    "label": "nothing changed",
    "db": "SELECT COUNT(*) FROM face_review_candidates",
    "expect": [
     [
      4
     ]
    ]
   }
  ]
 },
 {
  "name": "face-review-accept-and-undo",
  "description": "Accept assigns the face, recounts the person, settles the suggestion and logs one face_review operation; Undo by operation id puts the face and the suggestion back once.",
  "extends": "face-review-list-pages-and-filters",
  "steps": [
   {
    "label": "wrong person",
    "command": {
     "resolveFaceReview": {
      "requestID": "r-1",
      "faceID": 3,
      "personID": 2,
      "resolution": "accept"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "r-1"
    },
    "expect": {
     "status": "refused",
     "message": "This suggestion changed. Refresh the review list."
    }
   },
   {
    "label": "bad resolution",
    "command": {
     "resolveFaceReview": {
      "requestID": "r-2",
      "faceID": 3,
      "personID": 1,
      "resolution": "maybe"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "r-2"
    },
    "expect": {
     "status": "refused",
     "message": "Choose accept, reject or ignore."
    }
   },
   {
    "label": "accept",
    "command": {
     "resolveFaceReview": {
      "requestID": "r-3",
      "faceID": 3,
      "personID": 1,
      "resolution": "accept"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "r-3"
    },
    "expect": {
     "action": "resolve",
     "status": "ok",
     "faceID": 3,
     "personID": 1,
     "total": 2,
     "offset": 0,
     "items": [],
     "operationID": {
      "$tol": "present"
     }
    },
    "save": {
     "name": "op",
     "path": "operationID"
    }
   },
   {
    "label": "assigned",
    "db": "SELECT (SELECT person_id FROM face_prints WHERE id=3),(SELECT file_count FROM persons WHERE id=1),(SELECT representative_face_id FROM persons WHERE id=1),(SELECT outcome FROM face_assignment_assessed WHERE face_id=3),(SELECT COUNT(*) FROM face_review_candidates WHERE face_id=3)",
    "expect": [
     [
      1,
      3,
      1,
      "accepted",
      0
     ]
    ]
   },
   {
    "label": "logged",
    "db": "SELECT c.kind,c.file_id,o.state,json_extract(o.plan_json,'$.type'),json_extract(c.after_json,'$.resolution'),json_extract(c.before_json,'$.candidate.reason') FROM catalog_corrections c JOIN catalog_operations o ON o.id=c.id",
    "expect": [
     [
      "face_review",
      3,
      "completed",
      "faceReview",
      "accept",
      "suggested"
     ]
    ]
   },
   {
    "label": "resolved once",
    "command": {
     "resolveFaceReview": {
      "requestID": "r-4",
      "faceID": 3,
      "personID": 1,
      "resolution": "accept"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "r-4"
    },
    "expect": {
     "status": "refused",
     "message": "This suggestion changed. Refresh the review list."
    }
   },
   {
    "label": "undo",
    "command": {
     "undoFaceReview": {
      "requestID": "u-1",
      "operationID": {
       "$var": "op"
      }
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "u-1"
    },
    "expect": {
     "action": "undo",
     "status": "ok",
     "faceID": 3,
     "total": 3,
     "operationID": {
      "$var": "op"
     }
    }
   },
   {
    "label": "restored",
    "db": "SELECT (SELECT person_id FROM face_prints WHERE id=3),(SELECT file_count FROM persons WHERE id=1),(SELECT outcome FROM face_assignment_assessed WHERE face_id=3),(SELECT state FROM catalog_operations)",
    "expect": [
     [
      null,
      2,
      "suggested",
      "undone"
     ]
    ]
   },
   {
    "label": "suggestion back",
    "db": "SELECT face_id,person_id,score,reason,runner_up_person_id,runner_up_score,namespace,created_at FROM face_review_candidates WHERE face_id=3",
    "expect": [
     [
      3,
      1,
      0.81,
      "suggested",
      2,
      0.2,
      "m|p",
      100
     ]
    ]
   },
   {
    "label": "undo once",
    "command": {
     "undoFaceReview": {
      "requestID": "u-2",
      "operationID": {
       "$var": "op"
      }
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "u-2"
    },
    "expect": {
     "status": "refused",
     "message": "There is nothing to undo for this suggestion."
    }
   }
  ]
 },
 {
  "name": "face-review-accept-refused-when-person-in-photo",

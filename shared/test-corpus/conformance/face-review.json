 {
  "name": "people-reassign-records-a-correction",
  "description": "Moving a face out of a person by hand stores a reassign constraint against the person's new representative face, logs a face_reassign correction and settles the face's review state.",
  "extends": "face-review-list-pages-and-filters",
  "steps": [
   {
    "label": "move",
    "command": {
     "reassignFace": {
      "faceID": 1,
      "destinationPersonID": 2
     }
    },
    "await": "bulkActionResult",
    "expect": {
     "succeeded": 1,
     "failed": 0
    }
   },
   {
    "label": "constraint",
    "db": "SELECT file_id,bbox,anchor_file_id,anchor_bbox,source FROM face_identity_constraints",
    "expect": [
     [
      1,
      "b1",
      4,
      "b8",
      "reassign"
     ]
    ]
   },
   {
    "label": "correction",
    "db": "SELECT kind,file_id,json_extract(before_json,'$.personID'),json_extract(after_json,'$.personID') FROM catalog_corrections",
    "expect": [
     [
      "face_reassign",
      1,
      1,
      2
     ]
    ]
   },
   {
    "label": "settled",
    "db": "SELECT outcome FROM face_assignment_assessed WHERE face_id=1",
    "expect": [
     [
      "manual"
     ]
    ]
   },
   {
    "label": "suggestion settled",
    "command": {
     "reassignFace": {
      "faceID": 3,
      "destinationPersonID": 1
     }
    },
    "await": "bulkActionResult",
    "expect": {
     "succeeded": 1
    }
   },
   {
    "label": "no longer pending",
    "db": "SELECT (SELECT COUNT(*) FROM face_review_candidates WHERE face_id=3),(SELECT outcome FROM face_assignment_assessed WHERE face_id=3)",
    "expect": [
     [
      0,
      "manual"
     ]
    ]
   }
  ]
 },
 {
  "name": "cross-face-review-resolve-and-undo",
  "description": "Swift accepts a suggestion and Rust undoes it from the shared operation log; Rust rejects one and Swift undoes it, so both engines read each other's face_review journal.",
  "requires": [
   "swift",
   "rust"
  ],
  "engines": [
   "swift"
  ],
  "start": "swift",
  "extends": "face-review-list-pages-and-filters",
  "steps": [
   {
    "label": "swift accepts",
    "command": {
     "resolveFaceReview": {
      "requestID": "x-1",
      "faceID": 3,
      "personID": 1,
      "resolution": "accept"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "x-1"
    },
    "expect": {
     "status": "ok",
     "personID": 1,
     "total": 2
    },
    "save": {
     "name": "op",
     "path": "operationID"
    }
   },
   {
    "restart": "rust"
   },
   {
    "label": "rust lists",
    "command": {
     "listFaceReview": {
      "requestID": "x-2"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "x-2"
    },
    "expect": {
     "status": "ok",
     "total": 2
    }
   },
   {
    "label": "rust undoes",
    "command": {
     "undoFaceReview": {
      "requestID": "x-3",
      "operationID": {
       "$var": "op"
      }
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "x-3"
    },
    "expect": {
     "status": "ok",
     "faceID": 3,
     "total": 3
    }
   },
   {
    "label": "rust rejects",
    "command": {
     "resolveFaceReview": {
      "requestID": "x-4",
      "faceID": 3,
      "personID": 1,
      "resolution": "reject"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "x-4"
    },
    "expect": {
     "status": "ok",
     "total": 2
    },
    "save": {
     "name": "op2",
     "path": "operationID"
    }
   },
   {
    "restart": "swift"
   },
   {
    "label": "swift lists",
    "command": {
     "listFaceReview": {
      "requestID": "x-5"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "x-5"
    },
    "expect": {
     "status": "ok",
     "total": 2
    }
   },
   {
    "label": "swift undoes",
    "command": {
     "undoFaceReview": {
      "requestID": "x-6",
      "operationID": {
       "$var": "op2"
      }
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "x-6"
    },
    "expect": {
     "status": "ok",
     "total": 3
    }
   },
   {
    "label": "back to start",
    "db": "SELECT (SELECT person_id FROM face_prints WHERE id=3),(SELECT COUNT(*) FROM face_identity_constraints),(SELECT COUNT(*) FROM catalog_operations WHERE state='undone')",
    "expect": [
     [
      null,
      0,
      2
     ]
    ]
   },
   {
    "label": "suggestion back",
    "db": "SELECT face_id,person_id,score,reason,runner_up_person_id,runner_up_score,namespace,created_at FROM face_review_candidates WHERE face_id=3",
    "expect": [
     [
      3,
      1,
      0.81,
      "suggested",
      2,
      0.2,
      "m|p",
      100
     ]
    ]
   }
  ]
 },
 {
  "name": "face-review-clustering-queues-new-faces",
  "description": "With people already in the face space, runFaceClustering keeps new faces out of the full pass, compares them with person centroids and queues a suggestion without assigning; a face close to nobody is recorded as unmatched. Swift needs the installed face model, so this runs on Rust only.",
  "engines": [
   "rust"

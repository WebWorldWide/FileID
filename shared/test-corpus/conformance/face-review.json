  "extends": "face-review-list-pages-and-filters",
  "steps": [
   {
    "label": "accept",
    "command": {
     "resolveFaceReview": {
      "requestID": "r-1",
      "faceID": 6,
      "personID": 3,
      "resolution": "accept"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "r-1"
    },
    "expect": {
     "status": "refused",
     "message": "That person is already in this photo."
    }
   },
   {
    "label": "unchanged",
    "db": "SELECT (SELECT person_id FROM face_prints WHERE id=6),(SELECT COUNT(*) FROM face_review_candidates),(SELECT COUNT(*) FROM catalog_operations)",
    "expect": [
     [
      null,
      4,
      0
     ]
    ]
   }
  ]
 },
 {
  "name": "face-review-reject-and-undo",
  "description": "Not this person stores a constraint against the person's representative face by file and box; Undo removes it and restores the suggestion. Undo after the face moved is refused.",
  "extends": "face-review-list-pages-and-filters",
  "steps": [
   {
    "label": "reject",
    "command": {
     "resolveFaceReview": {
      "requestID": "r-1",
      "faceID": 3,
      "personID": 1,
      "resolution": "reject"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "r-1"
    },
    "expect": {
     "status": "ok",
     "faceID": 3,
     "total": 2
    },
    "save": {
     "name": "op",
     "path": "operationID"
    }
   },
   {
    "label": "constraint",
    "db": "SELECT file_id,bbox,anchor_file_id,anchor_bbox,source FROM face_identity_constraints",
    "expect": [
     [
      3,
      "b3",
      1,
      "b1",
      "review"
     ]
    ]
   },
   {
    "label": "rejected",
    "db": "SELECT (SELECT person_id FROM face_prints WHERE id=3),(SELECT outcome FROM face_assignment_assessed WHERE face_id=3),(SELECT json_extract(after_json,'$.constraintCreated') FROM catalog_corrections)",
    "expect": [
     [
      null,
      "rejected",
      1
     ]
    ]
   },
   {
    "label": "undo",
    "command": {
     "undoFaceReview": {
      "requestID": "u-1",
      "operationID": {
       "$var": "op"
      }
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "u-1"
    },
    "expect": {
     "status": "ok",
     "total": 3
    }
   },
   {
    "label": "forgotten",
    "db": "SELECT COUNT(*) FROM face_identity_constraints",
    "expect": [
     [
      0
     ]
    ]
   },
   {
    "label": "suggestion back",
    "db": "SELECT face_id,person_id,score,reason,runner_up_person_id,runner_up_score,namespace,created_at FROM face_review_candidates WHERE face_id=3",
    "expect": [
     [
      3,
      1,
      0.81,
      "suggested",
      2,
      0.2,
      "m|p",
      100
     ]
    ]
   },
   {
    "label": "reject again",
    "command": {
     "resolveFaceReview": {
      "requestID": "r-2",
      "faceID": 3,
      "personID": 1,
      "resolution": "reject"
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "r-2"
    },
    "expect": {
     "status": "ok"
    },
    "save": {
     "name": "op2",
     "path": "operationID"
    }
   },
   {
    "label": "user moves it",
    "command": {
     "reassignFace": {
      "faceID": 3,
      "destinationPersonID": 2
     }
    },
    "await": "bulkActionResult",
    "expect": {
     "succeeded": 1
    }
   },
   {
    "label": "undo refused",
    "command": {
     "undoFaceReview": {
      "requestID": "u-2",
      "operationID": {
       "$var": "op2"
      }
     }
    },
    "await": "faceReview",
    "filter": {
     "requestID": "u-2"
    },
    "expect": {
     "status": "refused",
     "message": "This face was moved since, so nothing changed."
    }
   }
  ]
 },

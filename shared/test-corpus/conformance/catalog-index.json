[
  {
    "name": "catalog-index-job-recovers-cancels-and-resumes",
    "description": "A visual index job left running by a crashed engine comes back paused with its progress; it can be cancelled, a cancelled job can be resumed, and the resumed job finishes with progress 1 without a visual model while the engine stays responsive (the semantic search for that model answers with no hits). Covers what check_catalog_index_jobs.py checks.",
    "sql": [
      "INSERT INTO catalog_jobs(id,kind,file_ids_json,recipe_json,state,priority,progress,created_at,updated_at) VALUES('{clip_index_job}','catalogIndex','[]','{\"model\":\"{clip_model}\"}','running',1,0.4,1,1)"
    ],
    "steps": [
      {"label": "interrupted job is paused", "catalog": {"action": "jobs"}, "expect": {"status": "ok", "jobs": [{"id": "{clip_index_job}", "kind": "catalogIndex", "state": "paused", "progress": 0.4}]}},
      {"label": "cancel", "catalog": {"action": "cancelJob", "jobID": "{clip_index_job}"}, "expect": {"status": "ok", "jobs": [{"id": "{clip_index_job}", "state": "cancelled"}]}},

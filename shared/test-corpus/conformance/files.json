[
  {
    "name": "files-rename-updates-path-identity",
    "description": "renameFiles renames on disk and rewrites path_text, path_hash (per-OS rule) and NFC path_search; collisions, separators and missing rows fail without touching anything.",
    "tree": [
      {"path": "docs/old name.txt", "content": "keep me\n", "row": {"id": 1, "kind": "doc"}},
      {"path": "docs/taken.txt", "content": "occupant\n", "row": {"id": 2, "kind": "doc"}}
    ],
    "steps": [
      {"label": "rename", "command": {"renameFiles": {"renames": [{"fileID": 1, "newName": "Café Notes.MD"}]}}, "await": "bulkActionResult", "expect": {"action": "renameFiles", "succeeded": 1, "failed": 0}},
      {"label": "on disk", "fs": {"exists": ["docs/Café Notes.MD"], "absent": ["docs/old name.txt"], "contents": {"docs/Café Notes.MD": "keep me\n"}}},
      {"label": "catalog", "db": "SELECT path_text,path_hash,path_search FROM files WHERE id=1", "expect": [["{path:docs/Café Notes.MD}", "{path_hash:docs/Café Notes.MD}", "{nfc_path:docs/Café Notes.MD}"]]},
      {"label": "collision", "command": {"renameFiles": {"renames": [{"fileID": 1, "newName": "taken.txt"}]}}, "await": "bulkActionResult", "expect": {"succeeded": 0, "failed": 1, "messages": [{"fileID": 1, "ok": false}]}},
      {"label": "separator", "command": {"renameFiles": {"renames": [{"fileID": 1, "newName": "../escape.txt"}]}}, "await": "bulkActionResult", "expect": {"succeeded": 0, "failed": 1}},
      {"label": "missing row", "command": {"renameFiles": {"renames": [{"fileID": 99, "newName": "ghost.txt"}]}}, "await": "bulkActionResult", "expect": {"succeeded": 0, "failed": 1, "messages": [{"fileID": 99, "ok": false}]}},
      {"label": "unchanged", "fs": {"exists": ["docs/Café Notes.MD", "docs/taken.txt"], "absent": ["escape.txt", "docs/ghost.txt"], "contents": {"docs/taken.txt": "occupant\n"}}},
      {"label": "catalog unchanged", "db": "SELECT id,path_text FROM files ORDER BY id", "expect": [[1, "{path:docs/Café Notes.MD}"], [2, "{path:docs/taken.txt}"]]}
    ]
  },
  {
    "name": "files-rename-updates-extension",
    "description": "Renaming to a new extension updates the lowercased extension column used by kind filters.",
    "extends": "files-rename-updates-path-identity",
    "steps": [
      {"label": "rename", "command": {"renameFiles": {"renames": [{"fileID": 1, "newName": "notes.MD"}]}}, "await": "bulkActionResult", "expect": {"succeeded": 1, "failed": 0}},
      {"label": "extension", "db": "SELECT path_text,extension FROM files WHERE id=1", "expect": [["{path:docs/notes.MD}", "md"]]}
    ]
  },
  {
    "name": "files-rename-refuses-row-without-identity",
    "description": "A catalog row without a file_ref cannot prove the file on disk is the one indexed, so renameFiles refuses it.",
    "extends": "files-rename-updates-path-identity",
    "sql": [
      "UPDATE files SET file_ref=NULL"
    ],
    "steps": [
      {"label": "rename", "command": {"renameFiles": {"renames": [{"fileID": 1, "newName": "renamed.txt"}]}}, "await": "bulkActionResult", "expect": {"succeeded": 0, "failed": 1}},
      {"label": "unchanged", "fs": {"exists": ["docs/old name.txt"], "absent": ["docs/renamed.txt"]}}
    ]
  },
  {
    "name": "files-rename-sidecars-follow-their-group",
    "description": "renameFiles carries an uncatalogued .xmp/.aae sidecar (<stem>.xmp or <name>.xmp) to the new stem when every RAW, JPEG/HEIC or MOV of that stem in the folder is in the batch, and the inverse batch (Undo) brings it back. A JPEG renamed without its uncatalogued RAW leaves the RAW's .xmp alone, and hidden files never move.",
    "tree": [
      {"path": "side/IMG_0007.JPG", "content": "jpeg", "row": {"id": 41, "kind": "image"}},
      {"path": "side/IMG_0007.ARW", "content": "raw", "row": {"id": 42, "kind": "image"}},
      {"path": "side/IMG_0007.xmp", "content": "xmp"},
      {"path": "side/IMG_0007.ARW.xmp", "content": "darktable"},
      {"path": "side/.IMG_0007.xmp", "content": "hidden"},
      {"path": "side/IMG_0008.JPG", "content": "lone", "row": {"id": 43, "kind": "image"}},
      {"path": "side/IMG_0008.ARW", "content": "unscanned raw"},
      {"path": "side/IMG_0008.xmp", "content": "raw xmp"}
    ],
    "steps": [
      {"label": "rename the pair and a lone JPEG", "command": {"renameFiles": {"renames": [{"fileID": 41, "newName": "harbor-boats.JPG"}, {"fileID": 42, "newName": "harbor-boats.ARW"}, {"fileID": 43, "newName": "lone-tree.JPG"}]}}, "await": "bulkActionResult", "expect": {"action": "renameFiles", "succeeded": 3, "failed": 0}},
      {"label": "sidecars followed", "fs": {"exists": ["side/harbor-boats.JPG", "side/harbor-boats.ARW", "side/.IMG_0007.xmp", "side/lone-tree.JPG", "side/IMG_0008.ARW"], "absent": ["side/IMG_0007.xmp", "side/IMG_0007.ARW.xmp", "side/.harbor-boats.xmp", "side/lone-tree.xmp"], "contents": {"side/harbor-boats.xmp": "xmp", "side/harbor-boats.ARW.xmp": "darktable", "side/IMG_0008.xmp": "raw xmp"}}},
      {"label": "sidecars stay uncatalogued", "db": "SELECT id FROM files ORDER BY id", "expect": [[41], [42], [43]]},
      {"label": "undo", "command": {"renameFiles": {"renames": [{"fileID": 41, "newName": "IMG_0007.JPG"}, {"fileID": 42, "newName": "IMG_0007.ARW"}, {"fileID": 43, "newName": "IMG_0008.JPG"}]}}, "await": "bulkActionResult", "expect": {"action": "renameFiles", "succeeded": 3, "failed": 0}},
      {"label": "sidecars came back", "fs": {"exists": ["side/IMG_0007.JPG", "side/IMG_0007.ARW", "side/IMG_0008.JPG"], "absent": ["side/harbor-boats.xmp", "side/harbor-boats.ARW.xmp"], "contents": {"side/IMG_0007.xmp": "xmp", "side/IMG_0007.ARW.xmp": "darktable", "side/.IMG_0007.xmp": "hidden", "side/IMG_0008.xmp": "raw xmp"}}}
    ]
  },
  {
    "name": "files-rename-group-rolls-back",
    "description": "When one member of a companion group in a renameFiles batch can't be renamed (here its target appeared since the preview), the members already renamed are put back and every member is reported failed; a file outside the group still renames.",
    "tree": [
      {"path": "roll/IMG_0009.JPG", "content": "jpeg", "row": {"id": 51, "kind": "image"}},
      {"path": "roll/IMG_0009.ARW", "content": "raw", "row": {"id": 52, "kind": "image"}},
      {"path": "roll/IMG_0009.xmp", "content": "xmp"},
      {"path": "roll/sun.ARW", "content": "occupant"},
      {"path": "roll/notes.txt", "content": "notes", "row": {"id": 53, "kind": "doc"}}
    ],
    "steps": [
      {"label": "rename", "command": {"renameFiles": {"renames": [{"fileID": 51, "newName": "sun.JPG"}, {"fileID": 52, "newName": "sun.ARW"}, {"fileID": 53, "newName": "notes-2.txt"}]}}, "await": "bulkActionResult", "expect": {"action": "renameFiles", "succeeded": 1, "failed": 2, "messages": [{"fileID": 51, "ok": false}, {"fileID": 52, "ok": false}, {"fileID": 53, "ok": true}]}},
      {"label": "group put back", "fs": {"exists": ["roll/IMG_0009.JPG", "roll/IMG_0009.ARW", "roll/notes-2.txt"], "absent": ["roll/sun.JPG", "roll/sun.xmp", "roll/notes.txt"], "contents": {"roll/sun.ARW": "occupant", "roll/IMG_0009.xmp": "xmp"}}},
      {"label": "catalog unchanged for the group", "db": "SELECT id,path_text FROM files ORDER BY id", "expect": [[51, "{path:roll/IMG_0009.JPG}"], [52, "{path:roll/IMG_0009.ARW}"], [53, "{path:roll/notes-2.txt}"]]}
    ]
  },
  {
    "name": "files-trash-and-restore-round-trip",
    "description": "trashFiles moves the file to the platform Trash, drops its row and returns the undo batch id; restoreFromTrash with that id puts the file back byte for byte and re-catalogs it.",
    "knownDivergences": [
      {"engine": "swift", "run": false, "reason": "trashFiles and restoreFromTrash use the real user Trash (FileManager.trashItem), which the fixture cannot confine to its state directory"},
      {"engine": "rust", "os": ["darwin"], "run": false, "liftedByTestTrashRoot": true, "reason": "without --test-trash-root the app-hosted build would use the user's real Trash (and the CLI/TUI build has no macOS Trash backend), so the case runs only against a test-trash-root build, whose Trash is a folder in the case directory"},
      {"engine": "rust", "os": ["windows"], "run": false, "reason": "trashFiles uses the per-volume Recycle Bin, which the fixture cannot confine to its state directory (the self-hosted runner's bin is a real user's)"}
    ],
    "tree": [
      {"path": "docs/trash me.txt", "content": "recoverable\n", "row": {"id": 1, "kind": "doc"}},
      {"path": "docs/stay.txt", "content": "stays\n", "row": {"id": 2, "kind": "doc"}}
    ],
    "sql": [
      "INSERT INTO scan_sessions(id,root_path,started_at,completed_at,status) VALUES('conformance','{root}',1,2,'completed')"
    ],
    "steps": [
      {"label": "trash", "command": {"trashFiles": {"fileIDs": [1]}}, "await": "bulkActionResult", "save": {"name": "batch", "path": "action", "after": ":"}, "expect": {"succeeded": 1, "failed": 0, "messages": [{"fileID": 1, "ok": true}]}},
      {"label": "trashed", "fs": {"absent": ["docs/trash me.txt"], "exists": ["docs/stay.txt"], "inTestTrash": ["trash me.txt"]}},
      {"label": "row dropped", "db": "SELECT id FROM files ORDER BY id", "expect": [[2]]},
      {"label": "restore", "command": {"restoreFromTrash": {"batchID": {"$var": "batch"}}}, "await": "bulkActionResult", "expect": {"action": "restoreFromTrash", "succeeded": 1, "failed": 0}},
      {"label": "restored", "fs": {"contents": {"docs/trash me.txt": "recoverable\n", "docs/stay.txt": "stays\n"}}},
      {"label": "row restored", "db": "SELECT id,path_text FROM files ORDER BY id", "expect": [[1, "{path:docs/trash me.txt}"], [2, "{path:docs/stay.txt}"]]}
    ]
  }
]

[
  {
    "name": "video-tools-capabilities-app-hosted",
    "description": "The Rust engine the Mac app hosts offers the Swift engine's AVFoundation video and media tools.",
    "engines": [
      "swift",
      "rust"
    ],
    "appHosted": true,
    "os": [
      "darwin"
    ],
    "tree": [
      {
        "path": "Clip.mov",
        "copy": "shared/test-corpus/conformance-media/clip-rotated.mov",
        "row": {
          "id": 1,
          "kind": "video"
        }
      }
    ],
    "steps": [
      {
        "label": "capabilities",
        "tool": {
          "action": "capabilities"
        },
        "expect": {
          "status": "ok",
          "capabilities": [
            {
              "id": "photo"
            },
            {
              "id": "chapters"
            },
            {
              "id": "video",
              "available": true,
              "outputFormats": [
                "mp4"
              ]
            },
            {
              "id": "videoEnhancement",
              "available": false
            },
            {
              "id": "trim",
              "available": true
            },
            {
              "id": "remux",
              "available": true
            },
            {
              "id": "audio",
              "available": true
            },
            {
              "id": "proxy",
              "available": true
            },
            {
              "id": "rotate",
              "available": true
            }
          ]
        }
      }
    ]
  },
  {
    "name": "video-tools-preview-notes-app-hosted",
    "description": "Video export previews on the Rust engine the Mac app hosts carry the Swift engine's summary, output names and per-output framing, stabilization and follow-people notes, and refuse the same recipes.",
    "engines": [
      "swift",
      "rust"
    ],
    "appHosted": true,
    "os": [
      "darwin"
    ],
    "tree": [
      {
        "path": "Clip.mov",
        "copy": "shared/test-corpus/conformance-media/clip-rotated.mov",
        "row": {
          "id": 1,
          "kind": "video"
        }
      }
    ],
    "steps": [
      {
        "label": "fit",
        "tool": {
          "action": "preview",
          "fileIDs": [
            1
          ],
          "destination": "{root}",
          "recipe": {
            "kind": "video",
            "format": "mp4",
            "maxDimension": 1280,
            "videoAspectRatio": "1:1",
            "videoFraming": "fit"
          }
        },
        "expect": {
          "status": "ok",
          "message": "Creates 1 new file(s). Originals are preserved. Photo outputs strip metadata and normalize to 8-bit SDR.",
          "outputs": [
            {
              "message": "",
              "outputPath": "{std_path:Clip - Export - 1x1 Fit.mp4}",
              "state": "pending"
            }
          ]
        }
      },
      {
        "label": "stabilized",
        "tool": {
          "action": "preview",
          "fileIDs": [
            1
          ],
          "destination": "{root}",
          "recipe": {
            "kind": "video",
            "format": "mp4",
            "maxDimension": 1280,
            "videoAspectRatio": "9:16",
            "videoFraming": "fit",
            "videoStabilization": true
          }
        },
        "expect": {
          "status": "ok",
          "message": "Creates 1 new file(s). Originals are preserved. Photo outputs strip metadata and normalize to 8-bit SDR.",
          "outputs": [
            {
              "message": "Stabilization analyzes translation and rotation during export, with up to 12% edge-covering zoom. Unsafe or unavailable registrations remain uncorrected.",
              "outputPath": "{std_path:Clip - Export - 9x16 Fit - Stabilized.mp4}",
              "state": "pending"
            }
          ]
        }
      },
      {
        "label": "people",
        "tool": {
          "action": "preview",
          "fileIDs": [
            1
          ],
          "destination": "{root}",
          "recipe": {
            "kind": "video",
            "format": "mp4",
            "maxDimension": 1280,
            "videoAspectRatio": "9:16",
            "videoFraming": "auto"
          }
        },
        "expect": {
          "status": "ok",
          "message": "Creates 1 new file(s). Originals are preserved. Photo outputs strip metadata and normalize to 8-bit SDR.",
          "outputs": [
            {
              "message": "People framing: 0 followed samples, 7 full-picture samples. Detection is sampled twice per second; review the exported framing.",
              "outputPath": "{std_path:Clip - Export - 9x16 People.mp4}",
              "state": "pending"
            }
          ]
        }
      },
      {
        "label": "upscale",
        "tool": {
          "action": "preview",
          "fileIDs": [
            1
          ],
          "destination": "{root}",
          "recipe": {
            "kind": "video",
            "format": "mp4",
            "maxDimension": 1920,
            "allowUpscale": true
          }
        },
        "expect": {
          "status": "ok",
          "message": "Creates 1 new file(s). Originals are preserved. Photo outputs strip metadata and normalize to 8-bit SDR.",
          "outputs": [
            {
              "message": "",
              "outputPath": "{std_path:Clip - Export.mp4}",
              "state": "pending"
            }
          ]
        }
      },
      {
        "label": "refused source framing",
        "tool": {
          "action": "preview",
          "fileIDs": [
            1
          ],
          "destination": "{root}",
          "recipe": {
            "kind": "video",
            "format": "mp4",
            "maxDimension": 1280,
            "videoFraming": "auto"
          }
        },
        "expect": {
          "status": "error",
          "message": "Choose files, an output folder, and a supported recipe."
        }
      },
      {
        "label": "nothing written",
        "fs": {
          "sha256": {
            "Clip.mov": "{sha256:Clip.mov}"
          }
        }
      }
    ]
  },
  {
    "name": "cross-video-swift-preview-rust-execute-fit",
    "description": "A 1:1 fit video export previewed by swift is executed by the app-hosted rust engine and undone by swift; the source is never modified.",
    "requires": [
      "swift",
      "rust"
    ],
    "engines": [
      "rust"
    ],
    "appHosted": true,
    "os": [
      "darwin"
    ],
    "start": "swift",
    "tree": [
      {
        "path": "Clip.mov",
        "copy": "shared/test-corpus/conformance-media/clip-rotated.mov",
        "row": {
          "id": 1,
          "kind": "video"
        }
      }
    ],
    "steps": [
      {
        "label": "swift preview",
        "tool": {
          "action": "preview",
          "fileIDs": [
            1
          ],
          "destination": "{root}",
          "recipe": {
            "kind": "video",
            "format": "mp4",
            "maxDimension": 1280,
            "videoAspectRatio": "1:1",
            "videoFraming": "fit"
          }
        },
        "save": [
          {
            "name": "op",
            "path": "operationID"
          },
          {
            "name": "out",
            "path": "outputs.0.outputPath"
          }
        ],
        "expect": {
          "status": "ok",
          "outputs": [
            {
              "outputPath": "{std_path:Clip - Export - 1x1 Fit.mp4}"
            }
          ]
        }
      },
      {
        "label": "preview writes nothing",
        "fs": {
          "absent": [
            "Clip - Export - 1x1 Fit.mp4"
          ]
        }
      },
      {
        "restart": "rust"
      },
      {
        "label": "rust executes",
        "tool": {
          "action": "execute",
          "operationID": {
            "$var": "op"
          },
          "destination": "{root}"
        },
        "expect": {
          "status": "ok",
          "outputs": [
            {
              "state": "completed",
              "outputPath": {
                "$var": "out"
              }
            }
          ]
        }
      },
      {
        "label": "exported, source intact",
        "fs": {
          "exists": [
            "Clip - Export - 1x1 Fit.mp4"
          ],
          "sha256": {
            "Clip.mov": "{sha256:Clip.mov}"
          }
        }
      },
      {
        "restart": "swift"
      },
      {
        "label": "swift undo",
        "tool": {
          "action": "undo",
          "operationID": {
            "$var": "op"
          },
          "destination": "{root}"
        },
        "expect": {
          "status": "ok",
          "outputs": [
            {
              "state": "undone"
            }
          ]
        }
      },
      {
        "label": "output removed, source intact",
        "fs": {
          "absent": [
            "Clip - Export - 1x1 Fit.mp4"
          ],
          "sha256": {
            "Clip.mov": "{sha256:Clip.mov}"
          }
        }
      }
    ]
  },

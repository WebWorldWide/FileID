  {
    "name": "chat-search-wording-and-follow-ups",
    "description": "Chat without a model reports “Found N matches for …” with media filters, carries the subject into follow-ups and words the empty result the same way.",
    "extends": "catalog-search-plural-words-reach-singular-tags",
    "steps": [
      {
        "label": "dogs on grass",
        "chat": {
          "action": "send",
          "text": "dogs on grass",
          "useModel": false
        },
        "expect": {
          "status": "completed",
          "message": "Found 2 matches for “dogs on grass”.",
          "hits": {
            "$tol": "set",
            "value": [
              {
                "fileID": 4
              },
              {
                "fileID": 1
              }
            ]
          }
        }
      },
      {
        "label": "follow-up filter",
        "chat": {
          "action": "send",
          "text": "only videos",
          "useModel": false
        },
        "expect": {
          "message": "Found 1 match for “dogs on grass” (videos).",
          "hits": [
            {
              "fileID": 4,
              "kind": "video"
            }
          ]
        }
      },
      {
        "label": "history",
        "chat": {
          "action": "history"
        },
        "expect": {
          "status": "completed",
          "messages": {
            "$tol": "count",
            "value": 4
          }
        }
      },
      {
        "label": "plural photos",
        "chat": {
          "action": "send",
          "text": "photos of dogs",
          "useModel": false,
          "conversationID": "fresh-1"
        },
        "expect": {
          "message": "Found 2 matches for “dogs” (photos).",
          "hits": {
            "$tol": "set",
            "value": [
              {
                "fileID": 3
              },
              {
                "fileID": 1
              }
            ]
          }
        }
      },
      {
        "label": "no match",
        "chat": {
          "action": "send",
          "text": "beach",
          "useModel": false,
          "conversationID": "fresh-2"
        },
        "expect": {
          "message": "No matches for “beach”. Try names or a few descriptive words; files that haven't been analyzed may still contain it.",
          "hits": []
        }
      },
      {
        "label": "clear",
        "chat": {
          "action": "clear"
        },
        "expect": {
          "status": "completed",
          "messages": []
        }
      },
      {
        "label": "conversation deleted",
        "db": "SELECT COUNT(*) FROM catalog_chat WHERE conversation_id='{conversation}'",
        "expect": [
          [
            0
          ]
        ]
      }
    ]
  },
  {

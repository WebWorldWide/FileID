[
  {
    "name": "catalog-search-plural-words-reach-singular-tags",
    "description": "Keyword search matches scan tags at word starts, folds plural query words onto singular tags, keeps only files matching the most words, ignores rejected tags and orders newest id first.",
    "sql": [
      "INSERT INTO files(id,path_text,path_hash,size_bytes,scanned_at,kind,extension) VALUES(1,'{root}/IMG_0001.jpg',1,10,0,'image','jpg'),(2,'{root}/IMG_0002.jpg',2,10,0,'image','jpg'),(3,'{root}/IMG_0003.jpg',3,10,0,'image','jpg'),(4,'{root}/clip.mov',4,10,0,'video','mov'),(5,'{root}/notes.txt',5,10,0,'doc','txt')",
      "INSERT INTO tags(file_id,tag,source,score) VALUES(1,'dog','auto',0.9),(1,'grass','auto',0.8),(2,'cat','auto',0.9),(2,'grassland','auto',0.7),(2,'dog_park','rejected',0.9),(3,'dog','auto',0.9),(4,'dog','auto',0.9),(4,'grass','auto',0.9),(5,'puppy','auto',0.5)"
    ],
    "steps": [
      {"label": "dogs on grass", "catalog": {"action": "search", "query": "dogs on grass"}, "expect": {"status": "ok", "hits": [{"fileID": 4, "path": "{root}/clip.mov", "kind": "video", "text": "Tags: dog, grass"}, {"fileID": 1, "path": "{root}/IMG_0001.jpg", "kind": "image", "text": "Tags: dog, grass"}]}},
      {"label": "dogs", "catalog": {"action": "search", "query": "dogs"}, "expect": {"hits": [{"fileID": 4}, {"fileID": 3}, {"fileID": 1}]}},
      {"label": "puppies", "catalog": {"action": "search", "query": "puppies"}, "expect": {"hits": [{"fileID": 5, "kind": "doc", "text": "Tags: puppy"}]}},
      {"label": "word-start prefix", "catalog": {"action": "search", "query": "grass"}, "expect": {"hits": [{"fileID": 4}, {"fileID": 2, "text": "Tags: cat, grassland"}, {"fileID": 1}]}},
      {"label": "rejected tag ignored", "catalog": {"action": "search", "query": "park"}, "expect": {"status": "ok", "hits": []}}
    ]
  },
  {
    "name": "chat-search-wording-and-follow-ups",
    "description": "Chat without a model reports “Found N matches for …” with media filters, carries the subject into follow-ups and words the empty result the same way.",
    "extends": "catalog-search-plural-words-reach-singular-tags",
    "steps": [
      {"label": "dogs on grass", "chat": {"action": "send", "text": "dogs on grass", "useModel": false}, "expect": {"status": "completed", "message": "Found 2 matches for “dogs on grass”.", "hits": {"$tol": "set", "value": [{"fileID": 4}, {"fileID": 1}]}}},
      {"label": "follow-up filter", "chat": {"action": "send", "text": "only videos", "useModel": false}, "expect": {"message": "Found 1 match for “dogs on grass” (videos).", "hits": [{"fileID": 4, "kind": "video"}]}},
      {"label": "history", "chat": {"action": "history"}, "expect": {"status": "completed", "messages": {"$tol": "count", "value": 4}}},
      {"label": "plural photos", "chat": {"action": "send", "text": "photos of dogs", "useModel": false, "conversationID": "fresh-1"}, "expect": {"message": "Found 2 matches for “dogs” (photos).", "hits": {"$tol": "set", "value": [{"fileID": 3}, {"fileID": 1}]}}},
      {"label": "no match", "chat": {"action": "send", "text": "beach", "useModel": false, "conversationID": "fresh-2"}, "expect": {"message": "No matches for “beach”. Try names or a few descriptive words; files that haven't been analyzed may still contain it.", "hits": []}},
      {"label": "clear", "chat": {"action": "clear"}, "expect": {"status": "completed", "messages": []}},
      {"label": "conversation deleted", "db": "SELECT COUNT(*) FROM catalog_chat WHERE conversation_id='{conversation}'", "expect": [[0]]}
    ]
  },
  {
    "name": "chat-search-nothing-to-search",
    "description": "A message with no subject or media type runs no search and says what to add.",
    "steps": [
      {"label": "empty plan", "chat": {"action": "send", "text": "please", "useModel": false}, "expect": {"status": "completed", "hits": [], "message": "Add a subject, event, time, or media type such as videos or photos. No search was run."}}
    ]
  },
  {
    "name": "chat-search-names-the-person",
    "description": "A chat question naming a known person filters by that person's faces and says so in the reply.",
    "sql": [
      "INSERT INTO files(id,path_text,path_hash,size_bytes,scanned_at,kind,extension) VALUES(1,'{root}/IMG_0001.jpg',1,10,0,'image','jpg'),(2,'{root}/IMG_0002.jpg',2,10,0,'image','jpg')",
      "INSERT INTO persons(id,name,first_name,created_at,file_count) VALUES(7,'Grandma','Grandma',0,1)",
      "INSERT INTO face_prints(id,file_id,person_id,print_data,bbox) VALUES(1,1,7,X'00','[0,0,1,1]')"
    ],
    "steps": [
      {"label": "person photos", "chat": {"action": "send", "text": "photos of Grandma", "useModel": false}, "expect": {"status": "completed", "hits": [{"fileID": 1}], "message": "Found 1 match in the library (photos) (people: Grandma)."}}
    ]
  },
  {
    "name": "catalog-search-labels-handwritten-text",
    "description": "Text read from images is found by Search & Moments and Chat. Text read as handwriting (the scan's careful read or a Deep Analyze transcription) comes back as handwrittenText, printed text as ocrText, and changing a file drops its transcription.",
    "sql": [
      "INSERT INTO files(id,path_text,path_hash,size_bytes,scanned_at,kind,extension,modified_at) VALUES(1,'{root}/receipt.png',1,10,0,'image','png',5),(2,'{root}/IMG_4101.jpg',2,10,0,'image','jpg',5),(3,'{root}/IMG_4102.jpg',3,10,0,'image','jpg',5)",
      "INSERT INTO ocr_text(file_id,text) VALUES(1,'Corner Market coffee beans total 13.28')",
      "INSERT INTO ocr_text(file_id,text,handwritten) VALUES(2,'Groceries for Sunday zucchini and basil call Aunt Rosalind',1)",
      "INSERT INTO ocr_text(file_id,text,source,handwritten) VALUES(3,'Quarterly roadmap ship pelican beta','vlm',1)",
      "UPDATE files SET modified_at=6 WHERE id=3"
    ],
    "steps": [
      {"label": "handwriting", "catalog": {"action": "search", "query": "zucchini"}, "expect": {"status": "ok", "hits": [{"fileID": 2, "path": "{root}/IMG_4101.jpg", "kind": "handwrittenText", "text": "Groceries for Sunday zucchini and basil call Aunt Rosalind", "evidenceID": "handwrittenText:2"}]}},
      {"label": "printed", "catalog": {"action": "search", "query": "coffee beans"}, "expect": {"status": "ok", "hits": [{"fileID": 1, "kind": "ocrText", "evidenceID": "ocrText:1"}]}},
      {"label": "changed file drops transcription", "catalog": {"action": "search", "query": "pelican"}, "expect": {"status": "ok", "hits": []}},
      {"label": "chat", "chat": {"action": "send", "text": "zucchini", "useModel": false}, "expect": {"status": "completed", "message": "Found 1 match for “zucchini”.", "hits": [{"fileID": 2, "kind": "handwrittenText"}]}},
      {"label": "rows", "db": "SELECT file_id,source,handwritten FROM ocr_text ORDER BY file_id", "expect": [[1, "ocr", 0], [2, "ocr", 1]]}
    ]
  },
  {
    "name": "search-root-scope-keeps-one-location",
    "description": "rootID keeps files of one library location: its path and below, not a lookalike sibling (/Camera vs /Camera2 and /Cameras) and not a deeper location of its own; listRoots counts each file only in its most specific location. It applies before the 100-candidate cut, the capture window and the subject fill, scopes Chat answers through context.rootID, and an unknown id is an error.",
    "sql": [
      "INSERT INTO library_roots(id,path,display,kind,added_at) VALUES(1,'{root}/Camera','{root}/Camera','external',1),(2,'{root}/Camera2','{root}/Camera2','external',2),(3,'{root}/Camera/Synced','{root}/Camera/Synced','external',3)",
      "INSERT INTO files(id,path_text,path_hash,size_bytes,scanned_at,kind,extension,created_at) VALUES(1,'{root}/Camera/IMG_0001.jpg',1,10,0,'image','jpg',1709467200),(2,'{root}/Camera/2020/IMG_0002.jpg',2,10,0,'image','jpg',1600000000),(3,'{root}/Camera2/IMG_0003.jpg',3,10,0,'image','jpg',1709467200),(5,'{root}/Camera/Synced/IMG_0005.jpg',5,10,0,'image','jpg',1709467200),(6,'{root}/Camera/IMG_0006.jpg',6,10,0,'image','jpg',1709467200)",
      "WITH RECURSIVE n(i) AS (SELECT 100 UNION ALL SELECT i+1 FROM n WHERE i<229) INSERT INTO files(id,path_text,path_hash,size_bytes,scanned_at,kind,extension,created_at) SELECT i,'{root}/Cameras/IMG_'||i||'.jpg',i,10,0,'image','jpg',1700000000 FROM n",
      "INSERT INTO tags(file_id,tag,source,score) SELECT id,'dog','auto',0.9 FROM files WHERE id<>6",
      "INSERT INTO tags(file_id,tag,source,score) VALUES(6,'beach','auto',0.9)"
    ],
    "steps": [
      {"label": "listRoots counts each file once, in its most specific location", "command": {"listRoots": {"requestID": "scope-roots"}}, "await": "rootsList", "expect": {"requestID": "scope-roots", "roots": [{"id": 1, "fileCount": 3, "totalBytes": 30}, {"id": 2, "fileCount": 1, "totalBytes": 10}, {"id": 3, "fileCount": 1, "totalBytes": 10}]}},
      {"label": "every location: the newest hundred are all lookalikes", "catalog": {"action": "search", "query": "dogs"}, "expect": {"status": "ok", "hits": {"$tol": "count", "value": 100}}},
      {"label": "every location: first hit", "catalog": {"action": "search", "query": "dogs", "limit": 1}, "expect": {"hits": [{"fileID": 229, "path": "{root}/Cameras/IMG_229.jpg"}]}},
      {"label": "Camera, before the cut, without Camera2, Cameras or Synced", "catalog": {"action": "search", "query": "dogs", "rootID": 1}, "expect": {"status": "ok", "hits": [{"fileID": 2, "path": "{root}/Camera/2020/IMG_0002.jpg", "text": "Tags: dog"}, {"fileID": 1, "path": "{root}/Camera/IMG_0001.jpg"}]}},
      {"label": "Camera2 only", "catalog": {"action": "search", "query": "dogs", "rootID": 2}, "expect": {"hits": [{"fileID": 3}]}},
      {"label": "the deeper location owns its files", "catalog": {"action": "search", "query": "dogs", "rootID": 3}, "expect": {"hits": [{"fileID": 5}]}},
      {"label": "capture window across every location fills from the subject", "catalog": {"action": "search", "query": "dogs", "capturedFrom": 1709251200, "capturedTo": 1709683199}, "expect": {"hits": [{"fileID": 5}, {"fileID": 3}, {"fileID": 1}]}},
      {"label": "capture window inside Camera", "catalog": {"action": "search", "query": "dogs", "rootID": 1, "capturedFrom": 1709251200, "capturedTo": 1709683199}, "expect": {"status": "ok", "hits": [{"fileID": 1}]}},
      {"label": "unknown location", "catalog": {"action": "search", "query": "dogs", "rootID": 99}, "expect": {"status": "error", "hits": []}},
      {"label": "chat inside Camera", "chat": {"action": "send", "text": "dogs", "useModel": false, "context": {"rootID": 1}}, "expect": {"status": "completed", "message": "Found 2 matches for “dogs”.", "hits": {"$tol": "set", "value": [{"fileID": 1}, {"fileID": 2}]}}},
      {"label": "chat overview inside Camera", "chat": {"action": "send", "text": "what's in my library", "useModel": false, "conversationID": "scope-overview", "context": {"rootID": 1}}, "expect": {"status": "completed", "message": "Your library has 3 files using 30 bytes: 3 photos. Dates run from 2020-09-13 to 2024-03-03. Busiest folders: Camera (2 files, 20 bytes), 2020 (1 file, 10 bytes).", "hits": {"$tol": "set", "value": [{"fileID": 1}, {"fileID": 2}, {"fileID": 6}]}}},
      {"label": "chat with an unknown location writes nothing", "chat": {"action": "send", "text": "dogs", "useModel": false, "conversationID": "scope-unknown", "context": {"rootID": 99}}, "expect": {"status": "error", "message": "That location is no longer in the library.", "hits": [], "messages": []}},
      {"label": "chat count inside Synced", "chat": {"action": "send", "text": "how many photos", "useModel": false, "conversationID": "scope-count", "context": {"rootID": 3}}, "expect": {"status": "completed", "message": "Found 1 photo, using 10 bytes.", "hits": [{"fileID": 5}]}}
    ]
  },
  {

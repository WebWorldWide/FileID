      "CREATE TRIGGER fixture_fail BEFORE DELETE ON persons WHEN OLD.id=2 BEGIN SELECT RAISE(ABORT,'fixture failure'); END"
    ],
    "steps": [
      {"label": "merge", "command": {"mergeClusters": {"sourcePersonID": 2, "destinationPersonID": 1}}, "await": "bulkActionResult", "expect": {"succeeded": 0, "failed": 1}},
      {"label": "persons", "db": "SELECT id,name,first_name,is_unknown,representative_face_id,file_count FROM persons ORDER BY id", "expect": [[1, null, null, 1, null, 1], [2, null, "Alex", 0, null, 1]]},
      {"label": "faces", "db": "SELECT id,person_id FROM face_prints ORDER BY id", "expect": [[1, 1], [2, 2]]},
      {"label": "no verdicts", "db": "SELECT COUNT(*) FROM face_verifications", "expect": [[0]]}
    ]
  },

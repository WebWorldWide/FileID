[
  {
    "name": "people-merge-unnamed-destination-inherits-source-name",
    "description": "Merging a named source into an unknown, unnamed destination moves every face, transfers the complete identity, clears Unknown, recounts files and picks the best embedded face as representative.",
    "sql": [
      "INSERT INTO files(id,path_text,path_hash,size_bytes,scanned_at,kind,extension) VALUES(1,'{root}/1.jpg',1,1,0,'image','jpg'),(2,'{root}/2.jpg',2,1,0,'image','jpg'),(3,'{root}/3.jpg',3,1,0,'image','jpg')",
      "INSERT INTO persons(id,created_at,is_unknown,representative_face_id,file_count) VALUES(1,123,1,1,1)",
      "INSERT INTO persons(id,first_name,last_name,created_at,representative_face_id,file_count) VALUES(2,'Alex','Rivera',123,2,2)",
      "INSERT INTO face_prints(id,file_id,person_id,print_data,bbox,arcface_embedding,face_quality) VALUES(1,1,1,X'00','[0,0,1,1]',X'0000803f',0.4),(2,2,2,X'00','[0,0,1,1]',X'0000803f',0.9),(3,3,2,X'00','[0,0,1,1]',NULL,1.0)"
    ],
    "steps": [
      {"label": "merge", "command": {"mergeClusters": {"sourcePersonID": 2, "destinationPersonID": 1}}, "await": "bulkActionResult", "expect": {"action": "mergeClusters", "succeeded": 1, "failed": 0}},
      {"label": "persons", "db": "SELECT id,name,title,first_name,middle_name,last_name,suffix,is_unknown,representative_face_id,file_count FROM persons ORDER BY id", "expect": [[1, null, null, "Alex", null, "Rivera", null, 0, 2, 3]]},
      {"label": "faces", "db": "SELECT id,person_id FROM face_prints ORDER BY id", "expect": [[1, 1], [2, 1], [3, 1]]}
    ]
  },
